<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
	  <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>
	  <LangVersion>preview</LangVersion>
	  <PlatformTarget>x64</PlatformTarget>
	  <StartAction>Program</StartAction>
	  <!-- 开发环境中使用的CAD路径，实际部署时不影响 -->
	  <StartProgram>C:\Software\Autodesk\AutoCAD 2020\acad.exe</StartProgram>
	  <AutoCADApplication>ZYF</AutoCADApplication>
	  <!-- 支持的AutoCAD版本 -->
	  <SupportedCADVersions>2020;2021;2022</SupportedCADVersions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Transactions" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resource\Icon\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resource\Icon\home.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\01 CAD急速瘦身神器.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\02 布置地面疏散指示%28mee%29.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\03 底图处理V2.4.0.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\04 图号文字递增V2.0%28thdz%29.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\05 图片去黑框.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\06 文字复制%28maa%29.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\07 图框自动编号V2.0%28fsn%29.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\08 0层置为当前图层.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\09 CAD开图自动选字体.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
	<Target Name="CopyApplication" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<SourceFiles Include="$(ProjectDir)$(OutDir)/**/*.*"></SourceFiles>
		</ItemGroup>
		<Copy SourceFiles="@(SourceFiles)" DestinationFiles="@(SourceFiles->'C:\ProgramData\Autodesk\ApplicationPlugins\$(AutoCADApplication).bundle\Contents\%(RecursiveDir)%(FileName)%(Extension)')">
		</Copy>

		<Copy SourceFiles="$(ProjectDir)/PackageContents.xml" DestinationFolder="C:\ProgramData\Autodesk\ApplicationPlugins\$(AutoCADApplication).bundle">
		</Copy>
	</Target>

</Project>
