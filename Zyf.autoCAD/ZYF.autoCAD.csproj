<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <FileVersion>1.3.5.0</FileVersion>
    <InformationalVersion>1.3.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	  <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>
	  <LangVersion>preview</LangVersion>
	  <PlatformTarget>x64</PlatformTarget>
	  <StartAction>Program</StartAction>
    <StartProgram>D:\AUTOCAD2020\AutoCAD 2020\acad.exe</StartProgram>
	  <AutoCADApplication>ZYF</AutoCADApplication>
	  <DeployToAutoCAD>false</DeployToAutoCAD>
	  <!-- 支持的AutoCAD版本 -->
	  <SupportedCADVersions>2020;2021;2022</SupportedCADVersions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resource\Icon\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resource\Icon\home.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resource\Icon\home.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\01 CAD急速瘦身(jsss).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\02 布置地面疏散指示(mee).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\03 底图处理(DTCL).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\04 图号文字递增V2.0(thdz).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\05 图片去黑框(QHK).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\06 文字复制(maa).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\07 图框自动编号(fsn).VLX">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\08 0层置为当前图层(P0).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\09 CAD开图自动选字体.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\10 消防回路统计(FAS).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\11 PL线转桥架.lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\12 自动标导线根数(dxgs).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\13 一键统一宋体(yjst).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\14 缺失字体替换(zzz).lsp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\FSNDataBase">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Tools\Emergency-Lighting\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>

  </ItemGroup>
  <!-- Tools 下的 LSP 源文件已采用 GB2312，构建时按原始字节复制。 -->
	<Target Name="CopyApplication" AfterTargets="PostBuildEvent" Condition="'$(DeployToAutoCAD)' == 'true'">
		<ItemGroup>
			<SourceFiles Include="$(ProjectDir)$(OutDir)/**/*.*"></SourceFiles>
		</ItemGroup>
		<Copy SourceFiles="@(SourceFiles)" DestinationFiles="@(SourceFiles->'C:\ProgramData\Autodesk\ApplicationPlugins\$(AutoCADApplication).bundle\Contents\%(RecursiveDir)%(FileName)%(Extension)')">
		</Copy>

		<Copy SourceFiles="$(ProjectDir)/PackageContents.xml" DestinationFolder="C:\ProgramData\Autodesk\ApplicationPlugins\$(AutoCADApplication).bundle">
		</Copy>
	</Target>

</Project>
