        candidate-ms (EL:Elapsed candidate-start) trace-start (EL:Tick)
        automatic (EL:BuildMutualPairs rows snapshot cfg)
        merged (EL:MergePairs (EL:Get 'pairs manual) (EL:Get 'pairs automatic))
        checked (EL:ValidatePairSet snapshot cfg (EL:Get 'edges leaders) (EL:Get 'pairs merged) seeds)
        issues (append (EL:Get 'issues physical) (EL:Get 'issues leaders) (EL:Get 'issues manual)
          (EL:Get 'issues automatic) (EL:Get 'issues merged) (EL:Get 'issues checked)))
  (foreach pair (EL:Get 'pairs checked) (setq resolved (append resolved (list (EL:Get 'a pair) (EL:Get 'b pair)))))
  (setq issues (vl-remove-if '(lambda (i) (and (member (EL:Get 'code i)
      '(NO_CANDIDATE AMBIGUOUS_CANDIDATES NOT_MUTUALLY_UNIQUE UNSUPPORTED_END_GEOMETRY))
      (member (EL:Get 'key (EL:Get 'detail i)) resolved))) issues))
  (foreach seed seeds
    (setq circuit (EL:TraceCircuit seed snapshot (EL:Get 'edges checked) issues)
          circuits (cons circuit circuits) allobjects (append allobjects (EL:Get 'objects circuit))))
  (foreach circuit circuits
    (setq shared nil)
    (foreach other circuits
      (if (not (equal (EL:Get 'id circuit) (EL:Get 'id other)))
        (foreach conflict (EL:Get 'objects circuit)
          (if (member conflict (EL:Get 'objects other)) (setq shared (cons conflict shared))))))
    (if shared
      (setq circuit (EL:Put 'complete nil (EL:Put 'issues
        (cons (EL:Issue 'CIRCUIT_OWNERSHIP_CONFLICT (EL:Get 'id circuit) (EL:Unique shared)) (EL:Get 'issues circuit)) circuit))))
    (setq updated (cons circuit updated)))
  (setq circuits (reverse updated))
  (foreach issue (append issues (EL:Get 'issues snapshot))
    (if (not (member (EL:Get 'object issue) allobjects)) (setq orphan (cons issue orphan))))
  (foreach endrec (EL:Get 'ends snapshot)
    (if (and (member panel (EL:Get 'contacts endrec)) (or (EL:Get 'status endrec) (not (EL:Get 'direction endrec))))
      (setq portissues (cons (EL:Issue 'PANEL_PORT_AMBIGUOUS (EL:Get 'wire endrec) endrec) portissues))))
  (list (cons 'drawing (EL:Get 'drawing cfg)) (cons 'panel panel) (cons 'snapshot snapshot) (cons 'rules (EL:RecognitionRules cfg))
        (cons 'timing (append (EL:Get 'timing snapshot) (list (cons 'physical-ms physical-ms)
          (cons 'candidates-ms candidate-ms) (cons 'trace-and-validation-ms (EL:Elapsed trace-start)))))
        (cons 'config-revision (EL:Get 'revision cfg)) (cons 'circuits (reverse circuits))
        (cons 'connections (EL:Get 'pairs checked)) (cons 'candidates rows)
        (cons 'issues (append portissues issues)) (cons 'unrelated-issues (EL:Unique orphan))
        (cons 'complete (and seeds (not portissues) (not (vl-some '(lambda (c) (not (EL:Get 'complete c))) circuits))))))
(defun EL:PhysicalProgress (phase completed total started object)
  (EL:LogEvent "PHYSICAL_PROGRESS" (list (cons 'phase phase) (cons 'completed completed)
    (cons 'total total) (cons 'elapsed-ms (EL:Elapsed started)) (cons 'object object)))
  (if *EL:LogActive*
    (vl-catch-all-apply 'grtext (list -1 (strcat "接线检查 " phase " " (itoa completed) "/" (itoa total)))))
  nil)
(defun EL:BuildPhysical (snapshot cfg panel / ends out a b block contacts direct edges issues p tol ztol row other hit status ports attached id wire pathcontacts bid blockedwires blocks wirebounds started itemstarted completed total)
  (setq ends (EL:Get 'ends snapshot) tol (EL:Get 'eps_touch (EL:Get 'params cfg)) ztol (EL:Get 'eps_z (EL:Get 'params cfg)))
  (setq started (EL:Tick) completed 0 total (length (EL:Get 'blocks snapshot)))
  (EL:PhysicalProgress "index" 0 total started nil)
  (foreach block (EL:Get 'blocks snapshot)
    (setq blocks (cons (if (equal (EL:Get 'role block) 'ignore) block
      (EL:LogCall "CONTACT_INDEX" (list (EL:Get 'id block) (length (EL:Get 'segments block)))
        'EL:PrepareContactBlock (list block))) blocks) completed (1+ completed)))
  (setq blocks (reverse blocks))
  (EL:PhysicalProgress "index" completed total started nil)
  (setq completed 0 total (length ends))
  (foreach a ends
    (EL:LogEvent "PHYSICAL_ENDPOINT" a)
    (setq contacts nil direct nil p (EL:Get 'point a) status nil itemstarted (EL:Tick))
    (foreach block blocks
      (if (and (not (equal (EL:Get 'role block) 'ignore)) (or (EL:BlockPointHit p block cfg)
              (and (EL:Get 'issues block) (EL:InBounds p (EL:Get 'bounds block) (EL:Get 'eps_boundary (EL:Get 'params cfg))))))
        (progn
          (setq contacts (cons (EL:Get 'id block) contacts))
          (if (EL:Get 'issues block) (setq status 'UNVERIFIED_CONTOUR)))))
    (foreach row (EL:Get 'wires snapshot)
      (if (and (not (equal (EL:Get 'id row) (EL:Get 'wire a))) (EL:InBounds p (EL:Get 'bounds row) tol))
        (setq status 'UNSUPPORTED_WIRE_CONTACT)))
    (foreach b ends
      (if (and (not (equal (EL:Get 'wire a) (EL:Get 'wire b)))
               (EL:LayerAllowed (EL:Get 'layer a) (EL:Get 'layer b) cfg)
               (<= (abs (- (caddr p) (caddr (EL:Get 'point b)))) ztol)
               (<= (EL:Norm (EL:V- p (EL:Get 'point b))) tol)) (setq direct (cons (EL:Get 'key b) direct))))
    (cond ((> (+ (length contacts) (length direct)) 1) (setq status 'AMBIGUOUS_CONTACT))
          ((= (length contacts) 1)
           (setq block (EL:By 'id (car contacts) blocks))
           (if (member (EL:Get 'role block) '(unknown ambiguous)) (setq status 'UNKNOWN_ROLE)))
          ((not direct)
           (foreach row (EL:Get 'wires snapshot)
             (if (not (equal (EL:Get 'id row) (EL:Get 'wire a)))
               (foreach hit (EL:Get 'segments row)
                 (if (and (<= (EL:PointSegmentDistance p (car hit) (cadr hit)) tol)
                          (not (vl-some '(lambda (endpoint) (<= (EL:Norm (EL:V- p (EL:Get 'point endpoint))) tol)) (EL:Get 'ends row))))
                   (setq status 'T_JUNCTION)))))))
    (if status (setq issues (cons (EL:Issue status (EL:Get 'wire a) (EL:Get 'key a)) issues)))
    (setq a (EL:Put 'contacts contacts a) a (EL:Put 'direct direct a)
          a (EL:Put 'occupied (or contacts direct status) a) a (EL:Put 'status status a))
    (if (and (= (length contacts) 1) (not status) (not (equal (car contacts) panel))
             (member (EL:Get 'role block) '(device panel leader)))
      (setq edges (cons (EL:Edge (EL:Get 'wire a) (car contacts)) edges)))
    (setq out (cons a out) completed (1+ completed))
    (EL:LogEvent "PHYSICAL_ENDPOINT_DONE" (list (EL:Get 'key a) (cons 'elapsed-ms (EL:Elapsed itemstarted))))
    (if (= (rem completed 8) 0) (EL:PhysicalProgress "endpoints" completed total started (EL:Get 'key a))))
  (EL:PhysicalProgress "endpoints" completed total started nil)
  (setq ends (reverse out))
  ;; Virtual incidences attach whole paths without modifying CAD entities.
  (setq completed 0 total (length (EL:Get 'wires snapshot)))
  (foreach wire (EL:Get 'wires snapshot)
    (EL:LogEvent "PHYSICAL_WIRE" (list (EL:Get 'id wire) (EL:Get 'ends wire) (EL:Get 'issues wire)))
    (setq wirebounds (EL:SegmentBounds (EL:Get 'segments wire)))
    (foreach block blocks
      (setq bid (EL:Get 'id block))
      (if (and (not (equal (EL:Get 'role block) 'ignore))
               (EL:BoundsOverlap wirebounds (EL:Get 'contact-path-bounds block) tol))
        (cond
          ((EL:LogCall "PHYSICAL_PATH_CHECK" (list (cons 'wire (EL:Get 'id wire)) (cons 'block bid)
              (cons 'wire-segments (length (EL:Get 'segments wire))) (cons 'block-segments (length (EL:Get 'segments block))))
              'EL:PathBlockHit (list wire block cfg))
            (setq pathcontacts (cons (list (EL:Get 'id wire) bid) pathcontacts))
            (if (member (EL:Get 'role block) '(device panel unknown ambiguous))
              (setq attached (EL:Put (EL:Get 'id wire) T attached)))
            (cond
              ((member (EL:Get 'role block) '(unknown ambiguous))
                (setq issues (cons (EL:Issue 'UNKNOWN_ROLE (EL:Get 'id wire) bid) issues)))
              ((equal (EL:Get 'role block) 'device)
                (setq edges (cons (EL:Edge (EL:Get 'id wire) bid) edges)))
              ((and (EL:Get 'whole-block block) (member (EL:Get 'role block) '(panel leader)))
                (if (not (equal bid panel))
                  (setq edges (cons (EL:Edge (EL:Get 'id wire) bid) edges))))
              ((equal (EL:Get 'role block) 'panel)
                (if (not (vl-some '(lambda (ep) (member bid (EL:Get 'contacts ep)))
                          (vl-remove-if-not '(lambda (ep) (equal (EL:Get 'wire ep) (EL:Get 'id wire))) ends)))
                  (setq blockedwires (cons (EL:Get 'id wire) blockedwires)
                        issues (cons (EL:Issue 'PANEL_PATH_CROSSING (EL:Get 'id wire) bid) issues)))))
            (if (EL:Get 'issues block)
              (setq issues (cons (EL:Issue 'UNVERIFIED_CONTOUR (EL:Get 'id wire) bid) issues))))
          ((and (not (EL:Get 'whole-block block)) (or (not (EL:Get 'regions block)) (EL:Get 'issues block)))
            (setq attached (EL:Put (EL:Get 'id wire) T attached)
                  issues (cons (EL:Issue 'UNVERIFIED_REGION (EL:Get 'id wire) bid) issues))))))
    (setq completed (1+ completed))
    (EL:PhysicalProgress "paths" completed total started (EL:Get 'id wire)))
  ;; A connection at either end excludes the whole source entity from gap pairing.
  (foreach a ends
    (foreach id (EL:Get 'contacts a)
      (setq block (EL:By 'id id blocks))
      (if (member (EL:Get 'role block) '(panel device))
        (setq attached (EL:Put (EL:Get 'wire a) T attached)))))
  (setq ends (mapcar '(lambda (e)
    (EL:Put 'wire-attached (EL:Get (EL:Get 'wire e) attached) e)) ends))
  ;; Date: 2026-10-09. Verified device contacts may form normal multi-wire branches.
  (foreach a ends
    (setq b (EL:By 'key (list (EL:Get 'wire a) (if (equal (EL:Get 'side a) 'start) 'end 'start)) ends))
    (if (and b (= (length (EL:Get 'contacts a)) 1) (equal (EL:Get 'contacts a) (EL:Get 'contacts b)))
      (setq issues (cons (EL:Issue 'CLOSED_CIRCUIT (EL:Get 'wire a) (EL:Get 'contacts a)) issues))))
  (foreach a ends
    (if (and (= (length (EL:Get 'direct a)) 1) (not (EL:Get 'status a)))
      (progn
        (setq b (EL:By 'key (car (EL:Get 'direct a)) ends))
        (if (and (= (length (EL:Get 'direct b)) 1) (not (EL:Get 'status b)))
          (setq edges (cons (EL:Edge (EL:Get 'wire a) (EL:Get 'wire b)) edges))
          (setq issues (cons (EL:Issue 'AMBIGUOUS_CONTACT (EL:Get 'wire a) (EL:Get 'key b)) issues))))))
  (setq edges (vl-remove-if '(lambda (edge) (or (member (car edge) blockedwires) (member (cadr edge) blockedwires))) edges))
  (list (cons 'snapshot (EL:Put 'path-contacts (EL:Unique pathcontacts) (EL:Put 'ends ends snapshot))) (cons 'edges (EL:Unique edges)) (cons 'issues issues)))
(defun EL:BuildMutualPairs (rows snapshot cfg / pairs issues row cs target other rec a b state end-index row-index)
  ;; Date: 2026-10-13. Native key lookup replaces a full interpreted endpoint
  ;; scan per row. Cons order preserves EL:By's last-record-wins semantics.
  (foreach a (EL:Get 'ends snapshot)
    (setq end-index (cons (cons (EL:Get 'key a) a) end-index)))
  (foreach row rows
    (setq row-index (cons (cons (EL:Get 'key row) row) row-index)))
  (foreach row rows
    (setq a (cdr (assoc (EL:Get 'key row) end-index)) cs (EL:Get 'candidates row))
    (if (not (EL:Get 'occupied a))
      (progn
        (setq state nil)
        (cond ((EL:Get 'wire-attached a) (setq state 'WIRE_ATTACHED_TO_EQUIPMENT))
              ((not (equal (EL:Get 'geometry a) 'straight)) (setq state (EL:Get 'geometry a)))
              ((not cs) (setq state 'NO_CANDIDATE))
              ((> (length cs) 1) (setq state 'AMBIGUOUS_CANDIDATES))
              (T
               (setq target (EL:Get 'target (car cs)) other (cdr (assoc target row-index)))
               (if (and (= (length (EL:Get 'candidates other)) 1)
                        (equal (EL:Get 'target (car (EL:Get 'candidates other))) (EL:Get 'key row)))
                 (progn
                   (setq rec (list (cons 'a (EL:Get 'key row)) (cons 'b target) (cons 'source 'auto)
                     (cons 'metrics (car cs)) (cons 'params (EL:Get 'params cfg)) (cons 'signature (EL:Get 'signature snapshot))))
                   (if (< (EL:Signature (EL:Get 'key row)) (EL:Signature target)) (setq pairs (cons rec pairs))))
                 (setq state 'NOT_MUTUALLY_UNIQUE))))
        (if state (setq issues (cons (EL:Issue state (EL:Get 'wire a) row) issues))))))
  (list (cons 'pairs pairs) (cons 'issues issues)))
;; Date: 2026-10-22. Extra graph evidence is opt-in for the read-only cold probe.
(defun EL:TraceDiagnosticHead (items limit / out)
  (repeat limit (if items (setq out (cons (car items) out) items (cdr items))))
  (reverse out))
(defun EL:TraceDiagnosticPath (id parents / path seen)
  (while (and id (not (member id seen)) (< (length path) 32))
    (setq path (cons id path) seen (cons id seen) id (cdr (assoc id parents))))
  (list (cons 'nodes path) (cons 'truncated (if id T nil))))
(defun EL:TraceDiagnosticObject (id snapshot / wire block segments)
  ;; Read only the already acquired snapshot; no new CAD/COM or geometry calls.
  (setq wire (EL:By 'id id (EL:Get 'wires snapshot))
    block (EL:By 'id id (EL:Get 'blocks snapshot))
    segments (EL:Get 'segments (cond (block) (T wire))))
  (list (cons 'handle id) (cons 'kind (if block 'block 'wire))
    (cons 'role (EL:Get 'role block)) (cons 'name (EL:Get 'name block))
    (cons 'layer (EL:Get 'layer (cond (block) (T wire))))
    (cons 'bounds (EL:Get 'bounds (cond (block) (T wire))))
    (cons 'ends (EL:TraceDiagnosticHead (EL:Get 'ends wire) 2))
    (cons 'segment-count (length segments)) (cons 'segments (EL:TraceDiagnosticHead segments 8))
    (cons 'segments-truncated (> (length segments) 8))))
(defun EL:TraceClosedDiagnostic (seed snapshot edges id parent next parents / from-neighbours to-neighbours)
  (if *EL:TraceDiagnostics*
    (if (< (cond (*EL:TraceDiagnosticCount*) (T 0)) 20)
      (progn
        (setq *EL:TraceDiagnosticCount* (1+ (cond (*EL:TraceDiagnosticCount*) (T 0)))
          from-neighbours (EL:Neighbours id edges) to-neighbours (EL:Neighbours next edges))
        (EL:LogEvent "CIRCUIT_CLOSED_EDGE" (list '(diagnostic-revision . "2026-10-22-legacy2")
          (cons 'circuit (EL:Get 'id seed)) (cons 'seed (EL:Get 'wire seed))
          '(reason . visited-non-parent-edge) (cons 'from id) (cons 'to next) (cons 'parent parent)
          (cons 'from-path (EL:TraceDiagnosticPath id parents))
          (cons 'to-path (EL:TraceDiagnosticPath next parents))
          (cons 'from-neighbour-count (length from-neighbours))
          (cons 'to-neighbour-count (length to-neighbours))
          (cons 'from-neighbours (EL:TraceDiagnosticHead from-neighbours 16))
          (cons 'to-neighbours (EL:TraceDiagnosticHead to-neighbours 16))
          (cons 'from-object (EL:TraceDiagnosticObject id snapshot))
          (cons 'to-object (EL:TraceDiagnosticObject next snapshot)))))
      (setq *EL:TraceDiagnosticOmitted* (1+ (cond (*EL:TraceDiagnosticOmitted*) (T 0)))))))
(defun EL:TraceCircuit (seed snapshot edges issues / queue visited devices wires problems step id parent neighbours next block endrec rec parents)
  (setq queue (list (list (EL:Get 'wire seed) nil)))
  (while queue
    (setq step (car queue) queue (cdr queue) id (car step) parent (cadr step))
    (if (not (member id visited))
      (progn
        (setq visited (cons id visited) block (EL:By 'id id (EL:Get 'blocks snapshot)))
        (if *EL:TraceDiagnostics* (setq parents (cons (cons id parent) parents)))
        (if block
          (cond ((equal (EL:Get 'role block) 'device) (setq devices (cons id devices)))
                ((equal (EL:Get 'role block) 'panel) (setq problems (cons (EL:Issue 'OTHER_PANEL id nil) problems)))
                ((member (EL:Get 'role block) '(unknown ambiguous))
                 (setq problems (cons (EL:Issue 'UNKNOWN_ROLE id nil) problems))))
          (setq wires (cons id wires)))
        (setq neighbours (if (and (or (not block) (member (EL:Get 'role block) '(device leader junction)))
          (not (and block (vl-some '(lambda (i) (and (equal (EL:Get 'object i) id) (equal (EL:Get 'code i) 'ABNORMAL_BRANCH))) issues))))
          (EL:Neighbours id edges)))
        (if (and block (not (member (EL:Get 'role block) '(device junction))) (> (length neighbours) 2)) (setq problems (cons (EL:Issue 'ABNORMAL_BRANCH id neighbours) problems)))
        (if (and block (equal (EL:Get 'role block) 'junction) (< (length neighbours) 2))
          (setq problems (cons (EL:Issue 'JUNCTION_INCOMPLETE id neighbours) problems)))
        (foreach next neighbours
          (if (not (equal next parent))
            (if (member next visited)
              (progn
                (setq problems (cons (EL:Issue 'CLOSED_CIRCUIT id next) problems))
                (EL:TraceClosedDiagnostic seed snapshot edges id parent next parents))
              (setq queue (append queue (list (list next id))))))))))
  (foreach rec (append (EL:Get 'issues snapshot) issues)
    (if (member (EL:Get 'object rec) visited) (setq problems (cons rec problems))))
  (list (cons 'id (EL:Get 'id seed)) (cons 'seed seed) (cons 'wires (EL:Unique wires))
        (cons 'devices (EL:Unique devices)) (cons 'objects (EL:Unique visited))
        (cons 'issues (EL:Unique problems)) (cons 'complete (not problems))))
(princ)

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "statistics.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
(defun EL:PowerValid (record / w)
  (setq w (EL:Get 'watts record))
  (and (member (EL:Get 'category record) '(lighting sign exit other))
       (equal (type (EL:Get 'display record)) 'STR) (/= (EL:Get 'display record) "")
       (equal (type w) 'INT) (>= w 0) (or (> w 0) (equal (EL:Get 'zero-confirmed record) T))))
(defun EL:PowerShape (record)
  (and (EL:OnlyKeys record '(identity category display watts zero-confirmed source))
       (listp (EL:Get 'identity record)) (= (length (EL:Get 'identity record)) 3)
       (equal (type (car (EL:Get 'identity record))) 'STR) (EL:PowerValid record)))
(defun EL:DefaultWatts (category) (cond ((equal category 'lighting) 5) ((member category '(sign exit)) 1)))
(defun EL:ResolvePower (identity current drawing library / record source)
  (cond ((setq record (EL:By 'identity identity current)) (setq source 'current-input))
        ((setq record (EL:By 'identity identity drawing)) (setq source 'drawing-saved))
        ((setq record (EL:By 'identity identity library)) (setq source 'library-saved)))
  (if record (EL:Put 'source source record)))
(defun EL:ParseWatts (s / n valid c)
  (setq n 0 valid (and (equal (type s) 'STR) (> (strlen s) 0)))
  (if valid
    (foreach c (vl-string->list s)
      (if (or (< c 48) (> c 57) (> n 214748364) (and (= n 214748364) (> c 55)))
        (setq valid nil)
        (if valid (setq n (+ (* n 10) (- c 48)))))))
  (if valid n))
(defun EL:LibraryValid (raw)
  (and (EL:OnlyKeys raw '(version devices roles)) (member (EL:Get 'version raw) '(1 2))
    (not (vl-some '(lambda (row) (not (EL:RoleShape row))) (EL:Get 'roles raw)))
    (not (vl-some '(lambda (row) (not (EL:PowerShape row))) (EL:Get 'devices raw)))))
(defun EL:LoadLibrary (/ raw result)
  (setq raw (EL:ReadData (strcat *EL:Root* "config/device-library.eld")))
  (if raw
    (progn
      (setq result (vl-catch-all-apply 'EL:LibraryValid (list raw)))
      (if (and (not (vl-catch-all-error-p result)) result) (EL:Get 'devices raw)
        (progn (princ "\n项目设备库失效；已保存的无效值不会参与计算，请核对配置。") nil)))))
(defun EL:CountRows (circuit blocks excluded / rows id block identity row)
  (foreach id (EL:Unique (EL:Get 'devices circuit))
    (setq block (EL:By 'id id blocks))
    (if (and block (equal (EL:Get 'role block) 'device) (not (member id excluded)))
      (progn
        (setq identity (EL:Get 'identity block) row (EL:By 'identity identity rows))
        (if row
          (setq rows (subst (EL:Put 'ids (cons id (EL:Get 'ids row)) (EL:Put 'count (1+ (EL:Get 'count row)) row)) row rows))
          (setq rows (cons (list (cons 'identity identity) (cons 'name (EL:Get 'name block))
            (cons 'count 1) (cons 'ids (list id))) rows)))))) (reverse rows))
(defun EL:OwnershipConflicts (circuits / counts circuit id conflicts row)
  (foreach circuit circuits
    (foreach id (EL:Unique (EL:Get 'devices circuit))
      (setq counts (EL:Put id (cons (EL:Get 'id circuit) (EL:Get id counts)) counts))))
  (foreach row counts (if (> (length (cdr row)) 1) (setq conflicts (cons (car row) conflicts)))) conflicts)
(defun EL:CircuitStatistics (circuit blocks excluded cfg library current / rows out issues row record w total good subtotal)
  (setq rows (EL:CountRows circuit blocks excluded) total 0 good T)
  ;; Date: 2026-10-20. No recognized load is not a confirmed zero-watt load.
  ;; Reserved output rows are created later and never enter this calculation.
  (if (not (EL:Get 'devices circuit))
    (setq good nil issues (list (EL:Issue 'NO_RECOGNIZED_DEVICES
      (EL:Get 'id circuit) (EL:Get 'wires circuit)))))
  (foreach row rows
    (setq record (EL:ResolvePower (EL:Get 'identity row) current (EL:Get 'powers cfg) library))
    (if (EL:PowerValid record)
      (progn
        (setq w (EL:Get 'watts record) subtotal nil)
        (if (or (> w (/ 2147483647 (EL:Get 'count row)))
                (> (* w (EL:Get 'count row)) (- 2147483647 total)))
          (setq good nil issues (cons (EL:Issue 'POWER_OVERFLOW (EL:Get 'ids row) w) issues))
          (setq subtotal (* w (EL:Get 'count row)) total (+ total subtotal)))
        (setq row (EL:Put 'watts w row) row (EL:Put 'subtotal subtotal row)
              row (EL:Put 'display (EL:Get 'display record) row) row (EL:Put 'source (EL:Get 'source record) row)))
      (progn
        (setq good nil issues (cons (EL:Issue 'POWER_MISSING_OR_INVALID (EL:Get 'ids row) (EL:Get 'identity row)) issues))))
    (setq out (cons row out)))
  (if (vl-some '(lambda (id) (member id excluded)) (EL:Get 'devices circuit))
    (setq good nil issues (cons (EL:Issue 'DEVICE_OWNERSHIP_CONFLICT (EL:Get 'id circuit) excluded) issues)))
  (if (> total 172)
    (setq issues (cons (EL:Issue 'POWER_OVER_LIMIT (EL:Get 'devices circuit)
      (list (cons 'circuit (EL:Get 'id circuit)) (cons 'watts total) (cons 'counts (reverse out)))) issues)))
  (setq circuit (EL:Put 'power-values-complete good circuit))
  (setq good (and good (EL:Get 'complete circuit)))
  (setq circuit (EL:Put 'counts (reverse out) circuit) circuit (EL:Put 'watts total circuit)
        circuit (EL:Put 'power-complete good circuit) circuit (EL:Put 'power-issues (reverse issues) circuit)
        circuit (EL:Put 'over-limit (> total 172) circuit))
  (EL:Put 'power-status (cond ((not good) 'incomplete) ((> total 172) 'over-limit) (T 'pass)) circuit))
;; Date: 2026-10-13. Pure per-circuit reuse; never caches a DWG freshness decision.
(defun EL:StatisticsCircuitInput (circuit)
  (vl-remove-if '(lambda (pair) (member (car pair)
    '(counts watts power-values-complete power-complete power-issues over-limit power-status power-omitted))) circuit))
(defun EL:CircuitStatisticsScoped (circuit blocks excluded cfg library current / identities row key cached value)
  (if (not *EL:StatisticsScopeEnabled*)
    (EL:CircuitStatistics circuit blocks excluded cfg library current)
    (progn
      (foreach row (EL:CountRows circuit blocks excluded)
        (setq identities (cons (EL:Get 'identity row) identities)))
      (setq key (list (EL:StatisticsCircuitInput circuit) blocks excluded
        (vl-remove-if '(lambda (pair) (member (car pair) '(powers template))) cfg)
        (vl-remove-if-not '(lambda (pair) (member (EL:Get 'identity pair) identities)) (EL:Get 'powers cfg))
        library current)
        cached (assoc key *EL:StatisticsMemo*))
      (if cached (progn (setq value (cdr cached)) (EL:PerfCount "statistics-circuits-reused" 1))
        (progn (setq value (EL:CircuitStatistics circuit blocks excluded cfg library current))
          (EL:PerfCount "statistics-circuits-computed" 1)))
      (setq *EL:StatisticsNext* (cons (cons key value) *EL:StatisticsNext*)) value)))
(defun EL:BoxStatistics (result cfg library current / excluded circuits circuit total allowed overflow *EL:StatisticsNext*)
  (setq excluded (EL:OwnershipConflicts (EL:Get 'circuits result)) total 0 allowed (EL:Get 'complete result))
  (foreach circuit (EL:Get 'circuits result)
    (setq circuit (EL:CircuitStatisticsScoped circuit (EL:Get 'blocks (EL:Get 'snapshot result)) excluded cfg library current))
    (if (EL:Get 'power-complete circuit)
      (if (> (EL:Get 'watts circuit) (- 2147483647 total)) (setq overflow T allowed nil)
        (setq total (+ total (EL:Get 'watts circuit)))))
    (if (not (equal (EL:Get 'power-status circuit) 'pass)) (setq allowed nil))
    (setq circuits (cons circuit circuits)))
  (if *EL:StatisticsScopeEnabled* (setq *EL:StatisticsMemo* (reverse *EL:StatisticsNext*)))
  (setq result (EL:Put 'circuits (reverse circuits) result) result (EL:Put 'box-watts total result)
        result (EL:Put 'power-config (list (EL:Get 'powers cfg) library current) result)
        result (EL:Put 'device-conflicts excluded result) result (EL:Put 'box-total-overflow overflow result))
  (EL:Put 'can-generate (and circuits allowed) result))
(defun EL:PowerTableRows (result / rows circuit row old)
  (foreach circuit (EL:Get 'circuits result)
    (foreach row (EL:Get 'counts circuit)
      (setq old (EL:By 'identity (EL:Get 'identity row) rows))
      (if old
        (setq rows (subst (EL:Put 'circuits (cons (list (EL:Get 'id circuit) (EL:Get 'count row)) (EL:Get 'circuits old))
          (EL:Put 'ids (EL:Unique (append (EL:Get 'ids old) (EL:Get 'ids row)))
            (EL:Put 'count (+ (EL:Get 'count row) (EL:Get 'count old)) old))) old rows))
        (setq rows (cons (EL:Put 'circuits (list (list (EL:Get 'id circuit) (EL:Get 'count row))) row) rows)))))
  (reverse rows))
(defun EL:PrintStatistics (result / circuit row)
  (foreach circuit (EL:Get 'circuits result)
    (princ (strcat "\n" (EL:Get 'id circuit) "：" (itoa (EL:Get 'watts circuit)) "W，"
      (cond ((equal (EL:Get 'power-status circuit) 'pass) "合格") ((equal (EL:Get 'power-status circuit) 'over-limit) "超过172W") (T "未完整／功率缺项"))))
    (foreach row (EL:Get 'counts circuit)
      (princ (strcat "\n  " (EL:Get 'name row) " × " (itoa (EL:Get 'count row)) "，"
        (if (EL:Get 'watts row) (strcat (itoa (EL:Get 'watts row)) "W/个") "功率未确认"))))
    (foreach row (EL:Get 'power-issues circuit) (princ (strcat "\n  " (vl-prin1-to-string row)))))
  (princ (strcat "\n已完整识别且功率齐全的回路合计：" (itoa (EL:Get 'box-watts result)) "W。"))
  (if (EL:Get 'box-total-overflow result) (princ "\n合计超出整数范围，上述为部分小计；正式生成禁用。"))
  (if (not (EL:Get 'can-generate result)) (princ "\n存在未解决识别／功率问题或超过 172W，正式生成已禁用。")))
(princ)

(defun EL:MergePowers (saved edits / row old)
  (foreach row edits
    (setq old (EL:By 'identity (EL:Get 'identity row) saved)
          saved (if old (subst row old saved) (cons row saved))))
  saved)
(defun EL:SavePowerLibrary (edits / path raw checked devices)
  (setq path (strcat *EL:Root* "config/device-library.eld") raw (EL:ReadData path))
  (setq checked (if raw (vl-catch-all-apply 'EL:LibraryValid (list raw)) (not (findfile path))))
  (if (and checked (not (vl-catch-all-error-p checked)))
    (progn
      (setq devices (EL:MergePowers (EL:Get 'devices raw) edits))
      (EL:WriteData path (list (cons 'version 2) (cons 'devices devices) (cons 'roles (EL:Get 'roles raw)))))
    (progn (princ "\n设备库无效，保留原文件；本图功率不受影响。") nil)))

(defun EL:LoadRoleLibrary (/ raw checked)
  (if *EL:Root*
    (progn
      (setq raw (EL:ReadData (strcat *EL:Root* "config/device-library.eld")))
      (if raw
        (progn (setq checked (vl-catch-all-apply 'EL:LibraryValid (list raw)))
          (if (and checked (not (vl-catch-all-error-p checked))) (EL:Get 'roles raw)))))))
(defun EL:SaveRoleLibrary (edits / raw path checked row old roles)
  (setq path (strcat *EL:Root* "config/device-library.eld") raw (EL:ReadData path)
        checked (if raw (vl-catch-all-apply 'EL:LibraryValid (list raw)) (not (findfile path))))
  (if (and checked (not (vl-catch-all-error-p checked)))
    (progn
      (setq roles (EL:Get 'roles raw))
      (foreach row edits
        (setq old (EL:By 'identity (EL:Get 'identity row) roles)
              roles (if old (subst row old roles) (cons row roles))))
      (EL:WriteData path (list (cons 'version 2) (cons 'devices (EL:Get 'devices raw)) (cons 'roles roles))))
    (progn (princ "\n设备库无效，角色未写入设备库；原文件保留。") nil)))

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "device-library.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-11. Independent catalog. Never LOAD/EVAL user data.
(defun EL:DLFail (message)
  (setq *EL:DLError* message) nil)
(defun EL:DLNameKey (name)
  (if (and (equal (type name) 'STR) (/= (vl-string-trim " \t\r\n" name) "")) (strcase name)))
(defun EL:DLToken (text / good c)
  (setq good (and (equal (type text) 'STR) (> (strlen text) 0) (<= (strlen text) 96)))
  (if good
    (foreach c (vl-string->list text)
      (if (not (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122)) (member c '(45 95)))) (setq good nil)))) good)
(defun EL:DLInt (value)
  (and (equal (type value) 'INT) (>= value 0) (<= value 2147483647)))
(defun EL:DLBoolField (key data)
  (and (assoc key data) (member (EL:Get key data) '(T nil))))
(defun EL:DLEntryNames (entry / names alias)
  (setq names (list (EL:Get 'block-name entry)))
  (foreach alias (EL:Get 'aliases entry) (setq names (cons alias names))) (reverse names))
(defun EL:DLAssetPrefix (entry)
  (strcat "assets/" (EL:Get 'device-id entry) "/" (itoa (EL:Get 'asset-revision entry)) "/"))
(defun EL:DLEntryAssets (entry / size)
  (setq size (EL:Get 'legend-size entry))
  (and (EL:DLToken (EL:Get 'device-id entry))
    (EL:DLInt (EL:Get 'asset-revision entry)) (> (EL:Get 'asset-revision entry) 0)
    (member (EL:Get 'block-file entry) (list (strcat (EL:DLAssetPrefix entry) "block.dwg")
      (strcat (EL:DLAssetPrefix entry) "block.dxf")))
    (equal (EL:Get 'legend-file entry) (strcat (EL:DLAssetPrefix entry) "legend.sld"))
    (EL:DLToken (EL:Get 'legend-checksum entry))
    (listp size) (= (length size) 2) (vl-every '(lambda (n) (and (EL:DLInt n) (> n 0))) size)))
(defun EL:DLEntryReady (entry)
  (and (EL:DLNameKey (EL:Get 'block-name entry))
    (EL:DLNameKey (EL:Get 'display entry)) (EL:DLInt (EL:Get 'watts entry))
    (or (> (EL:Get 'watts entry) 0) (equal (EL:Get 'zero-confirmed entry) T))
    (equal (EL:Get 'ground-confirmed entry) T) (EL:DLBoolField 'is-ground entry)
    (EL:DLEntryAssets entry)))
(defun EL:DLEntryValid (entry / ok names name key seen)
  (setq ok (and (EL:OnlyKeys entry '(device-id revision block-name aliases display watts zero-confirmed
      is-ground ground-confirmed active status asset-revision block-file legend-file legend-size legend-checksum))
    (EL:DLToken (EL:Get 'device-id entry)) (EL:DLInt (EL:Get 'revision entry))
    (> (EL:Get 'revision entry) 0) (EL:DLNameKey (EL:Get 'block-name entry))
    (listp (EL:Get 'aliases entry)) (equal (type (EL:Get 'display entry)) 'STR)
    (or (not (EL:Get 'watts entry)) (EL:DLInt (EL:Get 'watts entry)))
    (EL:DLBoolField 'zero-confirmed entry) (EL:DLBoolField 'is-ground entry)
    (EL:DLBoolField 'ground-confirmed entry) (EL:DLBoolField 'active entry)
    (member (EL:Get 'status entry) '(ready draft deleted))
    (EL:DLInt (EL:Get 'asset-revision entry))
    (or (not (EL:Get 'active entry)) (equal (EL:Get 'status entry) 'ready))
    (or (not (equal (EL:Get 'status entry) 'ready)) (EL:DLEntryReady entry))))
  (if ok
    (foreach name (EL:DLEntryNames entry)
      (setq key (EL:DLNameKey name))
      (if (or (not key) (member key seen)) (setq ok nil))
      (setq seen (cons key seen)))) ok)
(defun EL:DLCatalogInitial (identity)
  (list '(schema . EL_DEVICE_LIBRARY_V1) (cons 'library-id identity) '(revision . 0) '(next-id . 1) '(devices)))
(defun EL:DLCatalogValid (catalog / good ids names entry name key)
  (setq good (and (EL:OnlyKeys catalog '(schema library-id revision next-id devices))
    (equal (EL:Get 'schema catalog) 'EL_DEVICE_LIBRARY_V1)
    (EL:DLToken (EL:Get 'library-id catalog)) (EL:DLInt (EL:Get 'revision catalog))
    (EL:DLInt (EL:Get 'next-id catalog)) (> (EL:Get 'next-id catalog) 0) (listp (EL:Get 'devices catalog))))
  (if good
    (foreach entry (EL:Get 'devices catalog)
      (if (or (not (EL:DLEntryValid entry)) (member (EL:Get 'device-id entry) ids)) (setq good nil))
      (setq ids (cons (EL:Get 'device-id entry) ids))
      (if (not (equal (EL:Get 'status entry) 'deleted))
        (foreach name (EL:DLEntryNames entry)
          (setq key (EL:DLNameKey name))
          (if (member key names) (setq good nil)) (setq names (cons key names)))))) good)
(defun EL:DLNextID (catalog / serial identity)
  (setq serial (EL:Get 'next-id catalog) identity (strcat "ELDEV" (itoa serial)))
  (while (EL:By 'device-id identity (EL:Get 'devices catalog))
    (setq serial (1+ serial) identity (strcat "ELDEV" (itoa serial)))) identity)
(defun EL:DLEntryNew (catalog name)
  (list (cons 'device-id (EL:DLNextID catalog)) '(revision . 0) (cons 'block-name name) '(aliases)
    (cons 'display name) '(watts) '(zero-confirmed) '(is-ground) '(ground-confirmed)
    '(active) '(status . draft) '(asset-revision . 0) '(block-file) '(legend-file) '(legend-size) '(legend-checksum)))
(defun EL:DLCollisionName (catalog / seen entry name key collision)
  (foreach entry (EL:Get 'devices catalog)
    (if (not (equal (EL:Get 'status entry) 'deleted))
      (foreach name (EL:DLEntryNames entry)
        (setq key (EL:DLNameKey name))
        (if (member key seen) (setq collision name)) (setq seen (cons key seen))))) collision)
(defun EL:DLUpsert (catalog entry / old next rows collision)
  (setq *EL:DLError* nil old (EL:By 'device-id (EL:Get 'device-id entry) (EL:Get 'devices catalog)))
  (cond
    ((not (EL:DLCatalogValid catalog)) (EL:DLFail "设备库结构无效，未写入。"))
    ((not (equal (EL:Get 'revision entry) (if old (EL:Get 'revision old) 0)))
      (EL:DLFail "设备项已被修改，请刷新后重试；当前输入保留。"))
    (T
      (setq entry (EL:Put 'revision (1+ (EL:Get 'revision entry)) entry)
        rows (if old (subst entry old (EL:Get 'devices catalog)) (append (EL:Get 'devices catalog) (list entry)))
        next (EL:Put 'revision (1+ (EL:Get 'revision catalog)) (EL:Put 'devices rows catalog)))
      (if (not old) (setq next (EL:Put 'next-id (1+ (EL:Get 'next-id catalog)) next)))
      (if (EL:DLCatalogValid next) next
        (if (setq collision (EL:DLCollisionName next)) (EL:DLFail (strcat "图块名或别名冲突：" collision "；未写入。"))
          (EL:DLFail "设备资料无效，未写入；请核对功率、地面及图形资料。"))))))
(defun EL:DLDelete (catalog identity / entry)
  (if (setq entry (EL:By 'device-id identity (EL:Get 'devices catalog)))
    (EL:DLUpsert catalog (EL:Put 'active nil (EL:Put 'status 'deleted entry)))
    (EL:DLFail "设备项不存在。")))
(defun EL:DLRestore (catalog identity / entry ready)
  (if (setq entry (EL:By 'device-id identity (EL:Get 'devices catalog)))
    (progn (setq ready (EL:DLEntryReady entry))
      (EL:DLUpsert catalog (EL:Put 'active (if ready T nil) (EL:Put 'status (if ready 'ready 'draft) entry))))
    (EL:DLFail "设备项不存在。")))
(defun EL:DLIndex (catalog / index entry name)
  (foreach entry (EL:Get 'devices catalog)
    (if (and (EL:Get 'active entry) (equal (EL:Get 'status entry) 'ready))
      (foreach name (EL:DLEntryNames entry) (setq index (cons (cons (EL:DLNameKey name) entry) index))))) index)
;; Date: 2026-10-22. Exact names win; a suffix fallback must identify a single device.
(defun EL:DLUniqueNameEntry (name entries / key entry found ambiguous ids)
  (if (setq key (EL:TianzhengNameKey name))
    (foreach entry entries
      (if (member key (mapcar 'EL:BlockNameMatchKey (EL:DLEntryNames entry)))
        (progn
          (setq ids (EL:Unique (cons (EL:Get 'device-id entry) ids)))
          (if (and found (not (equal (EL:Get 'device-id entry) (EL:Get 'device-id found))))
            (setq ambiguous T) (setq found entry))))))
  (if ambiguous
    (progn (EL:LogEvent "DEVICE_NAME_SUFFIX_AMBIGUOUS"
      (list (cons 'drawing-name name) (cons 'match-key key) (cons 'device-ids ids))) nil)
    found))
(defun EL:DLLookup (name snapshot)
  (cond ((cdr (assoc (EL:DLNameKey name) (EL:Get 'index snapshot))))
    ((EL:DLUniqueNameEntry name (mapcar 'cdr (EL:Get 'index snapshot))))))
;; Date: 2026-10-12. Picked drafts have real graphics before default watts are complete.
(defun EL:DLFindEntry (name snapshot / found entry)
  (foreach entry (EL:Get 'devices (EL:Get 'catalog snapshot))
    (if (and (not (equal (EL:Get 'status entry) 'deleted))
      (member (EL:DLNameKey name) (mapcar 'EL:DLNameKey (EL:DLEntryNames entry)))) (setq found entry)))
  (cond (found) ((EL:DLUniqueNameEntry name (vl-remove-if '(lambda (entry)
    (equal (EL:Get 'status entry) 'deleted)) (EL:Get 'devices (EL:Get 'catalog snapshot)))))))
;; Date: 2026-10-13. Registered draft graphics may already have a saved default power.
(defun EL:DLPowerEntry (name snapshot / entry)
  ;; A disabled/draft exact row must not inherit a different author's active power.
  (setq entry (cond ((cdr (assoc (EL:DLNameKey name) (EL:Get 'index snapshot))))
    ((assoc 'catalog snapshot) (EL:DLFindEntry name snapshot)) (T (EL:DLLookup name snapshot))))
  (cond ((and entry (EL:Get 'active entry) (equal (EL:Get 'status entry) 'ready)) entry)
    ((and entry (equal (EL:Get 'status entry) 'draft)
      (EL:DLEntryAssets entry) (EL:DLInt (EL:Get 'watts entry))
      (or (> (EL:Get 'watts entry) 0) (EL:Get 'zero-confirmed entry))) entry)))
(defun EL:DLRecognitionNames (snapshot / names entry)
  (foreach entry (EL:Get 'devices (EL:Get 'catalog snapshot))
    (if (and (EL:DLEntryAssets entry)
      (or (equal (EL:Get 'status entry) 'draft)
        (and (equal (EL:Get 'status entry) 'ready) (EL:Get 'active entry))))
      (setq names (append names (EL:DLEntryNames entry))))) (EL:Unique names))
(defun EL:DLSearch (catalog query deleted / out entry text)
  (setq query (strcase query))
  (foreach entry (EL:Get 'devices catalog)
    (setq text (strcase (strcat (EL:Get 'block-name entry) " " (EL:Get 'display entry))))
    (foreach text (list text (strcase (vl-prin1-to-string (EL:Get 'aliases entry))))
      (if (and (or deleted (not (equal (EL:Get 'status entry) 'deleted)))
          (or (= query "") (vl-string-search query text)) (not (member entry out))) (setq out (cons entry out)))) )
  (reverse out))

;; Native I/O boundaries are deliberately small and injectable in checks.
(defun EL:DLUTF8Valid (bytes / good a b c d need rest)
  (setq good T)
  (while (and bytes good)
    (setq a (car bytes) bytes (cdr bytes) need 0)
    (cond
      ((and (>= a 1) (<= a 127)))
      ((and (>= a 194) (<= a 223)) (setq need 1))
      ((and (>= a 224) (<= a 239)) (setq need 2))
      ((and (>= a 240) (<= a 244)) (setq need 3))
      (T (setq good nil)))
    (setq rest bytes)
    (repeat need
      (if (and rest (>= (car rest) 128) (<= (car rest) 191)) (setq rest (cdr rest)) (setq good nil)))
    (if (and good (> need 0))
      (progn
        (setq b (car bytes))
        (if (or (and (= a 224) (< b 160)) (and (= a 237) (> b 159))
            (and (= a 240) (< b 144)) (and (= a 244) (> b 143))) (setq good nil))
        (setq bytes rest)))) good)
(defun EL:DLReadStream (stream path / bytes)
  ;; Date: 2026-10-12. Supply optional COM slots explicitly for CAD2020.
  (vlax-put-property stream 'Type 1) (vlax-invoke-method stream 'Open nil 0 -1 "" "")
  (vlax-invoke-method stream 'LoadFromFile path)
  ;; Date: 2026-10-12. Preserve the validation message; skip a UTF-8 BOM as bytes.
  (cond
    ((> (vlax-get-property stream 'Size) 8388608) (EL:DLFail "设备库索引过大，未读取。"))
    (T
      (setq bytes (vlax-safearray->list (vlax-variant-value (vlax-invoke-method stream 'Read -1))))
      (if (not (EL:DLUTF8Valid bytes)) (EL:DLFail "设备库不是有效 UTF-8，原文件保留。")
        (progn
          (vlax-put-property stream 'Position 0) (vlax-put-property stream 'Type 2)
          (vlax-put-property stream 'Charset "utf-8")
          (if (equal (list (car bytes) (cadr bytes) (caddr bytes)) '(239 187 191))
            (vlax-put-property stream 'Position 3))
          (vlax-invoke-method stream 'ReadText -1))))))
(defun EL:DLReadText (path / stream outcome)
  (setq stream (vl-catch-all-apply 'vlax-create-object (list "ADODB.Stream")))
  (if (vl-catch-all-error-p stream) (EL:DLFail "无法创建 UTF-8 读取接口，请检查 Windows ADODB.Stream。")
    (progn
      (setq outcome (vl-catch-all-apply 'EL:DLReadStream (list stream path)))
      (vl-catch-all-apply 'vlax-invoke-method (list stream 'Close)) (vlax-release-object stream)
      (if (vl-catch-all-error-p outcome)
        (EL:DLFail (strcat "设备库读取失败：" path "；" (vl-catch-all-error-message outcome))) outcome))))
(defun EL:DLWriteStream (stream path text)
  (vlax-put-property stream 'Type 2) (vlax-put-property stream 'Charset "utf-8")
  (vlax-invoke-method stream 'Open nil 0 -1 "" "") (vlax-invoke-method stream 'WriteText text 0)
  (vlax-invoke-method stream 'SaveToFile path 1) T)
(defun EL:DLWriteText (path text / stream outcome)
  (setq stream (vlax-create-object "ADODB.Stream")
    outcome (vl-catch-all-apply 'EL:DLWriteStream (list stream path text)))
  (vl-catch-all-apply 'vlax-invoke-method (list stream 'Close)) (vlax-release-object stream)
  (if (vl-catch-all-error-p outcome) (EL:DLFail (vl-catch-all-error-message outcome)) outcome))
(defun EL:DLParse (text / parsed)
  (if (equal (type text) 'STR)
    (progn
      (setq parsed (vl-catch-all-apply 'EL:StoreParse (list text)))
      (if (and (not (vl-catch-all-error-p parsed)) (EL:DLCatalogValid parsed)) parsed
        (EL:DLFail "设备库索引损坏或版本不支持，原文件保留。")))))
(defun EL:DLMkdir (path / parent)
  (if (vl-file-directory-p path) T
    (progn (setq parent (vl-filename-directory (vl-string-right-trim "/\\" path)))
      (and parent (not (equal parent path)) (EL:DLMkdir parent) (vl-mkdir path)))))
(defun EL:DLOperationID (/ ticks)
  (setq *EL:DLSerial* (1+ (cond (*EL:DLSerial*) (T 0))))
  (strcat "op-" (EL:Hash (strcat (cond ((getenv "COMPUTERNAME")) (T "CAD"))
    (rtos (getvar "CDATE") 2 8) "-" (itoa (getvar "MILLISECS")) "-" (itoa *EL:DLSerial*)))))
(defun EL:DLDefaultRoot (/ base)
  (if (setq base (getenv "LOCALAPPDATA"))
    (EL:NormalizeRoot (strcat base "/Emergency-Lighting/device-library"))))
(defun EL:DLRoot (/ saved)
  (cond (*EL:DLRoot*)
    ((setq saved (vl-registry-read "HKEY_CURRENT_USER\\Software\\Emergency-Lighting\\DeviceLibrary" "Root"))
      (EL:NormalizeRoot saved)) (T (EL:DLDefaultRoot))))
(defun EL:DLRootSet (root / path)
  (setq path (EL:NormalizeRoot root))
  (if (and path (vl-file-directory-p path)
      (vl-registry-write "HKEY_CURRENT_USER\\Software\\Emergency-Lighting\\DeviceLibrary" "Root" path))
    (progn (setq *EL:DLRoot* path *EL:DLCache* nil) path)
    (EL:DLFail "设备库目录未保存，请检查目录和用户配置权限。")))
(defun EL:DLSnapshotLoad (root / path text catalog)
  (setq *EL:DLError* nil root (EL:NormalizeRoot root) path (strcat root "catalog.eld"))
  (EL:PerfCount "device-library-loads" 1)
  (cond
    ((findfile (strcat root ".write-lock"))
      (EL:LogEvent "DEVICE_LIBRARY_LOCKED" (list (cons 'path (strcat root ".write-lock"))))
      (EL:DLFail "设备库存在写入占用文件，暂时无法打开；当前输入保留。"))
    ((findfile path)
      (if (and (setq text (EL:DLReadText path)) (setq catalog (EL:DLParse text)))
        (list (cons 'root root) (cons 'catalog catalog) (cons 'raw text) (cons 'present T) (cons 'index (EL:DLIndex catalog)))))
    (T (setq catalog (EL:DLCatalogInitial (strcat "LIB-" (EL:DLOperationID))))
      (list (cons 'root root) (cons 'catalog catalog) '(raw) '(present) '(index)))))
(defun EL:DLSnapshotCurrent (snapshot / path raw)
  (setq path (strcat (EL:Get 'root snapshot) "catalog.eld"))
  (and snapshot (not (findfile (strcat (EL:Get 'root snapshot) ".write-lock")))
    (if (EL:Get 'present snapshot)
      (and (findfile path) (setq raw (EL:DLReadText path)) (equal raw (EL:Get 'raw snapshot)))
      (not (findfile path)))))
(defun EL:DLSnapshot (/ root scope loaded)
  (setq scope (if *EL:PerfActive* *EL:StoreReadScope*))
  (if (and scope *EL:DLCache* (equal scope (EL:Get 'scope *EL:DLCache*))) *EL:DLCache*
    (if (setq root (EL:DLRoot))
      (progn (setq loaded (EL:PerfCall "DEVICE_LIBRARY_LOAD" 'EL:DLDefaultSnapshot (list root)))
        (if loaded (setq loaded (EL:Put 'scope scope loaded)))
        (if scope (setq *EL:DLCache* loaded)) loaded)
      (EL:DLFail "无法取得用户设备库目录。"))))
(defun EL:DLLockWork (fso path owner)
  (setq *EL:DLLockStream* (vlax-invoke-method fso 'CreateTextFile path :vlax-false :vlax-false) *EL:DLLockClaimed* T)
  (vlax-invoke-method *EL:DLLockStream* 'WriteLine owner) T)
(defun EL:DLLockAcquire (path owner / fso result closed *EL:DLLockClaimed* *EL:DLLockStream*)
  (setq fso (vlax-create-object "Scripting.FileSystemObject")
    result (vl-catch-all-apply 'EL:DLLockWork (list fso path owner)))
  ;; Close/release even when WriteLine fails; otherwise the marker cannot be removed.
  (if *EL:DLLockStream*
    (progn (setq closed (vl-catch-all-apply 'vlax-invoke-method (list *EL:DLLockStream* 'Close)))
      (vl-catch-all-apply 'vlax-release-object (list *EL:DLLockStream*))))
  (vlax-release-object fso)
  (if (or (vl-catch-all-error-p result) (vl-catch-all-error-p closed))
    (progn (if *EL:DLLockClaimed* (vl-file-delete path)) (EL:DLFail "设备库写锁被占用或目录不可写，请重试。")) result))
;; Date: 2026-10-11. ASCII ownership must not depend on catalog UTF-8/ADODB reads.
(defun EL:DLLockOwner (path / file text)
  (if (setq file (open path "r"))
    (progn (setq text (vl-catch-all-apply 'read-line (list file))) (close file)
      (if (not (vl-catch-all-error-p text)) text))))
(defun EL:DLLockRelease (path owner / text removed)
  (if (not (findfile path)) T
    (progn (setq text (vl-catch-all-apply 'EL:DLLockOwner (list path)))
      (if (and (not (vl-catch-all-error-p text)) (equal text owner))
        (setq removed (vl-file-delete path)))
      (if (not removed) (EL:LogEvent "DEVICE_LIBRARY_LOCK_RELEASE_FAILED" (list (cons 'path path)))) removed)))
;; Date: 2026-10-11. Explicit recovery only after the user confirms all other writers stopped.
;; Archive the marker; never overwrite a catalog or discard unfinished publish evidence.
(defun EL:DLLockRecover (root / path catalog owner backup)
  (setq root (EL:NormalizeRoot root) path (strcat root ".write-lock") catalog (strcat root "catalog.eld")
    *EL:DLError* nil)
  (cond
    ((not (findfile path)) T)
    ((vl-file-directory-p path) (EL:DLFail "占用路径是目录，不能按锁文件恢复；原文件保留。"))
    ((if (findfile catalog) (not (EL:DLParse (EL:DLReadText catalog)))
       (or (vl-directory-files root "rollback-*.eld" 1)
           (and (vl-file-directory-p (strcat root "history")) (vl-directory-files (strcat root "history") "*.eld" 1))
           (and (vl-file-directory-p (strcat root ".staging")) (vl-directory-files (strcat root ".staging") "*.eld" 1))))
      (EL:DLFail "索引缺失或损坏，存在未完成保存的可能；请保留整个库目录，先恢复索引。"))
    ((not (or (= (vl-file-size path) 0)
        (and (setq owner (EL:DLLockOwner path)) (EL:DLToken owner) (= (substr owner 1 3) "op-"))))
      (EL:DLFail "占用文件无法识别或读取，未移动；请保留文件用于检查。"))
    (T
      (setq backup (strcat root "lock-recovered-" (EL:DLOperationID) ".txt"))
      (if (and (not (findfile backup)) (equal owner (EL:DLLockOwner path)) (vl-file-rename path backup))
        (progn (setq *EL:DLCache* nil) (EL:LogEvent "DEVICE_LIBRARY_LOCK_RECOVERED" (list (cons 'backup backup))) T)
        (EL:DLFail "占用文件仍被使用或目录不可写，未恢复；请结束其他 CAD 中的保存后重试。")))))
(defun EL:DLCommitLocked (snapshot candidate / root path text current tmp backup history result)
  (setq root (EL:Get 'root snapshot) path (strcat root "catalog.eld")
    current (if (findfile path) (EL:DLReadText path)))
  (EL:Require (if (EL:Get 'present snapshot) (equal current (EL:Get 'raw snapshot)) (not (findfile path)))
    "设备库已被其他窗口修改，请刷新后重试；当前输入保留。")
  (EL:Require (and (EL:DLCatalogValid candidate)
      (equal (EL:Get 'library-id candidate) (EL:Get 'library-id (EL:Get 'catalog snapshot)))
      (= (EL:Get 'revision candidate) (1+ (EL:Get 'revision (EL:Get 'catalog snapshot))))) "待保存设备库版本无效。")
  (EL:Require (and (EL:DLMkdir (strcat root ".staging")) (EL:DLMkdir (strcat root "history"))) "设备库目录不可写。")
  (setq tmp (vl-filename-mktemp "catalog-" (strcat root ".staging") ".eld")
    backup (vl-filename-mktemp "rollback-" root ".eld") text (vl-prin1-to-string candidate))
  (EL:Require (and (EL:DLWriteText tmp text) (equal (EL:DLParse (EL:DLReadText tmp)) candidate))
    "设备库 UTF-8 写入回读失败，原文件保留。")
  (if current
    (progn
      (setq history (strcat root "history/" (itoa (EL:Get 'revision (EL:Get 'catalog snapshot))) ".eld"))
      (EL:Require (if (findfile history) (equal (EL:DLReadText history) current)
        (and (vl-file-copy path history) (equal (EL:DLReadText history) current))) "历史设备库备份失败。")))
  (if (findfile path) (EL:Require (vl-file-rename path backup) "原设备库无法保留，未替换。"))
  (setq result (vl-catch-all-apply 'vl-file-rename (list tmp path)))
  (if (or (vl-catch-all-error-p result) (not result))
    (progn (if (findfile backup) (vl-file-rename backup path))
      (EL:Require nil "新设备库发布失败，已尝试恢复原索引；请查看目录权限。")))
  (if (not (equal (EL:DLParse (EL:DLReadText path)) candidate))
    (progn (vl-file-delete path) (if (findfile backup) (vl-file-rename backup path))
      (EL:Require nil "已发布设备库回读不一致，已尝试恢复原索引。")))
  (if (findfile backup) (vl-file-delete backup)) T)
(defun EL:DLCommit (snapshot candidate / root lock owner result)
  (setq *EL:DLError* nil root (EL:Get 'root snapshot) lock (strcat root ".write-lock") owner (EL:DLOperationID))
  (if (and snapshot candidate (EL:DLMkdir root) (EL:DLLockAcquire lock owner))
    (progn
      (setq result (vl-catch-all-apply 'EL:DLCommitLocked (list snapshot candidate)))
      (EL:DLLockRelease lock owner)
      (if (vl-catch-all-error-p result) (EL:DLFail (vl-catch-all-error-message result))
        (if result (progn (setq *EL:DLCache* nil) (EL:PerfCount "device-library-writes" 1) T))))))
(princ)

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "device-assets.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-12. Explicit ADO arguments; immutable assets and owned previews.
(defun EL:DLBytesWork (stream path count)
  (vlax-put-property stream 'Type 1) (vlax-invoke-method stream 'Open nil 0 -1 "" "")
  (vlax-invoke-method stream 'LoadFromFile path)
  (vlax-safearray->list (vlax-variant-value (vlax-invoke-method stream 'Read count))))
(defun EL:DLBytes (path count / stream result)
  (setq stream (vlax-create-object "ADODB.Stream") result (vl-catch-all-apply 'EL:DLBytesWork (list stream path count)))
  (vl-catch-all-apply 'vlax-invoke-method (list stream 'Close)) (vlax-release-object stream)
  (if (not (vl-catch-all-error-p result)) result))
(defun EL:DLDWGValid (path / bytes)
  (setq bytes (if (findfile path) (EL:DLBytes path 6)))
  (and (= (length bytes) 6) (equal (list (car bytes) (cadr bytes) (caddr bytes) (cadddr bytes)) '(65 67 49 48))
    (vl-every '(lambda (n) (and (>= n 48) (<= n 57))) (list (nth 4 bytes) (nth 5 bytes)))))
(defun EL:DLBlockAssetName (path / tail bytes)
  ;; Date: 2026-10-20. Keep isolated DXF sources as DXF, without a fake DWG.
  (setq tail (if (>= (strlen path) 4) (strcase (substr path (- (strlen path) 3)))))
  (cond ((and (equal tail ".DWG") (EL:DLDWGValid path)) "block.dwg")
    ((and (equal tail ".DXF") (findfile path) (setq bytes (EL:DLBytes path 256))
        (vl-string-search "SECTION" (vl-list->string bytes))
        (vl-string-search "HEADER" (vl-list->string bytes))) "block.dxf")))
(defun EL:DLBlockAssetValid (path) (and (EL:DLBlockAssetName path) T))
(defun EL:DLSLDWord (bytes index swapped)
  (if swapped (+ (* 256 (nth index bytes)) (nth (1+ index) bytes))
    (+ (nth index bytes) (* 256 (nth (1+ index) bytes)))))
(defun EL:DLSLDSize (path / bytes prefix index swapped)
  (setq bytes (if (findfile path) (EL:DLBytes path 31)) index 0)
  ;; Date: 2026-10-21. Missing or truncated slides have no readable header.
  (if (= (length bytes) 31)
    (progn
      (repeat 17 (setq prefix (cons (nth index bytes) prefix) index (1+ index)))
      (if (and (equal (reverse prefix) '(65 117 116 111 67 65 68 32 83 108 105 100 101 13 10 26 0))
          ;; The documented hex dump uses 0x56 = 86, not decimal 56 (0x38).
          (= (nth 17 bytes) 86) (= (nth 18 bytes) 2)
          (or (equal (list (nth 29 bytes) (nth 30 bytes)) '(52 18))
              (equal (list (nth 29 bytes) (nth 30 bytes)) '(18 52))))
        (progn (setq swapped (= (nth 29 bytes) 18))
          (list (1+ (EL:DLSLDWord bytes 19 swapped)) (1+ (EL:DLSLDWord bytes 21 swapped))))))))
(defun EL:DLChecksum (path / size bytes hash byte)
  (setq size (if (findfile path) (vl-file-size path)))
  (if (and size (> size 0) (<= size 8388608) (setq bytes (EL:DLBytes path -1)) (= size (length bytes)))
    (progn (setq hash 0)
      (foreach byte bytes (setq hash (fix (rem (+ (* hash 131.0) byte) 2147483647.0))))
      (strcat "sld-" (itoa hash) "-" (itoa size)))))
(defun EL:DLFilesEqualWork (a b left right / size good x y)
  (foreach x (list left right) (vlax-put-property x 'Type 1) (vlax-invoke-method x 'Open nil 0 -1 "" ""))
  (vlax-invoke-method left 'LoadFromFile a) (vlax-invoke-method right 'LoadFromFile b)
  (setq size (vlax-get-property left 'Size) good (and (> size 0) (<= size 67108864) (= size (vlax-get-property right 'Size))))
  (while (and good (< (vlax-get-property left 'Position) size))
    (setq x (vlax-safearray->list (vlax-variant-value (vlax-invoke-method left 'Read 65536)))
      y (vlax-safearray->list (vlax-variant-value (vlax-invoke-method right 'Read 65536))) good (equal x y))) good)
(defun EL:DLFilesEqual (a b / left right result stream)
  (setq left (vlax-create-object "ADODB.Stream") right (vlax-create-object "ADODB.Stream")
    result (vl-catch-all-apply 'EL:DLFilesEqualWork (list a b left right)))
  (foreach stream (list left right)
    (vl-catch-all-apply 'vlax-invoke-method (list stream 'Close)) (vlax-release-object stream))
  (and (not (vl-catch-all-error-p result)) result))
(defun EL:DLFolderClaim (path / fso result)
  (setq fso (vlax-create-object "Scripting.FileSystemObject") result (vl-catch-all-apply 'vlax-invoke-method (list fso 'CreateFolder path)))
  (if (not (vl-catch-all-error-p result)) (vlax-release-object result)) (vlax-release-object fso)
  (not (vl-catch-all-error-p result)))
(defun EL:DLAssetInstall (snapshot entry dwg slide / root revision folder next size prefix filename)
  (setq root (EL:Get 'root snapshot) revision (1+ (EL:Get 'asset-revision entry)) size (EL:DLSLDSize slide))
  (EL:Require (and (EL:DLToken (EL:Get 'device-id entry)) (setq filename (EL:DLBlockAssetName dwg)) size) "图形或图例文件无效，未发布。")
  (EL:Require (EL:DLMkdir (strcat root "assets/" (EL:Get 'device-id entry))) "图形资产目录不可写。")
  (setq folder (strcat root "assets/" (EL:Get 'device-id entry) "/" (itoa revision)))
  (while (vl-file-directory-p folder) (setq revision (1+ revision) folder (strcat root "assets/" (EL:Get 'device-id entry) "/" (itoa revision))))
  (EL:Require (EL:DLFolderClaim folder) "资产版本被其他窗口占用，请重试。") (setq folder (strcat folder "/"))
  (EL:Require (and (vl-file-copy dwg (strcat folder filename)) (EL:DLFilesEqual dwg (strcat folder filename))
    (vl-file-copy slide (strcat folder "legend.sld")) (EL:DLFilesEqual slide (strcat folder "legend.sld")))
    "图形复制回读失败，设备库未发布；原版本保留。")
  (setq next (EL:Put 'asset-revision revision entry) prefix (EL:DLAssetPrefix next)
    next (EL:Put 'block-file (strcat prefix filename) (EL:Put 'legend-file (strcat prefix "legend.sld")
      (EL:Put 'legend-checksum (EL:DLChecksum (strcat folder "legend.sld")) (EL:Put 'legend-size size next)))))
  (EL:Require (EL:Get 'legend-checksum next) "图例校验失败，设备库未发布。") next)
(defun EL:DLLegend (entry snapshot / path size checksum)
  ;; A saved draft can already have a valid graphic before watts/ground are complete.
  (if (and entry (EL:DLEntryAssets entry)) (progn (setq path (strcat (EL:Get 'root snapshot) (EL:Get 'legend-file entry)))
    (if (and (setq size (EL:DLSLDSize path)) (equal size (EL:Get 'legend-size entry))
        (setq checksum (EL:DLChecksum path)) (equal checksum (EL:Get 'legend-checksum entry)))
      (progn (EL:PerfCount "device-legend-loads" 1) (list path size))))))
(defun EL:DLExportWork (entity path doc / array)
  (setq *EL:DLExportSet* (vla-Add (vla-get-SelectionSets doc) (EL:DLOperationID)) array (vlax-make-safearray vlax-vbObject '(0 . 0)))
  (vlax-safearray-fill array (list (vlax-ename->vla-object entity)))
  (vla-AddItems *EL:DLExportSet* array) (vla-WBlock doc path *EL:DLExportSet*) T)
(defun EL:DLExport (entity path / doc result *EL:DLExportSet*)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) result (vl-catch-all-apply 'EL:DLExportWork (list entity path doc)))
  (if *EL:DLExportSet* (vl-catch-all-apply 'vla-Delete (list *EL:DLExportSet*)))
  (and (not (vl-catch-all-error-p result)) result (EL:DLDWGValid path)))
(defun EL:DLPickBlock (/ picked entity data definition)
  (setq picked (entsel "\n拾取设备图块（Esc 保留编辑内容）：") entity (car picked))
  (if entity (progn (setq data (entget entity) definition (tblsearch "BLOCK" (EL:EffectiveName entity)))
    (if (and (equal (cdr (assoc 0 data)) "INSERT") definition (= (logand (cdr (assoc 70 definition)) 12) 0)) entity
      (progn (alert "请选择本图中的设备 INSERT；外部参照不能登记为设备。") nil)))))
;; Date: 2026-10-12. Independent multi-pick; one representative per exact effective name.
(defun EL:DLPickDevices (/ selected index entity data definition name names out preset)
  (setq preset (EL:PresetLoad))
  (princ (strcat "\n选择要入库的设备图块，可框选多种；设备图层：" (EL:DLAliasText (EL:Get 'device-layers preset))
    "。Enter 完成选择，Esc 返回设备库。"))
  (setq selected (EL:PerfInput 'ssget (list '((0 . "INSERT") (410 . "Model")))) index 0)
  (while (and selected (< index (sslength selected)))
    (setq entity (ssname selected index) data (entget entity) name (EL:EffectiveName entity)
      definition (tblsearch "BLOCK" name))
    (if (and (equal (cdr (assoc 0 data)) "INSERT") (equal (cdr (assoc 410 data)) "Model")
        definition (= (logand (cdr (assoc 70 definition)) 12) 0) (not (EL:ManagedEntity entity))
        (EL:PresetMember (cdr (assoc 8 data)) (EL:Get 'device-layers preset))
        (not (and (EL:PresetMember (cdr (assoc 8 data)) (EL:Get 'panel-layers preset))
          (EL:PresetNameMember name (EL:Get 'panel-names preset))))
        (not (member (EL:DLNameKey name) names)))
      (setq names (cons (EL:DLNameKey name) names) out (append out (list entity))))
    (setq index (1+ index))) out)
(defun EL:DLCaptureScript (job / slide marker source fullname token)
  (setq slide (vl-prin1-to-string (EL:Get 'slide job)) marker (vl-prin1-to-string (EL:Get 'marker job))
    source (vl-prin1-to-string (EL:Get 'source-name job)) fullname (vl-prin1-to-string (cond ((EL:Get 'source-fullname job)) (T "")))
    token (vl-prin1-to-string (EL:Get 'token job)))
  (strcat "(progn (vl-load-com) (setq el_dl_filedia (getvar \"FILEDIA\") el_dl_cmdecho (getvar \"CMDECHO\")) "
    "(setq el_dl_outcome (vl-catch-all-apply '(lambda () "
    "(setvar \"FILEDIA\" 0) (setvar \"CMDECHO\" 0) (setvar \"TILEMODE\" 1) (setvar \"UCSFOLLOW\" 0) "
    ;; WBlock retains layer state. Normalize only this owned temporary drawing.
    "(vlax-for el_dl_layer (vla-get-Layers (vla-get-ActiveDocument (vlax-get-acad-object))) "
    "(vla-put-Lock el_dl_layer :vlax-false) (vla-put-Freeze el_dl_layer :vlax-false) (vla-put-LayerOn el_dl_layer :vlax-true)) "
    "(command-s \"_.UCS\" \"_World\") (command-s \"_.PLAN\" \"_World\") "
    "(vla-ZoomExtents (vlax-get-acad-object)) (command-s \"_.ZOOM\" \"0.8x\") "
    "(vla-Regen (vla-get-ActiveDocument (vlax-get-acad-object)) 1) (command-s \"_.MSLIDE\" " slide ") T) nil)) "
    "(setvar \"FILEDIA\" el_dl_filedia) (setvar \"CMDECHO\" el_dl_cmdecho) "
    "(setq el_dl_file (open " marker " \"w\")) (if el_dl_file (progn "
    "(write-line (if (vl-catch-all-error-p el_dl_outcome) \"FAILED\" \"DONE\") el_dl_file) (close el_dl_file))) "
    "(setq el_dl_source nil) (vlax-for el_dl_document (vla-get-Documents (vlax-get-acad-object)) "
    "(if (and (equal (vla-get-Name el_dl_document) " source ") "
    "(equal (strcase (vla-get-FullName el_dl_document)) (strcase " fullname "))) (setq el_dl_source el_dl_document))) "
    "(if el_dl_source (vla-SendCommand el_dl_source "
    (vl-prin1-to-string (strcat "(EL:DLCaptureResume " token ")\n")) ")) (princ))\n"))
(defun EL:DLCaptureQueue (job / documents temporary)
  (setq documents (vla-get-Documents (vlax-get-acad-object)) temporary (vla-Open documents (EL:Get 'dwg job) :vlax-true))
  (setq *EL:DLCaptureJob* (EL:Put 'temporary temporary *EL:DLCaptureJob*))
  (vla-SendCommand temporary (EL:DLCaptureScript job)) T)
(defun EL:DLCapturePublishJob (snapshot entry token folder / source job result)
  (setq source (vla-get-ActiveDocument (vlax-get-acad-object))
    job (list (cons 'token token) (cons 'snapshot snapshot) (cons 'entry entry) (cons 'dwg (strcat folder "/block.dwg"))
      (cons 'slide (strcat folder "/legend.sld")) (cons 'marker (strcat folder "/complete.txt"))
      (cons 'source-name (vla-get-Name source)) (cons 'source-fullname (vla-get-FullName source)) (cons 'source source)) *EL:DLCaptureJob* job)
  (setq result (vl-catch-all-apply 'EL:DLCaptureQueue (list job)))
  (if (vl-catch-all-error-p result) (progn (setq *EL:DLCaptureJob* (EL:Put 'failed T *EL:DLCaptureJob*))
    (if (EL:DLCaptureClose *EL:DLCaptureJob*)
      (progn (EL:DLCaptureCleanup *EL:DLCaptureJob*) (setq *EL:DLCaptureJob* nil)))
    (EL:DLFail "图例任务启动失败，编辑内容保留。")) (progn (EL:PerfCount "device-legend-builds" 1) T)))
(defun EL:DLCaptureStart (snapshot entry entity / root token folder dwg)
  (EL:Require (= (getvar "SDI") 0) "请使用多图纸模式（SDI=0）后登记图形。")
  (EL:Require (not *EL:DLCaptureJob*) "上一次图形登记尚未完成，请先返回设备库。")
  (setq root (EL:Get 'root snapshot) token (EL:DLOperationID) folder (strcat root ".staging/" token)
    dwg (strcat folder "/block.dwg"))
  (EL:Require (and (EL:DLMkdir (strcat root ".staging")) (EL:DLFolderClaim folder)) "临时图形目录不可写。")
  (EL:Require (EL:DLExport entity dwg) "设备图形导出失败，编辑内容保留；设备库未写入。")
  (EL:DLCapturePublishJob snapshot entry token folder))
(defun EL:DLCaptureFile (snapshot entry / root token folder original copy)
  (EL:Require (and (= (getvar "SDI") 0) (not *EL:DLCaptureJob*) (> (EL:Get 'asset-revision entry) 0)
    (equal (EL:Get 'block-file entry) (strcat (EL:DLAssetPrefix entry) "block.dwg"))) "当前图形不能修复，请先登记有效图形。")
  (setq root (EL:Get 'root snapshot) token (EL:DLOperationID) folder (strcat root ".staging/" token)
    original (strcat root (EL:Get 'block-file entry)) copy (strcat folder "/block.dwg"))
  (EL:Require (and (EL:DLDWGValid original) (EL:DLMkdir (strcat root ".staging")) (EL:DLFolderClaim folder)
    (vl-file-copy original copy) (EL:DLFilesEqual original copy)) "库内图形无法读取或复制，原资料保留。")
  (EL:DLCapturePublishJob snapshot entry token folder))
(defun EL:DLCaptureCleanup (job / prefix path file)
  (setq prefix (strcat (EL:Get 'root (EL:Get 'snapshot job)) ".staging/" (EL:Get 'token job) "/"))
  (if (and (EL:DLToken (EL:Get 'token job)) (equal (EL:Get 'dwg job) (strcat prefix "block.dwg")))
    (foreach file '("block.dwg" "legend.sld" "complete.txt")
      (setq path (strcat prefix file)) (if (findfile path) (vl-catch-all-apply 'vl-file-delete (list path))))))
(defun EL:DLCaptureClose (job / document path result)
  (setq document (EL:Get 'temporary job))
  (cond ((not document) T)
    ((vl-catch-all-error-p (setq path (vl-catch-all-apply 'vla-get-FullName (list document)))) nil)
    ((not (and (equal (type path) 'STR)
      (equal (strcase (vl-string-translate "\\" "/" path)) (strcase (EL:Get 'dwg job))))) nil)
    (T (setq result (vl-catch-all-apply 'vla-Activate (list (EL:Get 'source job))))
      (if (not (vl-catch-all-error-p result)) (progn
        (setq result (vl-catch-all-apply 'vla-Close (list document :vlax-false))) (not (vl-catch-all-error-p result)))))))
(defun EL:DLCaptureResume (token / job status result)
  (setq job *EL:DLCaptureJob*)
  (if (and job (equal token (EL:Get 'token job)) (or (EL:Get 'failed job) (findfile (EL:Get 'marker job)))) (progn
    (setq status (if (not (EL:Get 'failed job)) (EL:DLReadText (EL:Get 'marker job))))
    (if (not (EL:DLCaptureClose job)) (princ "\n临时图纸尚未关闭；登记未完成，请返回来源图纸运行 ELDEVLIB 重试。")
    (progn (setq *EL:DLCaptureJob* nil)
    (if (and status (equal (vl-string-trim "\r\n" status) "DONE") (EL:DLDWGValid (EL:Get 'dwg job)) (EL:DLSLDSize (EL:Get 'slide job)))
      (setq result (EL:Put 'captured job (EL:Get 'entry job)))
      (progn (EL:DLCaptureCleanup job) (setq *EL:DLError* "图例生成未完成，编辑内容保留；可重新拾取。")))
    (if *EL:DLContinue* (apply *EL:DLContinue* (list result)) result))))))
(princ)

