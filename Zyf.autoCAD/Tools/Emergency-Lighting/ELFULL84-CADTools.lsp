    ((setq limit (EL:PanelCircuitLimitText *EL:PanelDraft*)) (EL:PanelText "p_error" limit))
    ((not (EL:Get 'circuits *EL:PanelDraft*)) (EL:PanelText "p_error" "请先拾取配电箱和实际出线，当前输入保留。"))
    ;; 日期：2026-10-23。缺少真实模板定义时不关闭再打开对话框，直接指出补入入口。
