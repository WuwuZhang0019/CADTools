    (cons 'circuits-omitted (max 0 (- count 32))) (cons 'circuit-details (reverse rows))))
(defun EL:ColdLegacyFeedback (summary / row issue shown)
  (princ (strcat "\n完整旧路径结果：" (itoa (EL:Get 'circuits summary)) " 条回路，"
    (itoa (EL:Get 'incomplete-circuits summary)) " 条未完成，"
    (itoa (EL:Get 'circuit-issue-count summary)) " 项回路问题，"
    (itoa (EL:Get 'zero-device-circuits summary)) " 条零设备回路。"))
  (setq shown 0)
  (foreach row (EL:Get 'circuit-details summary)
    (if (and (< shown 10) (or (not (EL:Get 'complete row))
        (> (EL:Get 'issue-count row) 0) (= (EL:Get 'device-count row) 0)))
      (progn
        (setq shown (1+ shown))
        (princ (strcat "\n回路 " (EL:LogText (EL:Get 'id row)) "：设备 "
          (itoa (EL:Get 'device-count row)) "，问题 " (itoa (EL:Get 'issue-count row))))
        (foreach issue (EL:ColdHead (EL:Get 'issues row) 3)
          (princ (strcat " / " (EL:LogText (EL:Get 'code issue)) "，对象 "
            (EL:LogText (EL:Get 'object issue)) "，关联 " (EL:LogText (EL:Get 'detail issue))))))))
  (princ "\n本命令为只读对照，不打开统计面板；面板测试请 APPLOAD 同包 ELFULL84.lsp 后运行 ELFULL84。"))
(defun EL:ColdBoundsAudit (samples / row actual checked missing different verdict)
  ;; This COM parity audit is outside managed timing and is separately reported.
  (setq checked 0 missing 0 different 0)
  (foreach row samples
    (setq actual (if (handent (car row)) (EL:EntityBounds (handent (car row)))))
    (setq checked (1+ checked))
    (setq verdict (cond ((not actual) (setq missing (1+ missing)) 'missing)
      ((not (equal actual (cdr row) 0.000001)) (setq different (1+ different)) 'different)
      (T 'matching)))
    ;; Native reports at most 16 samples; retain a hard diagnostic cap as well.
    (if (<= checked 16)
      (EL:LogEvent "COLD_BOUNDS_SAMPLE" (list (cons 'handle (car row))
        (cons 'expected (cdr row)) (cons 'actual actual) (cons 'verdict verdict)))))
  (list (cons 'checked checked) (cons 'missing missing) (cons 'different different)))
(defun EL:ColdReportPath (extension)
  (strcat *EL:Root* "output/ELCOLD84-" (rtos (getvar "CDATE") 2 8)
    "-" (itoa (EL:Tick)) extension))
(defun EL:ColdRun (/ mode pick panel saved cfg started loaded selected returned audited finished
    owner epoch ss payload audit nativepath reportpath report legacy legacy-start legacy-end result rows row legacy-summary panelroute)
  (setq *EL:ColdCompleted* nil *EL:ColdContext* nil)
  ;; Date: 2026-10-22. An early failure must not export a previous run's reports.
  (setq *EL:ColdReports* (EL:Put (namedobjdict) nil *EL:ColdReports*))
  (setq panelroute '((entry . "ELCOLD84") (policy . readonly-comparison)
    (panel-requested . nil) (panel-file . "ELFULL84.lsp") (panel-command . "ELFULL84")))
  (EL:ColdCheckpoint "MODE" (list '(diagnostic-revision . "2026-10-22-logs1")
    '(legacy-diagnostic-revision . "2026-10-22-legacy2") (cons 'panel-route panelroute)))
  (EL:LogEvent "COLD_PANEL_ROUTE" panelroute)
  (princ "\nELCOLD84：只读冷路径性能原型；当前 .NET 仅验证批量读取、索引及保守候选发现，不替代完整识别。")
  (princ "\n此入口不打开统计面板；面板测试请 APPLOAD 同包 ELFULL84.lsp 后运行 ELFULL84。")
  (initget "Both Prototype")
  (setq mode (getkword "\n模式 [完整旧路径对照(Both)/仅原型(Prototype)] <Both>："))
  (if (not mode) (setq mode "Both"))
  (EL:ColdCheckpoint "PICK_PANEL" (list (cons 'mode mode)))
  (if (setq pick (EL:PickModel 'panel "\n拾取本次测试的新配电箱："))
    (progn
      (setq panel (cdr (assoc 5 (entget (car pick)))))
      (EL:Require (not (EL:ManagedEntity (car pick))) "请选择平面配电箱。")
      (EL:ColdCheckpoint "LOAD_CONFIG" (list (cons 'panel panel) (cons 'drawing (EL:DrawingID))))
      (setq saved (EL:LoadConfig))
      (EL:Require saved "图纸配置读取失败，请先检查现有识别预设。")
      (setq cfg (EL:Put 'roles (EL:Get 'roles saved) (EL:Put 'auto-panel panel
        (EL:Put 'params (EL:FixedRecognitionParams saved)
          (EL:PresetConfig (EL:DefaultConfig (EL:DrawingID)))))))
      (EL:ColdCheckpoint "PRESET_READY" nil)
      (if (and (setq cfg (EL:PresetReady (car pick) cfg))
          (progn (EL:ColdCheckpoint "PICK_STARTS" nil) (setq cfg (EL:PickCircuitStarts cfg))))
        (progn
          ;; Start before clearing the pick overlay, selecting, NETLOAD and the first JIT.
          (setq started (EL:Tick))
          (EL:ClearGapPreview) (EL:ClearPickHighlights)
          (EL:ColdCheckpoint "NATIVE_LOAD" (list (cons 'roots (EL:ColdRootHandles cfg))
            (cons 'root-count (length (EL:Get 'circuit-starts cfg)))
            (cons 'circuit-starts (EL:Get 'circuit-starts cfg))
            (cons 'device-tolerance (EL:DeviceContactTolerance cfg))
            (cons 'dmax (EL:Get 'Dmax (EL:Get 'params cfg)))
            (cons 'boundary-tolerance (EL:Get 'eps_boundary (EL:Get 'params cfg)))))
          (EL:PerfCall "COLD_NATIVE_LOAD" 'EL:ColdLoad nil)
          (setq loaded (EL:Tick) owner (namedobjdict) epoch *EL:FreshEpoch*
            nativepath (EL:ColdReportPath ".json") reportpath (EL:ColdReportPath ".eld"))
          (EL:ColdCheckpoint "SELECTION" (list (cons 'native-report nativepath) (cons 'comparison-report reportpath)
            (cons 'wire-layers (EL:Get 'wire-layers cfg))
            (cons 'panel-layers (EL:Get 'panel-layers cfg)) (cons 'device-layers (EL:Get 'device-layers cfg))))
          (setq ss (EL:PresetSelection cfg "INSERT,LINE,LWPOLYLINE" '(wire-layers panel-layers device-layers))
            selected (EL:Tick))
          ;; Register paths before native dispatch so ELDIAG includes failed native reports.
          (setq *EL:ColdReports* (EL:Put owner (list nativepath reportpath) *EL:ColdReports*))
          (EL:ColdCheckpoint "NATIVE_PROBE" (list (cons 'selection-type (type ss))
            (cons 'selection-count (if ss (sslength ss)))))
          (EL:Require ss "预设范围没有可测试对象。")
          (EL:LogEvent "COLD_NATIVE_PROBE_BEGIN" (list (cons 'entry "ELNETCOLD84")
            (cons 'panel panel) (cons 'roots (EL:ColdRootHandles cfg)) (cons 'report nativepath)))
          (setq payload (EL:MeasuredCatch 'EL:PerfCall (list "COLD_NATIVE_PROBE" 'EL:ColdNativeInvoke
            (list ss (handent panel) (EL:ColdRootHandles cfg)
              (EL:DeviceContactTolerance cfg) (EL:Get 'Dmax (EL:Get 'params cfg))
              (EL:Get 'eps_boundary (EL:Get 'params cfg)) nativepath))))
          (if (vl-catch-all-error-p payload)
            (progn
              (EL:LogEvent "COLD_NATIVE_PROBE_FAILED"
                (list (cons 'error (vl-catch-all-error-message payload)) (cons 'report nativepath)))
              (EL:Require nil (strcat "只读 .NET 原型调用失败：" (vl-catch-all-error-message payload)))))
          (EL:ColdCheckpoint "PAYLOAD_VALIDATE" (list (cons 'native-return (EL:ColdReplySummary payload))))
          (EL:LogEvent "COLD_NATIVE_RETURN" (EL:Get 'native-return *EL:ColdContext*))
          (setq payload (EL:ColdNativePayload payload) returned (EL:Tick))
          (if (not (and (listp payload) (equal (type (car payload)) 'STR)
              (vl-string-search "\"status\":\"PROTOTYPE_COARSE_ONLY\"" (car payload))))
            (EL:LogEvent "COLD_NATIVE_PROBE_FAILED" (EL:Get 'native-return *EL:ColdContext*)))
          (EL:Require (and (listp payload) (equal (type (car payload)) 'STR)
              (vl-string-search "\"status\":\"PROTOTYPE_COARSE_ONLY\"" (car payload)))
            "只读 .NET 原型失败，未产生识别结果；请导出 ELDIAG 检查原型报告。")
          (EL:ColdCheckpoint "BOUNDS_AUDIT" nil)
          (setq audit (EL:ColdBoundsAudit (cadr payload)) audited (EL:Tick))
          (EL:LogEvent "COLD_BOUNDS_AUDIT" audit)
          (EL:ColdCheckpoint "SOURCE_GUARD" (list (cons 'bounds-audit audit)
            (cons 'owner-same (equal owner (namedobjdict))) (cons 'epoch-before epoch)
            (cons 'epoch-after *EL:FreshEpoch*)))
          (EL:Require (and (equal owner (namedobjdict)) (equal epoch *EL:FreshEpoch*))
            "SOURCE_CHANGED：测试期间源图或当前图纸已变化，本次对照无效。")
          (if (equal mode "Both")
            (progn
              (princ "\n.NET 候选阶段完成；继续执行完整旧路径只读对照，另计耗时。")
              (EL:ColdCheckpoint "LEGACY_RECOGNITION" nil)
              (setq legacy-start (EL:Tick) result (EL:ColdLegacy cfg panel) legacy-end (EL:Tick))
              (EL:LogEvent "COLD_LEGACY_RETURN" (list (cons 'elapsed-ms (EL:PerfDelta legacy-start legacy-end))
                (cons 'result-type (type result)) (cons 'circuits (length (EL:Get 'circuits result)))
                (cons 'issues (EL:Get 'issues result))))
              (EL:ColdCheckpoint "LEGACY_SUMMARY" (list '(legacy-returned . T)))
              (setq legacy-summary (EL:ColdLegacySummary result))
              (EL:LogEvent "COLD_LEGACY_SUMMARY" legacy-summary)
              (setq legacy (list '(status . legacy-full-readonly)
                (cons 'circuits (length (EL:Get 'circuits result)))
                (cons 'summary legacy-summary) (cons 'result (EL:DiagnosticResult result))))))
          (EL:ColdCheckpoint "FINAL_SOURCE_GUARD" (list (cons 'owner-same (equal owner (namedobjdict)))
            (cons 'epoch-after *EL:FreshEpoch*)))
          (setq finished (EL:Tick))
          (EL:Require (and (equal owner (namedobjdict)) (equal epoch *EL:FreshEpoch*))
            "SOURCE_CHANGED：完整对照期间源图或当前图纸已变化，本次对照无效。")
          (EL:ColdCheckpoint "REPORT_WRITE" nil)
          (setq report (list '(version . 1) '(date . "2026-10-23") '(package . "v0.1.84")
            '(diagnostic-revision . "2026-10-22-logs1")
            '(legacy-diagnostic-revision . "2026-10-22-legacy2")
            (cons 'legacy-executed (equal mode "Both")) (cons 'panel-route panelroute)
            (cons 'bounds-audit-passed (and (= (EL:Get 'missing audit) 0) (= (EL:Get 'different audit) 0)))
            '(status . prototype-coarse-only) '(complete-native-recognition . nil)
            '(target-full-recognition-ms . 3000) '(target-achieved . unverified)
            '(readonly-drawing . T) '(previous-result-cache . nil)
            (cons 'drawing (EL:DrawingID)) (cons 'panel panel) (cons 'mode mode)
            (cons 'config cfg) (cons 'native-report nativepath)
            (cons 'load-and-clear-ms (EL:PerfDelta started loaded))
            (cons 'selection-and-path-ms (EL:PerfDelta loaded selected))
            (cons 'managed-bridge-ms (EL:PerfDelta selected returned))
            (cons 'bounds-audit-ms (EL:PerfDelta returned audited))
            (cons 'prototype-pick-to-return-ms (EL:PerfDelta started audited))
            (cons 'legacy-full-ms (if legacy-start (EL:PerfDelta legacy-start legacy-end)))
            (cons 'end-to-end-ms (EL:PerfDelta started finished)) (cons 'bounds-audit audit)
            (cons 'legacy legacy)))
          (EL:Require (EL:WriteData reportpath report) "原型对照报告写入失败。")
          (setq *EL:ColdReports* (EL:Put owner (list nativepath reportpath) *EL:ColdReports*))
          (setq *EL:ColdCompleted* T)
          (EL:ColdCheckpoint "FINISHED" (list (cons 'legacy-executed (equal mode "Both"))
            '(complete-native-recognition . nil) (cons 'bounds-audit-passed (EL:Get 'bounds-audit-passed report))))
          (EL:LogEvent "COLD_PROBE80" report)
          (princ (strcat "\n.NET 候选原型从拾取结束到返回："
            (itoa (EL:PerfDelta started audited)) " ms（含本次 NETLOAD、选择和边界抽查）。"))
          (if legacy-start (princ (strcat "\n完整旧路径只读识别："
            (itoa (EL:PerfDelta legacy-start legacy-end)) " ms。")))
          (princ (strcat "\n边界抽查：" (itoa (EL:Get 'checked audit)) " 项，缺失 "
            (itoa (EL:Get 'missing audit)) " 项，差异 " (itoa (EL:Get 'different audit)) " 项。"))
          (if (equal mode "Both") (EL:ColdLegacyFeedback legacy-summary)
            (princ "\n本次选择 Prototype，仅候选阶段完成；未执行完整旧路径识别，不会打开统计面板。"))
          (princ "\n当前原型尚未执行 .NET 精细识别与编号；完整首次识别 3 秒目标尚未验收。")
          (princ (strcat "\n原型报告：" nativepath "\n对照报告：" reportpath "\n运行 ELDIAG 可一并导出。")))))))
(defun c:ELCOLD84 (/ *error* outcome *EL:ColdCompleted* *EL:ColdContext*)
  (defun *error* (message)
    (vl-catch-all-apply 'EL:ClearGapPreview nil)
    (vl-catch-all-apply 'EL:ClearPickHighlights nil)
    (EL:ColdFailure message)
    (EL:LogFailure message) (EL:LogFinish 'cold-probe-failed)
    (if message (princ (strcat "\n只读原型已停止：" message))) (princ))
  (if (EL:EnsureRoot)
    (progn
      (EL:LogStart)
      ;; Date: 2026-10-22. The generic log name contains '/', invalid in a
      ;; Windows timeline filename. Name this command's own run explicitly.
      (if *EL:PerfLogOwner* (setq *EL:PerfCommand* "ELCOLD84"))
      (setq outcome (EL:MeasuredCatch 'EL:ColdRun nil))
      (EL:ClearGapPreview) (EL:ClearPickHighlights)
      (if (vl-catch-all-error-p outcome)
        (progn (EL:ColdFailure (vl-catch-all-error-message outcome))
          (EL:LogFailure (vl-catch-all-error-message outcome))
          (princ (strcat "\n只读原型未完成：" (vl-catch-all-error-message outcome)))))
      ;; Date: 2026-10-22. Native EXIT may return without a catch error.
      ;; Only a written and validated comparison report completes the probe.
      (if (and (not (vl-catch-all-error-p outcome)) (not *EL:ColdCompleted*))
        (EL:ColdFailure "本轮未写出完成报告；请检查最后阶段及取消操作。"))
      (EL:LogFinish (if (or (vl-catch-all-error-p outcome) (not *EL:ColdCompleted*))
        'cold-probe-failed 'cold-probe-finished))))
  (princ))

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "startup.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-14. Resolve the current package without changing CAD security.
(defun EL:StartupCandidate (directory marker / root)
  ;; MainDialog may contain the selected filename, not only its directory.
  (if (and (equal (type directory) 'STR) (findfile directory)
           (not (vl-file-directory-p directory)))
    (setq directory (vl-filename-directory directory)))
  (if (setq root (EL:NormalizeRoot directory))
    (cond
      ((and (findfile (strcat root marker)) (EL:RootValid root)) root)
      ((and (findfile (strcat root "../" marker)) (EL:RootValid (strcat root "../")))
        (EL:NormalizeRoot (strcat root "../"))))))
(defun EL:StartupRegistryDirectory ()
  (vl-registry-read
    (strcat "HKEY_CURRENT_USER\\" (vlax-product-key)
      "\\Profiles\\" (getvar "CPROFILE") "\\Dialogs\\Appload") "MainDialog"))
(defun EL:StartupEmbeddedRoot () nil)
(defun EL:StartupUnwrap (value)
  (while (equal (type value) 'VARIANT) (setq value (vlax-variant-value value))) value)
(defun EL:StartupBinaryWork (path chunks / bytes expected matched)
  (if (EL:DLMkdir (vl-filename-directory path))
    (progn
      ;; Date: 2026-10-12. Native decode avoids millions of interpreted byte operations.
      (setq *EL:StartupStage* "BASE64_DECODE"
        *EL:StartupXML* (vlax-create-object "MSXML2.DOMDocument.6.0")
        *EL:StartupNode* (EL:StartupUnwrap (vlax-invoke-method *EL:StartupXML* 'createElement "binary")))
      (vlax-put-property *EL:StartupNode* 'dataType "bin.base64")
      (vlax-put-property *EL:StartupNode* 'text (EL:StoreJoinStrings chunks))
      (setq bytes (vlax-get-property *EL:StartupNode* 'nodeTypedValue))
      ;; Date: 2026-10-14. Canonical Base64 is an exact byte comparison, including
      ;; MSXML's line wrapping. Keep SAFEARRAYs native instead of making two
      ;; multi-million-element LISP lists for the bundled DWGs and slides.
      (vlax-put-property *EL:StartupNode* 'nodeTypedValue bytes)
      (setq expected (vlax-get-property *EL:StartupNode* 'text)
        *EL:StartupStream* (vlax-create-object "ADODB.Stream"))
      (vlax-put-property *EL:StartupStream* 'Type 1)
      ;; Date: 2026-10-12. Visual LISP needs all five ADO optional slots.
      (setq *EL:StartupStage* "STREAM_OPEN")
      (vlax-invoke-method *EL:StartupStream* 'Open nil 0 -1 "" "")
      ;; Date: 2026-10-22. NETLOAD locks its DLL. Exact readback reuses identical
      ;; embedded DLL bytes without trying to overwrite the loaded assembly.
      (if (and (equal (strcase (vl-filename-extension path)) ".DLL") (findfile path))
        (progn
          (setq *EL:StartupStage* "NATIVE_EXISTING_READBACK")
          (vlax-invoke-method *EL:StartupStream* 'LoadFromFile path)
          (vlax-put-property *EL:StartupNode* 'nodeTypedValue
            (vlax-invoke-method *EL:StartupStream* 'Read -1))
          (setq matched (equal expected (vlax-get-property *EL:StartupNode* 'text)))
          (if (not matched)
            (progn
              (vlax-put-property *EL:StartupStream* 'Position 0)
              (vlax-invoke-method *EL:StartupStream* 'SetEOS)))))
      (if (not matched)
        (progn
          (setq *EL:StartupStage* "BINARY_WRITE")
          (vlax-invoke-method *EL:StartupStream* 'Write bytes)
          ;; Only the versioned runtime seed is replaced, never the user's library.
          (setq *EL:StartupStage* "SAVE_TO_FILE")
          (vlax-invoke-method *EL:StartupStream* 'SaveToFile path 2)))
      (setq *EL:StartupStage* "BINARY_READBACK")
      (vlax-invoke-method *EL:StartupStream* 'LoadFromFile path)
      (vlax-put-property *EL:StartupNode* 'nodeTypedValue
        (vlax-invoke-method *EL:StartupStream* 'Read -1))
      (equal expected (vlax-get-property *EL:StartupNode* 'text)))))
(defun EL:StartupWriteBase64 (path chunks / result object *EL:StartupStream* *EL:StartupStage* *EL:StartupXML* *EL:StartupNode*)
  (setq *EL:StartupStage* "STREAM_CREATE")
  (setq result (vl-catch-all-apply 'EL:StartupBinaryWork (list path chunks)))
  (if *EL:StartupStream* (vl-catch-all-apply 'vlax-invoke-method (list *EL:StartupStream* 'Close)))
  (foreach object (list *EL:StartupStream* *EL:StartupNode* *EL:StartupXML*)
    (if object (vl-catch-all-apply 'vlax-release-object (list object))))
  (if (vl-catch-all-error-p result)
    (setq *EL:StartupError* (strcat path " [" *EL:StartupStage* "] : " (vl-catch-all-error-message result)))
    (if (not result)
      (setq *EL:StartupError* (strcat path " [" *EL:StartupStage* "] : 文件写入或完整回读校验失败"))))
  (and (not (vl-catch-all-error-p result)) result))
(defun EL:StartupResource (writer path data / result)
  (setq result (vl-catch-all-apply writer (list path data)))
  (if (or (vl-catch-all-error-p result) (not result))
    (progn
      (if (not *EL:StartupError*)
        (setq *EL:StartupError* (strcat path " : "
          (if (vl-catch-all-error-p result) (vl-catch-all-error-message result) "文件写入或回读校验失败"))))
      nil)
    T))
(defun EL:StartupSelectRoot (marker / path)
  ;; Date: 2026-10-10. A confirmed package path keeps diagnostics beside the ZIP.
  (princ "\n请选择解压包内的 START-CAD2020.lsp；日志将保存在该包的 output 文件夹。")
  (if (setq path (getfiled "确认应急照明交付目录" "START-CAD2020.lsp" "lsp" 0))
    (EL:StartupCandidate path marker)))
(defun EL:StartupRememberRoot (root marker)
  (if root (vl-catch-all-apply 'setenv (list (strcat "EL_PACKAGE_ROOT_" marker) root)))
  root)
(defun c:ELROOT (/ root)
  (if (and *EL:PackageMarker* (setq root (EL:StartupSelectRoot *EL:PackageMarker*)))
    (progn
      (setq *EL:Root* (EL:StartupRememberRoot root *EL:PackageMarker*))
      (princ (strcat "\n插件数据目录已设置：" root "；后续日志保存在 output 文件夹。")))
    (princ "\n未选择当前版本的完整交付目录，原目录保持不变。"))
  (princ))
(defun EL:StartupWriteLines (path lines / stream result line)
  (if (setq stream (open path "w"))
    (progn
      (setq result (vl-catch-all-apply
        '(lambda () (foreach line lines (write-line line stream))) nil))
      (close stream)
      (if (not (vl-catch-all-error-p result))
        (progn
          (setq stream (open path "r") result T)
          (if stream
            (progn
              (foreach line lines
                (if (not (equal line (read-line stream))) (setq result nil)))
              (if (read-line stream) (setq result nil))
              (close stream) result)))))))
(defun EL:StartupFindRoot (marker / directory root path filename)
  ;; APPLOAD's last folder is only a candidate: require this version's marker
  ;; and the complete package before using it. No stale-root fallback.
  (setq directory (vl-catch-all-apply 'EL:StartupRegistryDirectory nil))
  (if (not (vl-catch-all-error-p directory))
    (setq root (EL:StartupCandidate directory marker)))
  (if (and (not root) (setq path (findfile marker)))
    (setq root (EL:StartupCandidate (vl-filename-directory path) marker)))
  ;; A support path can point at src, where the package marker is not visible.
  (foreach filename '("START-CAD2020.lsp" "load.lsp")
    (if (and (not root) (setq path (findfile filename)))
      (setq root (EL:StartupCandidate path marker))))
  (if (not root)
    (setq root (EL:StartupCandidate (getenv (strcat "EL_PACKAGE_ROOT_" marker)) marker)))
  root)
(defun EL:StartupRoot (marker / root)
  (setq *EL:StartupAttempted* T *EL:StartupError* nil
    root (EL:PerfCall "LOAD_ROOT_SEARCH" 'EL:StartupFindRoot (list marker)))
  ;; Never prompt during startup. Manual relocation belongs to c:ELROOT only.
  (if (not root)
    (progn
      (setq root (vl-catch-all-apply 'EL:PerfCall
        (list "LOAD_RUNTIME" 'EL:StartupEmbeddedRoot nil)))
      (if (vl-catch-all-error-p root)
        (setq *EL:StartupError* (vl-catch-all-error-message root) root nil))
      (if root (princ "\n未确认交付目录，暂用本地运行目录；输入 ELROOT 可改回交付包目录。"))))
  (setq *EL:Root* root *EL:PackageMarker* marker)
  (if root (EL:StartupRememberRoot root marker))
  (if root (princ (strcat "\n插件数据目录：" root))
    (princ (strcat "\n自动初始化失败："
      (cond (*EL:StartupError*) (T "无法建立完整本地运行目录，请检查 LOCALAPPDATA 路径。")))))
  root)
(defun EL:StartupCommandHint (ready)
  ;; Date: 2026-10-15. Print after the loading logs and timing report.
  (princ (if ready "\n启动命令：输入 ELSTAT 开始统计；ELDEVLIB 打开设备库。"
