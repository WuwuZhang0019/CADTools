;; Date: 2026-10-21. Power review edits only values on the retained circuit snapshot.
(defun EL:PowerReviewCircuits (ids result / names c index)
  (setq index 0)
  (foreach c (EL:Get 'circuits result)
    (setq index (1+ index))
    (if (vl-some '(lambda (id) (member id (EL:Get 'devices c))) ids)
      (setq names (append names (list (EL:CircuitNumberText c index))))))
  (EL:DLAliasText names))
(defun EL:PowerReviewRows (result powers / rows)
  (setq rows (EL:SimpleRows (EL:DLConnectedBlocks result) powers))
  (append (vl-remove-if '(lambda (r) (numberp (EL:Get 'watts r))) rows)
    (vl-remove-if-not '(lambda (r) (numberp (EL:Get 'watts r))) rows)))
(defun EL:PowerReviewRemember (/ row)
  (if (setq row (nth *EL:PowerReviewIndex* *EL:PowerReviewRows*))
    (setq *EL:PowerReviewInputs* (EL:Put (EL:Get 'key row)
      (list (get_tile "q_watts") (get_tile "q_zero")) *EL:PowerReviewInputs*))))
(defun EL:PowerReviewFill (/ row r input id issue c objects lines index)
  (start_list "q_rows")
  (foreach r *EL:PowerReviewRows*
    (add_list (strcat (EL:Get 'name r) " / " (itoa (EL:Get 'count r)) " 个 / "
      (if (numberp (EL:Get 'watts r)) (strcat (itoa (EL:Get 'watts r)) "W") "待核对（回路功率留空）"))))
  (end_list)
  (set_tile "q_rows" (itoa *EL:PowerReviewIndex*))
  (setq row (nth *EL:PowerReviewIndex* *EL:PowerReviewRows*)
    input (EL:Get (EL:Get 'key row) *EL:PowerReviewInputs*))
  (set_tile "q_watts" (if input (car input)
    (if (numberp (EL:Get 'watts row)) (itoa (EL:Get 'watts row)) "")))
  (set_tile "q_zero" (if input (cadr input) (if (equal (EL:Get 'watts row) 0) "1" "0")))
  (start_list "q_details")
  (add_list (strcat "图块名：" (EL:Get 'name row)))
  (add_list (strcat "所在回路：" (EL:PowerReviewCircuits (EL:Get 'ids row) *EL:PanelDraft*)))
  (add_list (if (numberp (EL:Get 'watts row)) "本设备单个功率已填写，无需重复补填。"
    "原因：单个功率未填写或无效；可直接输入并应用，也可保持空白生成。"))
  (setq index 0)
  (foreach c (EL:Get 'circuits *EL:PanelDraft*)
    (setq index (1+ index))
    (if (and (EL:Get 'issues c)
        (vl-some '(lambda (id) (member id (EL:Get 'devices c))) (EL:Get 'ids row)))
      (foreach issue (EL:Get 'issues c)
        (setq lines (cons (strcat "所在回路 " (EL:CircuitNumberText c index)
          "：" (EL:GenerationIssueText issue)) lines))))
    (if (EL:CircuitNoDeviceWarning c)
      (setq lines (cons (strcat (EL:CircuitNumberText c index)
        "：未识别到设备，补单个功率无法解决；生成时保留回路、功率留空。导线："
        (EL:DLAliasText (EL:Get 'wires c))) lines)))
    (foreach issue (EL:Get 'power-issues c)
      (setq objects (EL:Get 'object issue))
      (if (not (listp objects)) (setq objects (list objects)))
      (if (vl-some '(lambda (id) (member id objects)) (EL:Get 'ids row))
        (setq lines (cons (EL:GenerationIssueText issue) lines)))))
  (foreach r (EL:Unique (reverse lines)) (add_list r))
  (end_list)
  (start_list "q_instances")
  (foreach id (EL:Get 'ids row)
    (add_list (strcat id " / " (EL:PowerReviewCircuits (list id) *EL:PanelDraft*))))
  (end_list)
  (set_tile "q_instances" (itoa *EL:PowerReviewInstance*)))
(defun EL:PowerReviewSelect (value)
  (EL:PowerReviewRemember)
  (setq *EL:PowerReviewIndex* (atoi value) *EL:PowerReviewInstance* 0)
  (EL:PowerReviewFill)
  (set_tile "q_status" "修改后点击应用；切换设备会保留尚未应用的输入。"))
(defun EL:PowerReviewApply (/ row raw watts key draft powers computed)
  (EL:PowerReviewRemember)
  (setq row (nth *EL:PowerReviewIndex* *EL:PowerReviewRows*) key (EL:Get 'key row)
    raw (vl-string-trim " " (get_tile "q_watts")) watts (EL:ParseWatts raw))
  (cond
    ((and (/= raw "") (not (numberp watts))) (set_tile "q_status" "请输入非负整数 W，或留空。"))
    ((and (equal watts 0) (not (equal (get_tile "q_zero") "1")))
      (set_tile "q_status" "填写 0W 时请勾选确认；未知功率请留空。"))
    (T
      (setq draft (EL:DLSetOverride *EL:PanelDraft* key 'watts watts)
        draft (EL:DLSetOverride draft key 'watts-set T)
        powers (EL:Put key watts *EL:PanelPowers*)
        computed (EL:PanelCompute draft powers *EL:PanelConfig*))
      (setq *EL:PanelDraft* computed *EL:PanelPowers* powers
        *EL:PowerReviewRows* (subst (EL:Put 'watts watts row) row *EL:PowerReviewRows*))
      (EL:PowerReviewFill)
      (set_tile "q_status" "已应用并重算本箱功率；未重新识别回路。") T)))
(defun EL:PowerReviewLocate (/ row id block checked)
  (setq row (nth *EL:PowerReviewIndex* *EL:PowerReviewRows*)
    id (nth *EL:PowerReviewInstance* (EL:Get 'ids row))
    block (EL:By 'id id (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))))
  (if (and block (handent id))
    (progn
      (setq checked (vl-catch-all-apply 'EL:SimpleLocate
        (list (list (cons 'devices (list block)))
          (EL:Put 'count 1 (EL:Put 'ids (list id) row)))))
      (if (not (vl-catch-all-error-p checked))
        (vl-catch-all-apply 'EL:PerfInput (list 'getstring (list "\n按 Enter 返回功率核对（Esc 也可返回）：")))))
    (alert "所选设备已删除或不在当前图纸，请返回核对源图。"))
  (EL:ClearGapPreview) (EL:ClearPickHighlights))
(defun EL:PanelPowerReview (dialog / status *EL:PowerReviewRows* *EL:PowerReviewIndex*
    *EL:PowerReviewInstance* *EL:PowerReviewInputs*)
  (setq *EL:PowerReviewRows* (EL:PowerReviewRows *EL:PanelDraft*
      (if (assoc 'effective-powers *EL:PanelDraft*) (EL:Get 'effective-powers *EL:PanelDraft*) *EL:PanelPowers*))
    *EL:PowerReviewIndex* 0 *EL:PowerReviewInstance* 0 status 2)
  (if (not *EL:PowerReviewRows*) (alert "本箱尚未识别到设备，请先查看回路连接。")
    (while (= status 2)
      (if (new_dialog "el_panel_power_review" dialog)
        (progn
          (EL:PowerReviewFill)
          (EL:MonitorActionTile "q_rows" "(EL:PowerReviewSelect $value)")
          (EL:MonitorActionTile "q_instances" "(setq *EL:PowerReviewInstance* (atoi $value))")
          (EL:MonitorActionTile "q_apply" "(EL:PowerReviewApply)")
          (EL:MonitorActionTile "q_locate" "(EL:PowerReviewRemember) (done_dialog 2)")
          (EL:MonitorActionTile "cancel" "(done_dialog 0)")
          (setq status (EL:PerfInput 'start_dialog nil))
          (if (= status 2) (EL:PowerReviewLocate)))
        (setq status 0)))))

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "store-compact.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-11. Lossless V2 storage envelope; logical V1 records stay exact.
;; Native StoreEncode still owns REAL/INT and the 32-character DXF segments.
(defun EL:CompactRequire (condition reason)
  (if (not condition)
    (progn
      (EL:LogEvent "STORE_COMPACT_ERROR" (list (cons 'reason reason)))
      (EL:StoreParseRequire nil))) condition)
(defun EL:CompactProperList (value)
  ;; Date: 2026-10-14. Native traversal also distinguishes dotted tails.
  (and (listp value) (numberp (vl-list-length value))))
(defun EL:CompactIndex (value items / index found)
  (setq index 0)
  (while (and items (not found))
    (if (equal value (car items)) (setq found (list index)))
    (setq index (1+ index) items (cdr items)))
  (if found (car found)))
(defun EL:CompactTemplateAdd (value)
  (if value
    (progn
      (EL:CompactRequire (and (listp value) (EL:CompactProperList value)) 'template-shape)
      (if (not (member value *EL:CompactTemplates*))
        (setq *EL:CompactTemplates* (append *EL:CompactTemplates* (list value)))))))
(defun EL:CompactTemplates (store / *EL:CompactTemplates* record direct configured)
  ;; Historical global templates may differ. Copies belonging to one record
  ;; must agree; never resolve an ambiguity by overwriting a supplied copy.
  (EL:CompactTemplateAdd (EL:Get 'fixed-template store))
  (foreach record (EL:Get 'diagrams store)
    (setq direct (EL:Get 'template record)
      configured (EL:Get 'template (EL:Get 'config record)))
    (EL:CompactRequire (or (not direct) (not configured) (equal direct configured)) 'template-copy-conflict)
    (EL:CompactTemplateAdd direct) (EL:CompactTemplateAdd configured))
  *EL:CompactTemplates*)
(defun EL:CompactAtom (value / kind key bucket candidates found index)
  ;; Bucket keys accelerate lookup only. Full EQUAL decides every identity.
  (setq kind (type value)
    key (if (equal kind 'SYM) (list kind value)
      (list kind (strlen value) (substr value 1 1) (substr value (max 1 (strlen value)) 1)))
    bucket (assoc key *EL:CompactBuckets*) candidates (cdr bucket)
    found (assoc value candidates))
  (if found (cdr found)
    (progn
      (setq index *EL:CompactAtomCount* *EL:CompactAtomCount* (1+ index)
        *EL:CompactAtoms* (cons value *EL:CompactAtoms*)
        *EL:CompactBuckets* (EL:Put key (cons (cons value index) candidates) *EL:CompactBuckets*))
      index)))
(defun EL:CompactEmit (value)
  (setq *EL:CompactTokens* (cons value *EL:CompactTokens*)))
(defun EL:CompactEncode (value / kind index item count)
  (setq kind (type value))
  (cond
    ((not value) (EL:CompactEmit 0))
    ((equal value T) (EL:CompactEmit 1))
    ((equal kind 'INT) (EL:CompactEmit 2) (EL:CompactEmit value))
    ((equal kind 'REAL) (EL:CompactEmit value))
    ((member kind '(STR SYM)) (EL:CompactEmit (- -1 (EL:CompactAtom value))))
    ((and *EL:CompactTemplates* (listp value) (member (car value) '(template fixed-template))
        (setq index (EL:CompactIndex (cdr value) *EL:CompactTemplates*)))
      ;; An alist entry with a list value is a proper list in AutoLISP.
      ;; Encode its CDR as a template reference, rather than visiting every
      ;; element of the copy as if it were an independent payload list.
      (EL:CompactEmit 3) (EL:CompactEncode (car value))
      (EL:CompactEmit 4) (EL:CompactEmit index))
    ((listp value)
      (setq index (if *EL:CompactTemplates* (EL:CompactIndex value *EL:CompactTemplates*)))
      (cond
        (index (EL:CompactEmit 4) (EL:CompactEmit index))
        ((setq count (vl-list-length value))
          (EL:CompactEmit (+ 8 count))
          (foreach item value (EL:CompactEncode item)))
        (T (EL:CompactEmit 3) (EL:CompactEncode (car value)) (EL:CompactEncode (cdr value)))))
    (T (EL:CompactRequire nil 'unsupported-value))))
(defun EL:StoreCompact (store / *EL:CompactTemplates* *EL:CompactAtoms* *EL:CompactBuckets*
    *EL:CompactAtomCount* *EL:CompactTokens*)
  (setq *EL:CompactTemplates* (EL:CompactTemplates store) *EL:CompactAtomCount* 0)
  (EL:CompactEncode store)
  (list '(format-version . 2) '(codec . EL_COMPACT_V1)
    (cons 'templates *EL:CompactTemplates*) (cons 'atoms (reverse *EL:CompactAtoms*))
    (cons 'body (reverse *EL:CompactTokens*))))
(defun EL:CompactTake (/ value)
  (if (not *EL:CompactRemaining*) (EL:CompactRequire nil 'truncated-body))
  (setq value (car *EL:CompactRemaining*) *EL:CompactRemaining* (cdr *EL:CompactRemaining*)
    *EL:CompactRemainingCount* (1- *EL:CompactRemainingCount*)) value)
;; Date: 2026-10-13. Pack only integer tape tokens. REALs remain native DXF doubles.
(defun EL:CompactIntegerRun (text run)
  ;; Native strings cost two delimiters plus their 32-character DXF pieces.
  (if (> (length run) (+ 2 (fix (/ (+ (strlen text) 31) 32)))) (list text) (reverse run)))
(defun EL:CompactPackIntegers (body / chunks text token item run)
  (setq text "")
  (foreach item body
    (cond
      ((equal (type item) 'INT)
        (setq token (itoa item))
        (if (> (+ (strlen text) (strlen token) 1) 224)
          (progn (foreach token (EL:CompactIntegerRun text run) (setq chunks (cons token chunks)))
            (setq text "" run nil token (itoa item))))
        (setq text (strcat text token " ") run (cons item run)))
      ((equal (type item) 'REAL)
        (if run (progn (foreach token (EL:CompactIntegerRun text run) (setq chunks (cons token chunks)))
          (setq text "" run nil)))
        (setq chunks (cons item chunks)))
      (T (EL:CompactRequire nil 'invalid-tape-token))))
  (if run (foreach token (EL:CompactIntegerRun text run) (setq chunks (cons token chunks)))) (reverse chunks))
(defun EL:CompactReadIntegerChunk (chunk / size wrapped values)
  ;; Date: 2026-10-14. READ sees only a bounded integer alphabet, enclosed
  ;; in our own parentheses. Source strings and native REAL fields never
  ;; use this path; a malformed numeric token cannot be evaluated.
  ;; Full canonical text and INT/range checks reject partial/ambiguous input.
  (setq size (strlen chunk))
