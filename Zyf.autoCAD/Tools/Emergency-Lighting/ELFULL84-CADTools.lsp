      (<= (abs (- sx sy)) (* 1.0e-10 (min sx sy)))
      (<= (abs (EL:Dot x y)) (* 1.0e-10 sx sy)))
    (progn
      (setq sign (if (< (EL:Cross x y) 0.0) -1.0 1.0)
        start (if (equal (cdr (assoc 0 data)) "CIRCLE") 0.0 (cdr (assoc 50 data)))
        sweep (if (equal (cdr (assoc 0 data)) "CIRCLE") (* 2.0 pi)
          (rem (+ (* 2.0 pi) (- (cdr (assoc 51 data)) start)) (* 2.0 pi))))
      (if (> (cdr (assoc 40 data)) 0.0)
        (list center (* sx (cdr (assoc 40 data))) (+ (atan (cadr x) (car x)) (* sign start))
          (* sign sweep) (equal (strcase (cond ((cdr (assoc 8 data))) (T "0"))) "EL_HOLE"))))))
(defun EL:ShapeGeometry (shape)
