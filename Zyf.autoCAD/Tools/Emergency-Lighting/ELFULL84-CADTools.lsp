(defun EL:CCKK2CreateDiagram (result template capacity plan record store / saved item outcome *EL:CCKK2Created*)
  ;; Restore command settings on success, native Esc, and all build failures.
  ;; The enclosing managed transaction rolls back objects and the DWG record.
  (foreach item '("CMDECHO" "ATTREQ" "DRAGMODE" "CLAYER")
    (setq saved (cons (cons item (getvar item)) saved)))
  (setq outcome (EL:MeasuredCatch 'EL:LogCall
    (list "CCKK2_CREATE" nil 'EL:CCKK2CreateConfigured
      (list result template capacity plan record store))))
  (foreach item saved (setvar (car item) (cdr item)))
  (if (vl-catch-all-error-p outcome)
    (progn
      (EL:LogEvent "CCKK2_INSERT_ERROR" (list (cons 'message (vl-catch-all-error-message outcome))))
      (princ (strcat "\nCCKK2 插入停止：" (vl-catch-all-error-message outcome))) (exit)))
  (EL:Require (and (listp outcome) (EL:Get 'panel-output-handle outcome))
    "GENERATION_EMPTY_RESULT：生成未返回完整记录，已停止并回滚；请查看 CCKK2_CREATE 阶段。") outcome)
(defun EL:CCKK2CreateConfigured (result template capacity plan record store)
  (EL:Require (EL:CCKKLayer (EL:Get 'layer template)) "CCKK2 输出图层不可用。")
  (setvar "CMDECHO" 0) (setvar "ATTREQ" 0) (setvar "DRAGMODE" 2)
  (setvar "CLAYER" (EL:Get 'layer template))
  (EL:CCKK2CreateBody result template capacity plan record store))
(defun EL:CreatePowerAnnotation (space row plan layer block / entity object data)
  ;; Date: 2026-10-10. Fixed CCKK power uses the same native TEXT constructor
  ;; as the original plugin, without the separate ActiveX formatting chain.
  (if (not (EL:Get 'cckk-layout plan))
    (EL:CreateAnnotation space row plan layer)
    (progn
      (EL:Require (and block (EL:Get 'text row) (tblsearch "STYLE" "_TEL_DIM")
        (EL:CCKKLayer "TEL_TEXT")) "功率文字缺少回路图块、样式或可用图层。")
      (EL:PerfCount "text-create-attempts" 1)
      (setq entity (EL:LogCall "CCKK_POWER_TEXT" (list (cons 'uid (EL:Get 'circuit-uid row))
          (cons 'text (EL:Get 'text row)) (cons 'block (cdr (assoc 5 (entget block)))))
        'EL:PerfWrite (list 'EL:CCKKText (list block (EL:Get 'text row) 10983.0 -450.0 "TEL_TEXT" "_TEL_DIM" 256))))
      (EL:Require entity "CCKK 功率文字创建失败。")
      (setq object (vlax-ename->vla-object entity) *EL:Created* (cons object *EL:Created*))
      (if (not (equal (EL:Get 'scale plan) 1.0 1.0e-8))
        (progn (setq data (entget entity))
          (EL:Require (EL:PerfWrite 'entmod (list (subst (cons 40 (* 350.0 (EL:Get 'scale plan))) (assoc 40 data) data)))
            "功率文字缩放失败。")))
      (setq data (entget entity))
      (EL:Require (and (equal (cdr (assoc 0 data)) "TEXT")
        (equal (cdr (assoc 1 data)) (EL:Get 'text row))
        (equal (cdr (assoc 8 data)) "TEL_TEXT") (equal (cdr (assoc 7 data)) "_TEL_DIM")
        (equal (cdr (assoc 40 data)) (* 350.0 (EL:Get 'scale plan)) 1.0e-6)
        (equal (cdr (assoc 41 data)) 0.7 1.0e-8) (equal (cdr (assoc 72 data)) 1)
        (equal (cdr (assoc 73 data)) 0) (equal (EL:TextPoint entity) (EL:CCKKPoint block 10983.0 -450.0) 1.0e-6))
        "CCKK 功率文字回读不符，停止生成。") object)))
(defun EL:CreateDiagram (result template capacity plan record store / doc space layer object handles)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) space (vla-get-ModelSpace doc) layer (EL:Get 'layer template))
  (if (not (tblsearch "LAYER" layer)) (vla-Add (vla-get-Layers doc) layer))
  (setq object (if *EL:CCKK2Panel* *EL:CCKK2Panel*
    (EL:CreateBlock space (EL:Get 'panel-name plan) (EL:Get 'position plan)
      (EL:Get 'scale plan) (EL:Get 'rotation plan) (EL:Get 'property (EL:Get 'panel template)) (EL:Get 'panel-value plan) layer)))
  ;; Date: 2026-10-15. The output handle gives every placement an identity
  ;; without rewriting the saved input record or reusing a previous output id.
  (if *EL:PlacementOnly*
    (setq record (EL:Put 'diagram-id (strcat (EL:Get 'diagram-id record)
      "/output/" (cdr (assoc 5 (entget (vlax-vla-object->ename object))))) record)))
  (setq record (EL:Put 'panel-output-handle (EL:TagEntity object store record "panel" "panel") record))
  (if *EL:CCKK2Panel*
    (progn
      ;; Date: 2026-10-14. Native placement can run callbacks. Check the
      ;; template and number now; the full contact/source check runs before
      ;; the verified DWG write without forcing a whole-drawing regeneration.
      (EL:FreshBoundary)
      (EL:Require (EL:PerfCall "PLACEMENT_TEMPLATE_VERIFY" 'EL:TemplateRuntimeValid
          (list template (EL:Get 'config record)))
        "TEMPLATE_CHANGED：放置期间模板变化，已停止生成。")
      (EL:Require (EL:GenerationVerify 'EL:PerfCall (list "PLACEMENT_NUMBER_VERIFY" 'EL:NumberInputsCurrent (list result))
          result 'SOURCE_NUMBER_CHANGED "放置期间平面编号变化，保留本次编号证据")
        "SOURCE_NUMBER_CHANGED：放置期间平面编号变化，已停止生成。")
      (if *EL:PlacementOnly*
        (progn
          (EL:Require (EL:GenerationVerify 'EL:PerfCall (list "PLACEMENT_LIBRARY_VERIFY" 'EL:DLSubmissionCurrent (list result))
              result 'DEVICE_LIBRARY_CHANGED "放置期间设备库变化，保留当前功率")
            "设备库在放置期间变化，请核对后重试。")
          (EL:Require (EL:GenerationVerify 'EL:PerfCall (list "PLACEMENT_SOURCE_VERIFY" 'EL:FreshResult
              (list result (EL:Get 'config record))) result 'SOURCE_CHANGED "放置期间源图变化，按本次显示快照生成")
            "SOURCE_CHANGED：放置期间源图变化，已停止生成。")))))
  (setq handles (EL:PerfCall "CREATE_CIRCUITS" 'EL:CreateDiagramRows
    (list space layer result template plan record store)))
  (setq record (EL:Put 'rows (EL:RecordRows result plan handles) (EL:Put 'plan plan record)))
  (setq record (EL:PerfCall "CREATE_CAPTIONS" 'EL:CreateCCKKLabels (list plan record store)))
  (EL:PerfMark "graphics-complete")
  (EL:PerfCall "DIAGRAM_FINALIZE" 'EL:FinalizeCreatedDiagram (list result record store)))
(defun EL:CreateDiagramRows (space layer result template plan record store / object handles row h)
  ;; Date: 2026-10-21. Batch timing retains row order and native per-row checks.
  (foreach row (EL:Get 'rows plan)
    (EL:LogEvent "CCKK_ROW_BEGIN" (list (cons 'uid (EL:Get 'circuit-uid row))
      (cons 'mode (EL:Get 'mode row)) (cons 'watts (EL:Get 'watts row)) (cons 'position (EL:Get 'position row))))
    (setq object (if *EL:CCKK2Panel*
      (EL:CCKK2ManagedBlock (EL:Get 'name (EL:Get 'circuit template)) (EL:Get 'position row)
        (EL:Get 'circuit template) (EL:Get 'value row))
      (EL:CreateBlock space (EL:Get 'name (EL:Get 'circuit template)) (EL:Get 'position row)
        (EL:Get 'scale plan) (EL:Get 'rotation plan) (EL:Get 'property (EL:Get 'circuit template)) (EL:Get 'value row) layer))
      h (list (cons 'circuit-uid (EL:Get 'circuit-uid row))
        (cons 'block-handle (EL:TagEntity object store record "circuit" (EL:Get 'circuit-uid row)))))
    (if (EL:Get 'text row)
      (setq h (EL:Put 'text-handle (EL:TagEntity (EL:PerfCall "CREATE_POWER_TEXT" 'EL:CreatePowerAnnotation
          (list space row plan layer (vlax-vla-object->ename object)))
        store record "text" (EL:Get 'circuit-uid row)) h)))
    (setq handles (cons h handles))
    (EL:LogEvent "CCKK_ROW_CREATED" h)) handles)
(defun EL:FinalizeCreatedDiagram (result record store)
  (setq record (EL:GenerationReviewRecord record result))
  (if (not *EL:PlacementOnly*)
    (progn
      ;; Legacy callers retain their persistent output record. The current
      ;; panel finishes after creation and the enclosing undo group closes.
      (if *EL:NativePreview*
        (EL:Require (EL:GenerationVerify 'EL:FreshResult (list result (EL:Get 'config record)) result
            'SOURCE_CHANGED "预览后源图变化，按本次快照生成") "SOURCE_CHANGED：预览后源图变化。"))
      (EL:Require (EL:GenerationVerify 'EL:NumberInputsCurrent (list result) result
          'SOURCE_NUMBER_CHANGED "生成期间平面编号变化，保留本次编号证据") "SOURCE_NUMBER_CHANGED：生成期间平面编号变化，已停止本次生成。")
      (setq record (EL:GenerationReviewRecord record result))
      (EL:Require (equal T (EL:LogCall "SAVE_CREATED_DIAGRAM" nil 'EL:StoreWrite
        (list (EL:StorePutDiagram record store))))
        "系统图记录保存失败，已停止生成并回滚。"))) record)

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "store-split.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-13. Immutable DWG chunks, one authoritative root switch.
(defun EL:SplitPairsWithout (keys data)
  (vl-remove-if '(lambda (pair) (member (car pair) keys)) data))
(defun EL:SplitEnvelope (kind value)
  (list '(schema-version . 1) '(drawing-uuid . "EL_SPLIT_CHUNK") '(diagrams)
    (cons 'chunk-kind kind) (cons 'chunk-value value)))
(defun EL:SplitAudit (key entry / native payload nativepayload)
  (EL:Require (and entry (equal (cdr (assoc 0 entry)) "XRECORD")
    (setq native (entget (cdr (assoc -1 entry))))
    (equal (cdr (assoc 0 native)) "XRECORD")) "拆分记录对象缺失，未继续读写。")
  ;; Date: 2026-10-13. Keep both complete native views, extract each only once.
  (setq payload (EL:StorePayload entry) nativepayload (EL:StorePayload native))
  (EL:StoreCheck payload nativepayload 'split-native)
  (list (cons 'key key) (cons 'entity (cdr (assoc -1 entry)))
    (cons 'payload payload)))
(defun EL:SplitChunkValid (context / entry native)
  (and (setq entry (dictsearch (namedobjdict) (EL:Get 'key context)))
    (equal (cdr (assoc -1 entry)) (EL:Get 'entity context))
    (equal (cdr (assoc 0 entry)) "XRECORD")
    (equal (EL:StorePayload entry) (EL:Get 'payload context))
    (setq native (entget (EL:Get 'entity context)))
    (equal (cdr (assoc 0 native)) "XRECORD")
    (equal (EL:StorePayload native) (EL:Get 'payload context))))
(defun EL:SplitVerifiedPayload (context kind / verified)
  ;; Date: 2026-10-13. Retain raw decode proof for one drawing, not source
  ;; freshness or a command context. Changed bytes must be decoded again.
  (setq verified (EL:Get (EL:Get 'key context) *EL:SplitVerifiedPayloads*))
  (and (equal *EL:SplitVerifiedOwner* (namedobjdict))
    (equal kind (EL:Get 'kind verified))
    (equal (EL:Get 'entity context) (EL:Get 'entity verified))
    (equal (EL:Get 'payload context) (EL:Get 'payload verified))))
(defun EL:SplitRememberVerified (context)
  (if (not (equal *EL:SplitVerifiedOwner* (namedobjdict)))
    (setq *EL:SplitVerifiedPayloads* nil *EL:SplitVerifiedOwner* (namedobjdict)))
  (setq *EL:SplitVerifiedPayloads* (EL:Put (EL:Get 'key context)
    (EL:SplitPairsWithout '(value) context) *EL:SplitVerifiedPayloads*)) nil)
(defun EL:SplitReadChunk (key kind / entry context cached envelope value)
  (setq entry (dictsearch (namedobjdict) key) context (EL:SplitAudit key entry)
    cached (EL:Get key *EL:SplitCache*))
  (if (and (equal *EL:SplitCacheOwner* (namedobjdict))
      (equal *EL:SplitCacheScope* *EL:StoreReadScope*)
      (equal (EL:Get 'entity context) (EL:Get 'entity cached))
      (equal (EL:Get 'payload context) (EL:Get 'payload cached))
      (equal kind (EL:Get 'kind cached)))
    (progn (setq value (EL:Get 'value cached)) (EL:PerfCount "split-decode-reuses" 1))
    (progn
      (setq envelope (EL:PerfCall "STORE_DECODE" 'EL:StoreDecode (list (EL:Get 'payload context))))
      (EL:Require (and (EL:StoreSchemaValid envelope)
        (equal (EL:Get 'drawing-uuid envelope) "EL_SPLIT_CHUNK")
        (equal kind (EL:Get 'chunk-kind envelope))) "拆分记录类型或版本不符，未继续。")
      (setq value (EL:Get 'chunk-value envelope))
      (EL:PerfCount "split-chunks-decoded" 1)))
  (EL:Require (EL:SplitChunkValid context) "拆分记录在解码期间变化，未使用。")
  (setq context (EL:Put 'kind kind (EL:Put 'value value context))
    *EL:SplitReadContexts* (EL:Put key context *EL:SplitReadContexts*)
    *EL:SplitCache* (EL:Put key context *EL:SplitCache*)
    *EL:SplitCacheOwner* (namedobjdict) *EL:SplitCacheScope* *EL:StoreReadScope*)
  (EL:SplitRememberVerified context) value)
(defun EL:SplitRoot (/ root)
  (if (dictsearch (namedobjdict) "EL_FIXED_SPLIT_V1")
    (progn
      (setq root (EL:SplitReadChunk "EL_FIXED_SPLIT_V1" 'root))
      (EL:Require (and (equal (EL:Get 'layout-version root) 1)
        (equal (type (EL:Get 'drawing-uuid root)) 'STR)
        (equal (type (EL:Get 'generation root)) 'INT)
        (listp (EL:Get 'items root))) "拆分根记录版本或字段无效，未继续。") root)))
(defun EL:SplitSummary (record / rows pair)
  (foreach pair record
    (if (member (car pair) '(diagram-id source-panel-handle panel-number engine status panel-output-handle power-only-target))
      (setq rows (cons pair rows))))
  (append (reverse rows) (list (cons 'history-circuit-count
    (length (cond ((EL:Get 'draft-circuits record)) (T (EL:ActualRows record))))))))
(defun EL:SplitRestoreRecord (item / detail pair key rows)
  (setq detail (EL:SplitReadChunk (EL:Get 'detail item) 'detail))
  (foreach key (EL:Get 'keys detail)
    (setq pair (assoc key (EL:Get 'small detail)))
    (if (not pair)
      (setq pair (cons key (EL:SplitReadChunk (EL:Get key (EL:Get 'blobs detail)) 'blob))))
    (setq rows (cons pair rows)))
  (setq rows (reverse rows))
  (EL:StoreCheck (EL:Get 'summary item) (EL:SplitSummary rows) 'split-index-record) rows)
(defun EL:SplitMaterialize (root / metadata rows key value)
  (setq metadata (EL:SplitReadChunk (EL:Get 'metadata root) 'metadata))
  (foreach value (EL:Get 'items root)
    (setq rows (cons (EL:SplitRestoreRecord value) rows)))
  (setq value nil)
  (foreach key (EL:Get 'keys root)
    (setq value (cons (if (equal key 'diagrams) (cons key (reverse rows))
      (assoc key metadata)) value)))
  (setq value (reverse value))
  (EL:Require (EL:StoreSchemaValid value) "拆分记录逻辑字段无效。")
  (EL:StoreCheck (EL:Get 'drawing-uuid root) (EL:Get 'drawing-uuid value) 'split-owner) value)
(defun EL:SplitRead (/ root *EL:SplitReadContexts*)
  (if (setq root (EL:SplitRoot)) (EL:SplitMaterialize root) (EL:StoreReadMonolithic)))
(defun EL:StoreIndex (/ root *EL:SplitReadContexts*)
  ;; A list read touches only the small root, no geometry/template chunks.
  (if (setq root (EL:SplitRoot))
    (list '(schema-version . 1) (cons 'drawing-uuid (EL:Get 'drawing-uuid root))
      (cons 'diagrams (mapcar '(lambda (item) (EL:Get 'summary item)) (EL:Get 'items root))))
    (EL:StoreReadMonolithic)))
(defun EL:StoreRecord (id / root item *EL:SplitReadContexts*)
  (if (setq root (EL:SplitRoot))
    (progn
      (setq item (vl-some '(lambda (row) (if (equal id (EL:Get 'diagram-id (EL:Get 'summary row))) row))
        (EL:Get 'items root)))
      (if item (EL:SplitRestoreRecord item)))
    (EL:By 'diagram-id id (EL:Get 'diagrams (EL:StoreReadMonolithic)))))
(defun EL:SplitViewP (store)
  (equal (EL:Get 'tag (EL:Get 'split-view store)) 'EL_INTERNAL_VIEW_V1))
(defun EL:SplitMetadata (store)
  (EL:SplitPairsWithout (if (EL:SplitViewP store) '(diagrams split-view) '(diagrams)) store))
(defun EL:SplitViewFromRoot (root result / metadata rows item summary selected selected-id lazy-ids value key)
  ;; Date: 2026-10-14. Hydrate only the selected history entry or the newest
  ;; entry for this box. Older outputs retain their exact immutable references.
  (setq metadata (EL:SplitReadChunk (EL:Get 'metadata root) 'metadata))
  (if (assoc 'split-view metadata) (EL:SplitMaterialize root) (progn
  (setq selected-id (EL:Get 'update-diagram-id result))
  (if (not selected-id)
    (foreach item (EL:Get 'items root)
      (setq summary (EL:Get 'summary item))
      (if (equal (EL:Get 'source-panel-handle summary) (EL:Get 'panel result))
        (setq selected-id (EL:Get 'diagram-id summary)))))
  (foreach item (EL:Get 'items root)
    (setq summary (EL:Get 'summary item)
      selected (and selected-id (equal (EL:Get 'diagram-id summary) selected-id)))
    (if (not selected) (setq lazy-ids (cons (EL:Get 'diagram-id summary) lazy-ids)))
    (setq rows (cons (if selected (EL:SplitRestoreRecord item)
      (EL:Put 'split-reference item summary)) rows)))
  (foreach key (EL:Get 'keys root)
    (setq value (cons (if (equal key 'diagrams) (cons key (reverse rows)) (assoc key metadata)) value)))
  (EL:Put 'split-view (list '(tag . EL_INTERNAL_VIEW_V1) (cons 'lazy-ids lazy-ids)
      (cons 'owner (namedobjdict)) (cons 'root root))
    (reverse value)))))
(defun EL:StoreForResult (result / root *EL:SplitReadContexts*)
  (if (setq root (EL:SplitRoot))
    (EL:PerfCall "STORE_CURRENT_BOX" 'EL:SplitViewFromRoot (list root result))
    (EL:StoreReadMonolithic)))
(defun EL:SplitAuditReachable (root / item detail key context cached)
  ;; Immutable references belonging to other boxes are retained byte-for-byte.
  ;; Audit both native routes without decoding their large geometry blobs.
  (foreach item (EL:Get 'items root)
    (setq detail (EL:SplitReadChunk (EL:Get 'detail item) 'detail))
    (foreach key (EL:Get 'blobs detail)
      (setq context (EL:SplitAudit (cdr key) (dictsearch (namedobjdict) (cdr key))))
      (if (not (EL:SplitVerifiedPayload context 'blob))
        (progn
          (EL:SplitReadChunk (cdr key) 'blob)
          (setq context (EL:Get (cdr key) *EL:SplitReadContexts*))))
      (setq context (EL:Put 'kind 'blob context))
      (setq cached (EL:Get (cdr key) *EL:SplitCache*))
      (if (and (equal *EL:SplitCacheOwner* (namedobjdict))
          (equal *EL:SplitCacheScope* *EL:StoreReadScope*)
          (equal (EL:Get 'entity context) (EL:Get 'entity cached))
          (equal (EL:Get 'payload context) (EL:Get 'payload cached)))
        (setq context cached))
      (setq *EL:SplitReadContexts* (EL:Put (cdr key) context *EL:SplitReadContexts*)))) T)
(defun EL:SplitCheckView (root store / item record reference metadata)
  (setq metadata (EL:SplitReadChunk (EL:Get 'metadata root) 'metadata))
  (EL:StoreCheck (EL:SplitMetadata store) metadata 'split-view-metadata)
  (EL:StoreCheck (length (EL:Get 'diagrams store)) (length (EL:Get 'items root)) 'split-view-count)
  (foreach record (EL:Get 'diagrams store)
    (setq item (vl-some '(lambda (row)
      (if (equal (EL:Get 'diagram-id (EL:Get 'summary row)) (EL:Get 'diagram-id record)) row)) (EL:Get 'items root))
      reference (if (member (EL:Get 'diagram-id record) (EL:Get 'lazy-ids (EL:Get 'split-view store)))
        (EL:Get 'split-reference record)))
    (EL:Require item "当前箱体视图与根索引不符。")
    (if reference
      (EL:StoreCheck record (EL:Put 'split-reference item (EL:Get 'summary item)) 'split-view-reference)
      (EL:StoreCheck record (EL:SplitRestoreRecord item) 'split-view-record))) T)
(defun EL:SplitNewChunk (key kind value / chunks decoded entity entry context)
  (setq chunks (EL:LogCall "STORE_SERIALIZE" (list (cons 'kind kind)) 'EL:StoreEncode
    (list (EL:SplitEnvelope kind value)))
    decoded (EL:LogCall "STORE_PARSE" nil 'EL:StoreDecode (list chunks)))
  (EL:StoreCheck (EL:SplitEnvelope kind value) decoded 'split-pre-write)
  (EL:Require (not (dictsearch (namedobjdict) key)) "拆分记录键已存在，未覆盖。")
  (setq entity (EL:StoreCreatePayload chunks 1))
  (EL:Require (and entity (dictadd (namedobjdict) key entity)) "拆分记录写入失败。")
  (setq entry (dictsearch (namedobjdict) key) context (EL:SplitAudit key entry))
  (EL:StoreCheck entity (EL:Get 'entity context) 'split-association)
  (EL:StoreCheck chunks (EL:Get 'payload context) 'split-readback)
  (setq context (EL:Put 'kind kind (EL:Put 'value value context))
    *EL:SplitReadContexts* (EL:Put key context *EL:SplitReadContexts*)
    *EL:SplitPool* (cons context *EL:SplitPool*)
    *EL:SplitCache* (EL:Put key context *EL:SplitCache*)
    *EL:SplitCacheOwner* (namedobjdict) *EL:SplitCacheScope* *EL:StoreReadScope*)
  ;; Pre-write decode and both complete native readbacks already passed.
  ;; The regular cache rechecks raw data before reusing this decoded value.
  (EL:SplitRememberVerified context)
  (EL:PerfCount "split-preverified-chunks" 1)
  (EL:PerfCount "split-chunks-written" 1) key)
(defun EL:SplitPut (kind value / found key)
  ;; Exact equality after native verification; no truncated signatures/hashes.
  (setq found (vl-some '(lambda (context)
    (if (and (assoc 'value context) (equal kind (EL:Get 'kind context))
      (equal value (EL:Get 'value context))) context)) *EL:SplitPool*))
  (if found (progn (EL:PerfCount "split-chunks-reused" 1) (EL:Get 'key found))
    (progn
      (setq key nil)
      (while (or (not key) (dictsearch (namedobjdict) key))
        (setq *EL:SplitSequence* (1+ *EL:SplitSequence*) key
          (strcat "EL_SPLIT_" (itoa *EL:SplitGeneration*) "_" (itoa *EL:SplitSequence*))))
      (EL:SplitNewChunk key kind value))))
(defun EL:SplitRecordParts (record / blobs pair detail)
  (foreach pair record
    (if (member (car pair) '(source-signature draft-source-signature template config))
      (setq blobs (cons (cons (car pair) (EL:SplitPut 'blob (cdr pair))) blobs))))
  (setq detail (list (cons 'keys (mapcar 'car record))
    (cons 'small (EL:SplitPairsWithout '(source-signature draft-source-signature template config) record))
    (cons 'blobs (reverse blobs))))
  (list (cons 'summary (EL:SplitSummary record)) (cons 'detail (EL:SplitPut 'detail detail))))
(defun EL:SplitBuild (store / items record reference)
  (foreach record (EL:Get 'diagrams store)
    (setq reference (if (and (EL:SplitViewP store)
      (member (EL:Get 'diagram-id record) (EL:Get 'lazy-ids (EL:Get 'split-view store))))
      (EL:Get 'split-reference record)))
    (if reference
      (progn
        (EL:Require (member reference (EL:Get 'items *EL:SplitViewRoot*)) "保存视图引用已变化。")
        (EL:StoreCheck record (EL:Put 'split-reference reference (EL:Get 'summary reference)) 'split-view-build)
        (setq items (cons reference items)) (EL:PerfCount "split-boxes-retained" 1))
      (setq items (cons (EL:SplitRecordParts record) items))))
  (list '(layout-version . 1) (cons 'drawing-uuid (EL:Get 'drawing-uuid store))
    (cons 'generation *EL:SplitGeneration*) (cons 'keys (mapcar 'car (if (EL:SplitViewP store) (EL:SplitPairsWithout '(split-view) store) store)))
    (cons 'metadata (EL:SplitPut 'metadata (EL:SplitMetadata store)))
    (cons 'items (reverse items))))
(defun EL:SplitBackup (entry / key old backup entity context suffix)
  (setq key "EL_FIXED_MONOLITH_BACKUP" old (EL:SplitAudit "EL_FIXED_V1" entry) suffix 0)
  (setq *EL:SplitReadContexts* (EL:Put "EL_FIXED_V1" old *EL:SplitReadContexts*))
  ;; A later explicit downgrade/remigration keeps every earlier raw backup.
  (while (and (setq backup (dictsearch (namedobjdict) key))
      (not (equal (EL:Get 'payload old) (EL:Get 'payload (EL:SplitAudit key backup)))))
    (setq suffix (1+ suffix) key (strcat "EL_FIXED_MONOLITH_BACKUP_" (itoa suffix))))
  (if (not backup)
    (progn
      (setq entity (EL:StoreCreatePayload (EL:Get 'payload old) 1))
      (EL:Require (and entity (dictadd (namedobjdict) key entity)) "旧保存记录原始备份失败。")
      (setq context (EL:SplitAudit key (dictsearch (namedobjdict) key)))
      (EL:StoreCheck entity (EL:Get 'entity context) 'split-backup-association)
      (EL:StoreCheck (EL:Get 'payload old) (EL:Get 'payload context) 'split-backup-raw))) T)
(defun EL:SplitContextValid (context)
  (and (equal (EL:Get 'owner context) (namedobjdict))
    (EL:Get 'verified-store context)
    (vl-every '(lambda (row) (EL:SplitChunkValid (cdr row))) (EL:Get 'split-contexts context))))
(defun EL:SplitWrite (store / root old entry staged chunks entity context value ids id record row baseline-contexts
    *EL:SplitReadContexts* *EL:SplitPool* *EL:SplitGeneration* *EL:SplitSequence* *EL:SplitViewRoot*)
  (EL:Require *EL:TransactionOpen* "拆分存储必须在完整事务中执行。")
  (EL:Require (EL:StoreSchemaValid store) "待保存记录字段无效，未写入。")
  (EL:CompactTemplates store)
  (EL:FreshBoundary)
  (setq *EL:SplitSequence* 0 *EL:StoreContextCandidate* nil *EL:StoreContextCommitted* nil)
  (foreach record (EL:Get 'diagrams store)
    (setq id (EL:Get 'diagram-id record))
    (EL:Require (and id (not (member id ids))) "保存记录身份缺失或重复，未写入。")
    (setq ids (cons id ids)))
  (setq root (EL:SplitRoot) *EL:SplitViewRoot* root
    *EL:SplitGeneration* (if root (1+ (EL:Get 'generation root)) 1))
  (if (EL:SplitViewP store)
    (EL:Require (and root (equal (EL:Get 'owner (EL:Get 'split-view store)) (namedobjdict))
      (equal root (EL:Get 'root (EL:Get 'split-view store)))) "保存列表已变化，请重新打开当前箱体。"))
  (if root (EL:StoreCheck (EL:Get 'drawing-uuid root) (EL:Get 'drawing-uuid store) 'split-drawing-owner))
  (if root
    (progn
      (if (EL:SplitViewP store)
        (progn (EL:SplitReadChunk (EL:Get 'metadata root) 'metadata) (EL:SplitAuditReachable root))
        (setq old (EL:SplitMaterialize root)))
      (foreach row *EL:SplitReadContexts* (setq *EL:SplitPool* (cons (cdr row) *EL:SplitPool*))))
    (if (setq entry (dictsearch (namedobjdict) "EL_FIXED_V1"))
      (progn
        (setq old (EL:StoreReadMonolithic))
        ;; Date: 2026-10-14. The exact raw backup keeps every old record.
        ;; Validate old template copies, then stage only the final store once.
        ;; Old/new native payloads are still checked before root publication.
        (EL:CompactTemplates old)
        (EL:LogCall "STORE_MIGRATE_BACKUP" nil 'EL:SplitBackup (list entry)))))
  (setq *EL:StoreReadCache* nil)
  (setq baseline-contexts *EL:SplitReadContexts*)
  (if old (EL:StoreCheck (EL:Get 'drawing-uuid old) (EL:Get 'drawing-uuid store) 'split-drawing-owner))
  (if (and root (equal old store))
    (progn (EL:PerfCount "split-noop-writes" 1) (setq value old))
    (progn
      (setq staged (EL:LogCall "STORE_STAGE_BUILD" nil 'EL:SplitBuild (list store)) *EL:SplitReadContexts* nil)
      (if (EL:SplitViewP store) (EL:SplitCheckView staged store)
        (EL:StoreCheck store (EL:SplitMaterialize staged) 'split-staged-logical))
      (if (and root (equal (EL:SplitPairsWithout '(generation) root)
          (EL:SplitPairsWithout '(generation) staged)))
        (progn (EL:PerfCount "split-noop-writes" 1)
          (setq *EL:SplitReadContexts* baseline-contexts value store))
        (progn
      (setq chunks (EL:StoreEncode (EL:SplitEnvelope 'root staged)))
      (EL:StoreCheck (EL:SplitEnvelope 'root staged) (EL:StoreDecode chunks) 'split-root-pre-write)
      (EL:Require (and (vl-every '(lambda (row) (EL:SplitChunkValid (cdr row))) baseline-contexts)
        (vl-every '(lambda (row) (EL:SplitChunkValid (cdr row))) *EL:SplitReadContexts*))
        "记录在准备期间变化，未发布拆分根。")
      ;; Root remains old until all reachable chunks have passed both native routes.
      (setq entry (dictsearch (namedobjdict) "EL_FIXED_SPLIT_V1") entity (cdr (assoc -1 entry)))
      (EL:PerfCount "master-write-attempts" 1)
      (EL:PerfCount "split-root-publications" 1)
      (if entity (EL:LogCall "STORE_REPLACE_PAYLOAD" nil 'EL:StoreReplacePayload (list entity chunks))
        (progn
          (setq entity (EL:StoreCreatePayload chunks 1))
          (EL:Require (and entity (dictadd (namedobjdict) "EL_FIXED_SPLIT_V1" entity)) "拆分根记录发布失败。")))
      (setq context (EL:SplitAudit "EL_FIXED_SPLIT_V1" (dictsearch (namedobjdict) "EL_FIXED_SPLIT_V1")))
      (EL:StoreCheck entity (EL:Get 'entity context) 'split-root-association)
      (EL:StoreCheck chunks (EL:Get 'payload context) 'split-root-readback)
      (setq *EL:SplitReadContexts* (EL:Put "EL_FIXED_SPLIT_V1" context *EL:SplitReadContexts*) value store)))))
  ;; Keep complete native post-commit checks for retained chunks as well.
  ;; The replaced root always uses its new audit, never its baseline payload.
  (if (EL:SplitViewP store)
    (foreach row baseline-contexts
      (if (and (not (equal (car row) "EL_FIXED_SPLIT_V1"))
          (not (assoc (car row) *EL:SplitReadContexts*)))
        (setq *EL:SplitReadContexts* (EL:Put (car row) (cdr row) *EL:SplitReadContexts*)))))
  (if *EL:StoreContextActive*
    (setq *EL:StoreContextCandidate* (list (cons 'owner (namedobjdict))
      (cons 'verified-store value) (cons 'split-contexts *EL:SplitReadContexts*))))
  (setq *EL:StoreWarmCache* nil)
  ;; Discard proofs for obsolete generations after each successful write.
  (setq *EL:SplitVerifiedPayloads* nil *EL:SplitVerifiedOwner* (namedobjdict))
  (foreach row *EL:SplitReadContexts*
    (if (EL:Get 'kind (cdr row)) (EL:SplitRememberVerified (cdr row))))
  (EL:FreshBoundary) T)
(defun EL:SplitDeactivate (/ entry entity)
  (EL:Require *EL:TransactionOpen* "旧格式转换必须在事务中执行。")
  (if (setq entry (dictsearch (namedobjdict) "EL_FIXED_SPLIT_V1"))
    (progn
      (setq entity (cdr (assoc -1 entry)))
      (EL:Require (dictremove (namedobjdict) "EL_FIXED_SPLIT_V1") "拆分根切换失败。")
      (entdel entity)
      (EL:Require (not (dictsearch (namedobjdict) "EL_FIXED_SPLIT_V1")) "拆分根仍生效，转换未完成。")))
  (setq *EL:SplitCache* nil) T)
(setq *EL:SplitStorageLoaded* T)
(princ)

(EL:PerfEnd *EL:LoadToken* 'returned)
(setq *EL:MonitorLabel* nil)

(setq *EL:MonitorLabel* "diagram-update.lsp" *EL:LoadToken* (EL:PerfBegin "LOAD_MODULE"))
;; Date: 2026-10-14. Source checks and generation without in-place updates.
(defun EL:Require (condition message)
  ;; Date: 2026-10-10. Preserve validation reason before exit becomes a generic abort.
  (if (not condition) (progn (EL:LogEvent "VALIDATION_FAILED" (list (cons 'message message)))
    (princ (strcat "\n" message)) (exit))) T)
(defun EL:ActualRows (record)
  (vl-remove-if '(lambda (r) (equal (EL:Get 'mode r) 'reserve)) (EL:Get 'rows record)))
(defun EL:TextPoint (e / d)
  (setq d (entget e))
  (if (and (= (cond ((cdr (assoc 72 d))) (T 0)) 0) (= (cond ((cdr (assoc 73 d))) (T 0)) 0))
    (cdr (assoc 10 d)) (cdr (assoc 11 d))))
(defun EL:DynamicUpdate (e property value / obj before prop)
  (setq obj (vlax-ename->vla-object e) before (cdr (assoc 10 (entget e))) prop (EL:DynamicProperty obj property))
  (EL:Require prop "动态属性不存在。")
  (if (not (equal (vlax-variant-value (vla-get-Value prop)) value))
    (EL:Require (EL:SetDynamicValue obj property value) "动态属性写入或回读失败。"))
  (EL:Require (equal before (cdr (assoc 10 (entget e))) 1.0e-6) "动态状态切换导致基点漂移。"))
;; Date: 2026-10-14. A failed new generation marks only the current draft.
(defun EL:MarkStale (panel reason / store record)
  (if (and panel (setq store (EL:StoreForResult (list (cons 'panel panel)))) (setq record (EL:DiagramForPanel panel store)))
    (progn
      (setq record (EL:Put 'status 'stale (EL:Put 'stale-reason reason record)))
      (EL:Transaction 'EL:StoreWrite (list (EL:StorePutDiagram record store)))
      (princ "\n本次未生成新系统图；已保存的输入仍可重新核对。"))) nil)
(defun EL:NewRecord (panel store / id prefix serial row)
  ;; HANDSEED is not a portable GETVAR string. Allocate within this DWG store.
  (EL:Require (and (equal (type panel) 'STR) (/= panel "")
    (equal (type (EL:Get 'drawing-uuid store)) 'STR) (/= (EL:Get 'drawing-uuid store) ""))
    "无法建立系统图身份：图纸标识或来源箱体句柄为空。")
  (setq prefix (strcat (EL:Get 'drawing-uuid store) "/" panel "/")
    serial (1+ (cond ((EL:Get panel (EL:Get 'diagram-serials store))) (T 0))))
  (foreach row (EL:Get 'diagrams store)
    (setq serial (max serial (1+ (EL:DiagramSerial (EL:Get 'diagram-id row) panel store)))))
  (setq
    id (strcat prefix (itoa serial)))
  (while (EL:By 'diagram-id id (EL:Get 'diagrams store))
    (setq serial (1+ serial) id (strcat prefix (itoa serial))))
  (list (cons 'diagram-id id) (cons 'source-panel-handle panel) '(capacity-option . cap300) '(capacity-source . default)
    '(template-version . 1) '(status . unverified)))
(defun EL:RecognizeFixed (cfg panel / snapshot network result record keys perf
    *EL:RecognitionPass* *EL:RecognitionContacts*
    *EL:StableSnapshotMemo* *EL:StableSnapshotOwner* *EL:StableSnapshotEpoch*)
  (setq *EL:RecognitionPass* T cfg (EL:CurrentJunctionConfig cfg))
  (setq perf (EL:PerfBegin "RECOGNIZE_FIXED_RUN"))
  (EL:PerfCount "recognize-fixed-calls" 1)
  (EL:Require (and (handent panel) (not (EL:ManagedEntity (handent panel)))) "来源配电箱缺失或为受管输出。")
  (setq snapshot (EL:LogCall "SIMPLE_COLLECT" (list (cons 'panel panel)) 'EL:SimpleCollect (list cfg))
    snapshot (cond ((EL:Get 'circuit-starts cfg) (EL:StartSnapshot snapshot cfg panel))
      ((EL:Get 'concentrated-trunk cfg) (EL:TrunkSnapshot snapshot cfg panel)) (T snapshot))
    network (EL:LogCall "SIMPLE_NETWORK" (list (cons 'panel panel) (cons 'wires (length (EL:Get 'wires snapshot)))
      (cons 'blocks (length (EL:Get 'blocks snapshot)))) 'EL:SimpleNetwork (list snapshot cfg panel)))
  (setq result (EL:SelectFixedExits (EL:ClassifyStartLinks (EL:SplitNativeNumberBranches
    (EL:LogCall "SPLIT_NETWORK" (list (cons 'panel panel)) 'EL:SplitNetwork (list network cfg)) network cfg) cfg) nil))
  (if *EL:CollectMemo*
    (setq *EL:CollectMemo* (EL:Put 'input snapshot (EL:Put 'signature
      (EL:Get 'signature (EL:Get 'snapshot result)) *EL:CollectMemo*))))
  (EL:PerfSet "wire-count" (length (EL:Get 'wires snapshot)))
  (EL:PerfSet "block-count" (length (EL:Get 'blocks snapshot)))
  ;; Date: 2026-10-21. Distinguish whole selection candidates from this root walk.
  (EL:PerfSet "recognized-connected-wires" (length (EL:Get 'wire-ids network)))
  (EL:PerfSet "recognized-connected-devices" (length (EL:Get 'devices network)))
  (EL:LogEvent "RECOGNIZED_CONNECTED_SCOPE" (list (cons 'panel panel)
    (cons 'wires (length (EL:Get 'wire-ids network))) (cons 'devices (length (EL:Get 'devices network)))))
  (EL:PerfEnd perf 'returned) result)
(defun EL:FixedFreshSnapshotFull (cfg panel / snapshot network)
  ;; Date: 2026-10-11. Identical collect/network/CircuitSnapshot signature,
  ;; without tracing circuits or selecting exits just to compare the source.
  (EL:Require (and (handent panel) (not (EL:ManagedEntity (handent panel)))) "来源配电箱缺失或为受管输出。")
  (EL:PerfCount "freshness-scan-calls" 1)
  (setq snapshot (EL:LogCall "SIMPLE_COLLECT" nil 'EL:SimpleCollect (list cfg))
    snapshot (cond ((EL:Get 'circuit-starts cfg) (EL:StartSnapshot snapshot cfg panel))
      ((EL:Get 'concentrated-trunk cfg) (EL:TrunkSnapshot snapshot cfg panel)) (T snapshot))
    network (EL:LogCall "SIMPLE_NETWORK" nil 'EL:SimpleNetwork (list snapshot cfg panel)))
  (EL:CircuitSnapshot (EL:Get 'snapshot network) panel))
(defun EL:FixedFreshSnapshot (cfg panel)
  (setq cfg (EL:CurrentJunctionConfig cfg))
  (if *EL:FreshSourceCandidate* (EL:FixedFreshForResult cfg *EL:FreshSourceCandidate*)
    (EL:FixedFreshSnapshotFull cfg panel)))
(defun EL:FixedFreshForResult (cfg result / snapshot network proof epoch panel owner answer native-current
    *EL:DeviceContactCache* *EL:DeviceTemplateCache* *EL:DeviceTemplateEnabled*)
  (setq owner (namedobjdict) panel (EL:Get 'panel result) epoch *EL:FreshEpoch* *EL:DeviceTemplateEnabled* T
    proof (EL:Get 'network-proof (EL:Get 'snapshot result)))
  (EL:Require (and (handent panel) (not (EL:ManagedEntity (handent panel)))) "来源配电箱缺失或为受管输出。")
  (EL:PerfCount "freshness-scan-calls" 1)
  (setq native-current (EL:PerfCall "SOURCE_NATIVE_VERIFY" 'EL:CollectSourceCurrent (list cfg result)))
  (if native-current (setq snapshot native-current)
    (setq snapshot (EL:LogCall "SIMPLE_COLLECT" nil 'EL:SimpleCollect (list cfg))
      snapshot (cond ((EL:Get 'circuit-starts cfg) (EL:StartSnapshot snapshot cfg panel))
        ((EL:Get 'concentrated-trunk cfg) (EL:TrunkSnapshot snapshot cfg panel)) (T snapshot))))
  (setq answer (if (and (not *EL:NetworkReuseDisabled*) (equal (EL:Get 'version proof) 4) (equal panel (EL:Get 'panel proof))
      (equal (EL:StableData (vl-remove-if '(lambda (row) (equal (car row) 'template)) cfg)) (EL:Get 'config proof))
      (not (EL:Get 'issues snapshot))
      (or native-current (equal (EL:StableData snapshot)
        (EL:NetworkProofInput (cadr (EL:Get 'signature (EL:Get 'snapshot result))) proof)))
      (EL:PerfCall "NETWORK_VERIFY_GEOMETRY" 'EL:NetworkGeometryCurrent (list (EL:Get 'contacts proof) snapshot))
      (equal epoch *EL:FreshEpoch*))
    (progn (EL:PerfCount "network-proof-reuses" 1) (EL:Get 'snapshot result))
    (progn
      (EL:PerfCount "network-proof-rebuilds" 1)
      (setq network (EL:LogCall "SIMPLE_NETWORK" nil 'EL:SimpleNetwork (list snapshot cfg panel)))
      (EL:CircuitSnapshot (EL:Get 'snapshot network) panel))))
  (EL:Require (and (equal owner (namedobjdict)) (equal epoch *EL:FreshEpoch*))
    "SOURCE_CHANGED：复核期间发生写入、交互或切图，请重新统计。") answer)
(defun EL:PersistSourceSignature (result cfg / context signature)
  (setq context *EL:FreshProofContext* signature (EL:Get 'signature (EL:Get 'snapshot result)))
  (if (and context (equal (EL:Get 'owner context) (namedobjdict))
      (equal (EL:Get 'epoch context) *EL:FreshEpoch*)
      (equal (EL:Get 'panel context) (EL:Get 'panel result))
      (equal (EL:Get 'config context) cfg) (equal (EL:Get 'original context) signature))
    (EL:Get 'verified context) signature))
(defun EL:FreshResult (result cfg / fresh key good *EL:FreshSourceCandidate*)
  (setq *EL:FreshSourceCandidate* result)
  (if (equal (EL:Get 'engine result) 'fixed) (setq cfg (EL:CurrentJunctionConfig cfg)))
  (setq key (list (EL:Get 'drawing cfg) (getvar "DWGNAME") (getvar "DWGPREFIX")
    (EL:Get 'panel result) (EL:RecognitionRules cfg)
    (EL:Get 'signature (EL:Get 'snapshot result)) *EL:FreshEpoch*))
  (if (and *EL:FreshScopeEnabled* (equal (EL:Get 'engine result) 'fixed)
      *EL:FreshScope* (equal key (car *EL:FreshScope*)))
    (progn (EL:PerfCount "freshness-reuses" 1) (setq fresh (cadr *EL:FreshScope*)))
    (setq fresh (if (equal (EL:Get 'engine result) 'fixed)
      (EL:PerfCall "FRESH_SOURCE_SCAN" 'EL:FixedFreshSnapshot (list cfg (EL:Get 'panel result)))
      (EL:CollectEndpointSnapshot cfg))))
  (setq good (EL:LogCall "COMPARE_SOURCE" nil 'EL:SourceCurrent (list result cfg fresh)))
  (setq good (and good (EL:LogCall "COMPARE_SOURCE_NUMBER" nil 'EL:NumberInputsCurrent (list result))))
  (if (and good *EL:FreshScopeEnabled* (equal (EL:Get 'engine result) 'fixed))
    (setq *EL:FreshScope* (list key fresh))
    (setq *EL:FreshScope* nil))
  (setq *EL:FreshProofContext* (if good (list (cons 'owner (namedobjdict))
    (cons 'epoch *EL:FreshEpoch*) (cons 'panel (EL:Get 'panel result)) (cons 'config cfg)
    (cons 'original (EL:Get 'signature (EL:Get 'snapshot result)))
    (cons 'verified (EL:Get 'signature fresh))))) good)
(defun EL:PreparedResult (result record / matched rows c edited key)
  (setq result (EL:DLRestoreRecord result record))
  ;; Date: 2026-10-11. Restore the saved number without overwriting a new pick.
  (if (not (assoc 'panel-number result))
    (setq result (EL:Put 'panel-number (EL:PanelNumber record) result)))
  ;; Date: 2026-10-10. Restore explicit per-block ground choices.
  (if (and (not (assoc 'block-ground result)) (assoc 'block-ground record))
    (setq result (EL:Put 'block-ground (EL:Get 'block-ground record) result)))
  (setq matched (EL:MatchCircuits (EL:Get 'circuits result) (EL:ActualRows record) (EL:Get 'diagram-id record)))
  (foreach c (EL:Get 'circuits matched)
    (setq edited (EL:By 'circuit-uid (EL:Get 'circuit-uid c) (EL:Get 'circuits result)))
    (if edited
      (foreach key '(is-ground ground-source ground-rule ground-evidence)
        (setq c (EL:Put key (EL:Get key edited) c))))
    (setq rows (cons c rows)))
  (if (not (EL:Get 'capacity-source result))
    (setq result (EL:Put 'capacity-source
      (cond ((if (EL:Get 'draft-circuits record) (EL:Get 'draft-capacity-source record) (EL:Get 'capacity-source record)))
        (T 'default)) result)))
  (EL:SortCircuitNumbers (EL:ResolveCircuitNumbers
    (EL:Put 'identity-ambiguous (vl-some '(lambda (c) (EL:Get 'identity-error c)) rows) (EL:Put 'circuits (reverse rows) result)))))
(defun EL:DiagramOutputRefs (record / refs row label)
  (setq refs (list (list (EL:Get 'panel-output-handle record) "panel" "panel")))
  (foreach row (EL:Get 'rows record)
    (setq refs (cons (list (EL:Get 'block-handle row) "circuit" (EL:Get 'circuit-uid row)) refs))
    (if (EL:Get 'text-handle row)
      (setq refs (cons (list (EL:Get 'text-handle row) "text" (EL:Get 'circuit-uid row)) refs))))
  (foreach label (EL:Get 'cckk-labels record)
    (setq refs (cons (list (EL:Get 'handle label) "text" (EL:Get 'uid label)) refs))) refs)
;; Date: 2026-10-10. Deleted output is recoverable; foreign objects are not deleted.
(defun EL:DiagramViewBounds (record store / ref entity bounds lo hi good)
  (setq good T)
  (foreach ref (EL:DiagramOutputRefs record)
    (setq entity (EL:OwnedEntity (car ref) store record (cadr ref) (caddr ref))
      bounds (if entity (EL:EntityBounds entity)))
    (if bounds
      (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
        hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))
      (setq good nil)))
  (if (and good lo hi) (list lo hi)))
(defun EL:ShowDiagramBody (record store / bounds)
  (if (and (= (getvar "TILEMODE") 1) (> (getvar "CVPORT") 1))
    (progn
      (EL:FreshBoundary)
      (vla-Regen (vla-get-ActiveDocument (vlax-get-acad-object)) 1)
      (EL:FreshBoundary)
      (if (setq bounds (EL:DiagramViewBounds record store))
