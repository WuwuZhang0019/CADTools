(defun EL:RollbackCreated (/ object)
  (foreach object *EL:Created* (vl-catch-all-apply 'vla-Delete (list object)))
  (setq *EL:Created* nil))
(defun EL:CreateBlock (space name position scale rotation property value layer / object)
  (EL:PerfCount "block-create-attempts" 1)
  (setq object (EL:PerfWrite 'vla-InsertBlock (list space (vlax-3d-point position) name scale scale scale rotation))
        *EL:Created* (cons object *EL:Created*))
  (EL:PerfWrite 'vla-put-Layer (list object layer))
  (if (not (EL:SetDynamicValue object property value))
    (progn (princ "\n动态属性不存在、只读、允许值变化或写入回读不一致。") (exit)))
  (if (not (equal position (cdr (assoc 10 (entget (vlax-vla-object->ename object)))) 1.0e-6))
    (progn (princ "\n动态状态切换导致基点漂移，生成停止。") (exit))) object)
(defun EL:CreateAnnotation (space row plan layer / spec object scale rotation position textdata doc)
  (EL:PerfCount "text-create-attempts" 1)
  (setq spec (EL:Get 'annotation row) scale (EL:Get 'scale plan)
        rotation (+ (EL:Get 'rotation plan) (EL:Get 'rotation spec)) position (EL:Get 'text-position row) textdata (EL:Get 'text row))
  (if (EL:Get 'layer spec)
    (progn
      (setq layer (EL:Get 'layer spec) doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (if (not (tblsearch "LAYER" layer)) (vla-Add (vla-get-Layers doc) layer))))
  (if (= (EL:Get 'type spec) "TEXT")
    (setq object (EL:PerfWrite 'vla-AddText (list space textdata (vlax-3d-point position) (* scale (EL:Get 'height spec)))))
    (progn
      (setq textdata (EL:ReplaceAll (EL:ReplaceAll (EL:ReplaceAll textdata "\\" "\\\\") "{" "\\{") "}" "\\}"))
      (setq object (EL:PerfWrite 'vla-AddMText (list space (vlax-3d-point position) (* scale (max 0.001 (EL:Get 'width spec))) textdata)))))
  (setq *EL:Created* (cons object *EL:Created*))
  (EL:PerfWrite 'vla-put-Layer (list object layer)) (EL:PerfWrite 'vla-put-StyleName (list object (EL:Get 'style spec)))
  (if (EL:Get 'layer spec)
    (progn (EL:PerfWrite 'vla-put-Color (list object 256)) (EL:PerfWrite 'vla-put-Linetype (list object "ByLayer"))
      (EL:PerfWrite 'vla-put-LinetypeScale (list object 1.0)) (EL:PerfWrite 'vla-put-Lineweight (list object -1))
      (if (= (EL:Get 'type spec) "TEXT")
        (progn (EL:PerfWrite 'vla-put-Thickness (list object 0.0)) (EL:PerfWrite 'vla-put-TextGenerationFlag (list object 0))))))
  (if (= (EL:Get 'type spec) "TEXT") (EL:PerfWrite 'vla-put-Height (list object (* scale (EL:Get 'height spec))))
    (EL:PerfWrite 'vla-put-TextHeight (list object (* scale (EL:Get 'height spec)))))
  (EL:PerfWrite 'vla-put-Rotation (list object rotation))
  (if (= (EL:Get 'type spec) "TEXT")
    (progn
      (EL:PerfWrite 'vla-put-Alignment (list object (EL:Get 'align spec)))
      (if (/= (EL:Get 'align spec) 0) (EL:PerfWrite 'vla-put-TextAlignmentPoint (list object (vlax-3d-point position))))
      (EL:PerfWrite 'vla-put-ScaleFactor (list object (EL:Get 'factor spec))) (EL:PerfWrite 'vla-put-ObliqueAngle (list object (EL:Get 'oblique spec))))
    (progn (EL:PerfWrite 'vla-put-AttachmentPoint (list object (EL:Get 'align spec)))
      (EL:PerfWrite 'vla-put-InsertionPoint (list object (vlax-3d-point position))))) object)
(defun EL:GeneratePlan (plan template / *error* doc space layer object undo-open newlayer row handles)
  (defun *error* (msg)
    (EL:RollbackCreated)
    (if newlayer (vl-catch-all-apply 'vla-Delete (list newlayer)))
    (if undo-open (vl-catch-all-apply 'vla-EndUndoMark (list doc)))
    (redraw) (if msg (princ (strcat "\n本次生成已清理：" msg))) (princ))
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) space (vla-get-ModelSpace doc)
        layer (EL:Get 'layer template) *EL:Created* nil)
  (if (or (= 0 (logand 1 (getvar "UNDOCTL"))) (/= 0 (logand 8 (getvar "UNDOCTL"))))
    (progn (princ "\n请先启用 UNDO 并结束已有撤销组，再生成系统图。") (exit)))
  (vla-StartUndoMark doc) (setq undo-open T)
  (if (not (tblsearch "LAYER" layer)) (setq newlayer (vla-Add (vla-get-Layers doc) layer)))
  (EL:CreateBlock space (EL:Get 'panel-name plan) (EL:Get 'position plan) (EL:Get 'scale plan) (EL:Get 'rotation plan)
    (EL:Get 'property (EL:Get 'panel template)) (EL:Get 'panel-value plan) layer)
  (foreach row (EL:Get 'rows plan)
    (EL:CreateBlock space (EL:Get 'name (EL:Get 'circuit template)) (EL:Get 'position row) (EL:Get 'scale plan) (EL:Get 'rotation plan)
      (EL:Get 'property (EL:Get 'circuit template)) (EL:Get 'value row) layer)
    (EL:CreateAnnotation space row plan layer))
  (foreach object *EL:Created* (setq handles (cons (vla-get-Handle object) handles)))
  (vla-EndUndoMark doc) (setq undo-open nil *EL:Created* nil) (redraw)
  handles)
(defun EL:LegacyGenerate (/ *error* cfg library fresh template capacity outputs point rotation scale plan handles record)
  (defun *error* (msg) (redraw) (if msg (princ (strcat "\n生成取消：" msg))) (princ))
  (if (and *EL:Result* (setq cfg (EL:LoadConfig)))
    (progn
      (setq template (EL:Get 'template cfg) library (EL:LoadLibrary)
            fresh (EL:CollectEndpointSnapshot cfg) *EL:Result* (EL:BoxStatistics *EL:Result* cfg library nil))
      (cond
        ((not (EL:SourceCurrent *EL:Result* cfg fresh))
         (princ "\nSOURCE_CHANGED：源图或识别配置已变化，请重新运行 ELSTAT。"))
        ((not (EL:Get 'can-generate *EL:Result*)) (EL:PrintStatistics *EL:Result*))
        ((not (EL:TemplateRuntimeValid template cfg)) (princ "\n模板失效或未采集，请运行 ELTEMPLATE。"))
        (T
         (initget "300 600 1000") (setq capacity (getkword "\n箱体档位 [300即0.3kW/600即0.6kW/1000即1kW] <300>: ")
           capacity (cond ((equal capacity "600") 'cap600) ((equal capacity "1000") 'cap1000) (T 'cap300))
           outputs (EL:ChooseOutputs *EL:Result*) point (getpoint "\n选择系统图插入点: "))
         (if (and outputs point)
           (progn
             (setq point (trans point 1 0) rotation (getreal "\n系统图 WCS 旋转角度（度）<0>: "))
             (initget 6) (setq scale (getreal "\n正等比缩放 <1>: ")
               plan (EL:BuildGenerationPlan *EL:Result* template capacity outputs point
                 (* (/ pi 180.0) (cond (rotation) (T 0.0))) (cond (scale) (T 1.0))))
             (if plan
               (progn
                 (EL:PreviewPlan plan) (initget "Yes No")
                 (if (equal (getkword "\n确认上述档位、顺序、数量与功率并正式生成？[Yes/No] <No>: ") "Yes")
                   (if (equal (EL:Get 'signature fresh) (EL:Get 'signature (EL:CollectEndpointSnapshot cfg)))
                     (if (setq handles (EL:GeneratePlan plan template))
                       (progn
                         (setq record (list (cons 'version 1) (cons 'drawing (EL:DrawingID)) (cons 'date (getvar "CDATE"))
                           (cons 'handles handles) (cons 'plan plan) (cons 'source (EL:Get 'signature fresh))))
                         (EL:WriteData (strcat *EL:Root* "output/generation-" (EL:Hash (EL:DrawingID)) ".eld") record)
                         (princ "\n系统图已生成；一次 UNDO 可撤销本次生成。")))
                     (princ "\nSOURCE_CHANGED：预览后源图发生变化，未生成。")))
                 (redraw))
               (princ "\n输出配置无效；实际回路须完整保留且编号唯一，预留须单独新增。")))))))) (princ))
(princ)

