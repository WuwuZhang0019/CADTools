    (foreach seg (EL:Get 'contour row)
      (EL:DrawTransient (EL:LocalPoint (car seg) (EL:Get 'position row) (EL:Get 'rotation plan) (EL:Get 'scale plan))
        (EL:LocalPoint (cadr seg) (EL:Get 'position row) (EL:Get 'rotation plan) (EL:Get 'scale plan)) 3))
