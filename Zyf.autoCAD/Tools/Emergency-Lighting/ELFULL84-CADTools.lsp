    (cons 'point point) (cons 'normal normal) (cons 'target 0) (cons 'displacement displacement)
    (cons 'sample sample) (cons 'method 'extrusion-vector))
    'EL:OCSTrans (list point normal displacement stage)))
(defun EL:PolylineTrans (point normal)
  (EL:OCSTrans point normal nil "POLYLINE_TRANS"))
(defun EL:PolylineData (e)
  (EL:PolylineDataDXF (entget e)))
(defun EL:PolylineDataDXF (data / p elev normal points bulges x converted)
  ;; Date: 2026-10-15. Geometry and diagnostics use the caller's fresh DXF.
  (setq elev (cond ((cdr (assoc 38 data))) (T 0.0))
        normal (cond ((cdr (assoc 210 data))) (T '(0.0 0.0 1.0))))
  (EL:LogEvent "POLYLINE_INPUT" (list (cons 'entity (EL:LogEntityData data)) (cons 'elevation elev) (cons 'raw-dxf data)))
  (foreach x data
    ;; Capture the exact DXF row before numeric group-code comparisons.
    (EL:LogEvent "POLYLINE_DXF_ROW" x)
    (cond ((= (car x) 10)
           (setq p (cdr x)
                 converted (EL:LogCall "POLYLINE_TRANS" (list (cons 'handle (cdr (assoc 5 data)))
                   (cons 'vertex p) (cons 'elevation elev) (cons 'normal normal) (cons 'target 0)
                   (cons 'method 'extrusion-vector))
                   'EL:PolylineTrans (list (list (car p) (cadr p) elev) normal)))
           (setq points (cons converted points)
                 bulges (cons 0.0 bulges)))
          ((= (car x) 42) (setq bulges (cons (cdr x) (cdr bulges))))))
  (EL:LogEvent "POLYLINE_NORMAL" normal)
  (if (< (caddr normal) 0.0)
    (setq bulges (mapcar '- bulges)))
  (list (reverse points) (reverse bulges)))
(defun EL:PolylineSegments (points bulges closed err / out tail bs part segment)
  ;; Date: 2026-10-21. Accumulate sampled pieces once, preserving source order.
  (setq tail (if closed (append points (list (car points))) points) bs bulges)
  (while (cdr tail)
    (EL:LogEvent "POLYLINE_SEGMENT" (list (cons 'start (car tail)) (cons 'end (cadr tail))
      (cons 'bulge (car bs)) (cons 'error-bound err)))
    (setq part (EL:BulgePoints (car tail) (cadr tail) (cond ((car bs)) (T 0.0)) err))
    (if part
      (foreach segment (EL:Segments part) (setq out (cons segment out)))
      (setq out nil tail nil))
    (setq tail (cdr tail) bs (cdr bs))) (reverse out))
(defun EL:MakeEnd (id side points bulges layer / p q b rest state direction)
  ;; Last vertex has no outgoing segment: use the penultimate original bulge.
  (if (equal side 'end) (setq points (reverse points) bulges (cdr (reverse bulges))))
  (setq p (car points) rest (cdr points) b (car bulges))
  (while (and rest (< (EL:Norm (EL:V- (car rest) p)) 1.0e-9))
    (setq rest (cdr rest) bulges (cdr bulges) b (car bulges)))
  (setq q (car rest) state (cond ((not q) 'INVALID_GEOMETRY)
      ((and b (> (abs b) 1.0e-12)) 'UNSUPPORTED_END_GEOMETRY) (T 'straight)))
  (if q (setq direction (EL:Unit (EL:V- p q))))
  (list (cons 'key (list id side)) (cons 'wire id) (cons 'side side) (cons 'point p)
        (cons 'direction direction) (cons 'geometry state) (cons 'layer layer)))
;; Date: 2026-10-11. Filled straight polyline widths, with butt ends, in drawing units.
(defun EL:WireWidthProfiles (data points bulges / widths pair current constant variable out)
  (setq constant (cond ((cdr (assoc 43 data))) (T 0.0)))
  (foreach pair data
    (cond ((= (car pair) 10)
           (if current (setq widths (cons current widths))) (setq current '(0.0 0.0)))
          ((and current (= (car pair) 40))
           (setq current (list (cdr pair) (cadr current)) variable T))
          ((and current (= (car pair) 41))
           (setq current (list (car current) (cdr pair)) variable T))))
  (if current (setq widths (reverse (cons current widths))))
  (while (cdr points)
    (setq pair (if variable (car widths) (list constant constant)))
    (if (and pair (>= (car pair) 0.0) (>= (cadr pair) 0.0)
        (> (max (car pair) (cadr pair)) 0.0)
        (or (not (car bulges)) (< (abs (car bulges)) 1.0e-12)))
      (setq out (cons (list (car points) (cadr points) (car pair) (cadr pair)) out)))
    (setq points (cdr points) widths (cdr widths) bulges (cdr bulges)))
  (reverse out))
(defun EL:WireStrip (a b start end / v length normal points ring)
  (setq v (EL:V- b a) length (EL:Norm v))
  (if (and (> length 1.0e-9) (> (max start end) 0.0))
    (progn
      (setq normal (list (/ (- (cadr v)) length) (/ (car v) length) 0.0)
        points (list (EL:V+ a (EL:V* (/ start 2.0) normal))
          (EL:V+ b (EL:V* (/ end 2.0) normal))
          (EL:V- b (EL:V* (/ end 2.0) normal))
          (EL:V- a (EL:V* (/ start 2.0) normal)))
        ring (EL:Segments (append points (list (car points)))))
      (list (cons 'segments ring) (cons 'regions (list ring))))))
(defun EL:WireContactStrips (segments profiles / out segment profile base length start end strip prepared first repeated)
  ;; Date: 2026-10-21. Reuse only this call's immutable profile baselines.
  ;; Prepare lazily during the first segment, retaining original error order.
  (setq first T)
  (foreach segment segments
    (if first (setq repeated (cdr segments)))
    (foreach profile (if first profiles prepared)
      (if first
        (progn
          (setq base (list (list (car profile) (cadr profile)))
            length (EL:Norm (EL:V- (cadr profile) (car profile))))
          (if repeated (setq prepared (cons (list profile base length) prepared))))
        (setq base (cadr profile) length (caddr profile) profile (car profile)))
      (if (and (> length 1.0e-9)
          (EL:Touches (car segment) base (EL:GapEpsilon) (EL:GapEpsilon))
          (EL:Touches (cadr segment) base (EL:GapEpsilon) (EL:GapEpsilon)))
        (progn
          (setq start (+ (nth 2 profile) (* (- (nth 3 profile) (nth 2 profile))
            (/ (EL:Norm (EL:V- (car segment) (car profile))) length)))
            end (+ (nth 2 profile) (* (- (nth 3 profile) (nth 2 profile))
            (/ (EL:Norm (EL:V- (cadr segment) (car profile))) length))))
          (if (setq strip (EL:WireStrip (car segment) (cadr segment) start end))
            (setq out (cons strip out))))))
    (if first (setq prepared (if repeated (reverse prepared)) first nil)))
  (reverse out))
(defun EL:WireContactBounds (wire / segments strip segment)
  ;; Date: 2026-10-21. Build the same ordered bound input once for wide wires.
  ;; Fresh records reuse their envelope; clipped trunk pieces still rebuild it.
  (if (assoc 'contact-bounds wire) (EL:Get 'contact-bounds wire)
    (progn
      (setq segments (EL:Get 'segments wire))
      (if (EL:Get 'contact-strips wire)
        (progn
          (setq segments (reverse segments))
          (foreach strip (EL:Get 'contact-strips wire)
            (foreach segment (EL:Get 'segments strip)
              (setq segments (cons segment segments))))
          (setq segments (reverse segments))))
      (EL:SegmentBounds segments))))
(defun EL:PrepareWireBounds (wire)
  (EL:Put 'contact-bounds (EL:WireContactBounds
    (vl-remove-if '(lambda (row) (equal (car row) 'contact-bounds)) wire)) wire))
(defun EL:WireRecord (e cfg)
  (EL:WireRecordDXF e (entget e) cfg))
(defun EL:WireRecordDXF (e d cfg / id typ pts bs closed segments ends issues normal total seg bounds profiles started record)
  (if *EL:CollectReadProfile* (setq started (EL:Tick)))
  ;; Date: 2026-10-15. No second entity read while collecting this wire.
  (setq id (cdr (assoc 5 d)) typ (cdr (assoc 0 d)) normal (cdr (assoc 210 d)))
  (cond ((= typ "LINE") (setq pts (list (cdr (assoc 10 d)) (cdr (assoc 11 d))) bs '(0.0 0.0)))
        ((= typ "LWPOLYLINE")
         (setq pts (EL:PolylineDataDXF d) bs (cadr pts) pts (car pts)
               closed (= (logand 1 (cond ((cdr (assoc 70 d))) (T 0))) 1)))
        (T (setq issues (list (EL:Issue 'UNSUPPORTED_WIRE id typ)))))
  (if (and normal (> (+ (abs (car normal)) (abs (cadr normal))) 1.0e-9))
    (setq issues (cons (EL:Issue 'UNSUPPORTED_PLANE id normal) issues)))
  (if closed (setq issues (cons (EL:Issue 'CLOSED_WIRE id nil) issues)))
  (if pts
    (progn
      (setq segments (EL:PolylineSegments pts bs closed (/ (EL:Get 'eps_boundary (EL:Get 'params cfg)) 8.0)))
      (if (not closed)
        (setq ends (list (EL:MakeEnd id 'start pts bs (cdr (assoc 8 d)))
                         (EL:MakeEnd id 'end pts bs (cdr (assoc 8 d))))))))
  (if (and pts (not segments)) (setq issues (cons (EL:Issue 'INVALID_GEOMETRY id nil) issues)))
  (setq total 0.0)
  (foreach seg segments (setq total (+ total (EL:Norm (EL:V- (cadr seg) (car seg))))))
  (if (and pts (< total 1.0e-9)) (setq issues (cons (EL:Issue 'INVALID_GEOMETRY id nil) issues)))
  (if (and pts (> (- (apply 'max (mapcar 'caddr pts)) (apply 'min (mapcar 'caddr pts))) (EL:Get 'eps_z (EL:Get 'params cfg))))
    (setq issues (cons (EL:Issue 'UNSUPPORTED_PLANE id nil) issues)))
  (if (not (member typ '("LINE" "LWPOLYLINE"))) (setq bounds (EL:LogCall "ENTITY_BOUNDS" (EL:LogEntity e) 'EL:EntityBounds (list e))))
  (if (and (= typ "LWPOLYLINE") (not closed))
    (setq profiles (EL:WireWidthProfiles d pts bs)))
  (setq record (EL:PrepareWireBounds (list (cons 'id id) (cons 'layer (cdr (assoc 8 d))) (cons 'type typ)
        (cons 'width-profiles profiles) (cons 'contact-strips (EL:WireContactStrips segments profiles))
        (cons 'segments segments) (cons 'bounds bounds) (cons 'ends ends) (cons 'issues issues) (cons 'raw (EL:Signature (EL:CanonicalVisibilityDXF d))))))
  (if *EL:CollectReadProfile*
    (setq *EL:CollectWireMS* (+ *EL:CollectWireMS* (EL:PerfDelta started (EL:Tick)))
      *EL:CollectProfileReads* (+ *EL:CollectProfileReads* 2))) record)
(defun EL:TransformSegments (segments matrix)
