;; Date: 2026-10-10. Raised borders and equal padding for both green buttons.
(defun EL:GreenPickButton (key labelwidth / w h scale ox oy run)
  (setq w (dimx_tile key) h (dimy_tile key)
    scale (max 1 (fix (min (/ (float w) (+ labelwidth 16)) (/ (float h) 20.0))))
    ox (fix (/ (- w (* labelwidth scale)) 2.0)) oy (fix (/ (- h (* 12 scale)) 2.0)))
  (start_image key)
  (fill_image 0 0 w h 0)
  (fill_image 1 1 (- w 2) (- h 2) 8)
  (fill_image 1 1 (- w 3) 2 7)
  (fill_image 1 1 2 (- h 3) 7)
  (fill_image 3 3 (- w 6) (- h 6) 3)
  (foreach run (EL:PickButtonRuns key)
    (if (< (car run) labelwidth)
    (fill_image (+ ox (fix (* (car run) scale))) (+ oy (fix (* (cadr run) scale)))
      (max 1 (- (fix (* (+ (car run) (caddr run)) scale)) (fix (* (car run) scale))))
      (max 1 (- (fix (* (1+ (cadr run)) scale)) (fix (* (cadr run) scale)))) 0)))
  (end_image))

;; Date: 2026-10-11. Number selection is the next step of both model-pick flows.
(defun EL:PickPanelNumber (/ picked data value outcome item done)
  (while (not done)
    (setq outcome (EL:PerfInput 'nentsel (list "\n拾取配电箱编号文字（Enter 使用暂无编号）：")))
    (if (not outcome) (setq value "暂无编号" done T)
      (progn
        (setq picked (car outcome) data (entget picked))
        (if (member (cdr (assoc 0 data)) '("TEXT" "MTEXT" "ATTRIB" "ATTDEF"))
          (progn
            (setq value "")
            (foreach item data (if (= (car item) 3) (setq value (strcat value (cdr item)))))
            (setq value (vl-string-trim " \t\r\n" (strcat value (cdr (assoc 1 data)))))
            (if (or (vl-string-search "\\" value) (vl-string-search "{" value) (vl-string-search "}" value))
              (princ "\n此多行文字包含格式控制，请重新拾取普通编号文字或属性。")
              (setq value (if (= value "") "暂无编号" value) done T)))
          (princ "\n请选择编号文字或属性，或按 Enter 使用暂无编号。")))))
  value)

;; Date: 2026-10-11. Explain rejected generation with circuit and object evidence.
(defun EL:GenerationIssueText (issue / code label)
  (setq code (EL:Get 'code issue)
    label (cond
      ((equal code 'CLOSED_CIRCUIT) "检测到闭合连接，请核对是否重复连接或误接")
      ((equal code 'AMBIGUOUS_CONTACT) "接触位置存在多种连接可能")
      ((equal code 'CIRCUIT_OWNERSHIP_CONFLICT) "多条回路共用对象")
      ((equal code 'OTHER_PANEL) "连接到其他配电箱")
      ((equal code 'UNKNOWN_ROLE) "对象用途未明确")
      ((equal code 'ABNORMAL_BRANCH) "分支连接异常")
      ((equal code 'JUNCTION_INCOMPLETE) "接线盒只有一个有效接入导线，请核对盒后线路")
      ((equal code 'POWER_MISSING_OR_INVALID) "设备功率缺失或无效")
      ((equal code 'NO_RECOGNIZED_DEVICES) "未识别到设备，请核对灯具及贴临设备的真实连接")
      ((equal code 'POWER_OVERFLOW) "功率计算超出范围")
      ((equal code 'POWER_OVER_LIMIT) "回路功率超过172W")
      ((equal code 'DEVICE_OWNERSHIP_CONFLICT) "设备被多个回路共同识别")
      ((equal code 'DEVICE_LIBRARY_UNKNOWN) "设备功率未填写；请在图例表填写单个功率")
      ((equal code 'DEVICE_LIBRARY_UNAVAILABLE) "设备库读取失败；原文件保留，请修复后重新统计")
      (T (strcat "连接或几何检查未通过：" (vl-prin1-to-string code)))))
  (strcat label "；对象：" (vl-prin1-to-string (EL:Get 'object issue))
    "；详情：" (vl-prin1-to-string (EL:Get 'detail issue))))
;; Date: 2026-10-12. Aggregate the two power validators by device name across circuits.
(defun EL:GenerationMissing (result / rows circuit issue index ids identity id block name key row)
  (setq index 0)
  (foreach circuit (EL:Get 'circuits result)
    (setq index (1+ index))
    (foreach issue (append (EL:Get 'issues circuit) (EL:Get 'power-issues circuit))
      (if (member (EL:Get 'code issue) '(POWER_MISSING_OR_INVALID DEVICE_LIBRARY_UNKNOWN))
        (progn
          (setq ids (EL:Get 'object issue) identity (EL:Get 'detail issue))
          (if (not (listp ids)) (setq ids (list ids)))
          (foreach id ids
            (setq block (EL:By 'id id (EL:Get 'blocks (EL:Get 'snapshot result)))
              name (cond ((EL:Get 'name block)) ((equal (type identity) 'STR) identity)
                ((and (listp identity) (equal (type (car identity)) 'STR)) (car identity))
                ((equal (type id) 'STR) id) (T "未命名设备"))
              key (EL:DLNameKey name) row (EL:By 'key key rows))
            (if (not row) (setq row (list (cons 'key key) (cons 'name name) '(ids) '(circuits)) rows (append rows (list row))))
            (setq rows (subst (EL:Put 'ids (EL:Unique (cons id (EL:Get 'ids row)))
              (EL:Put 'circuits (EL:Unique (append (EL:Get 'circuits row) (list (itoa index)))) row)) row rows))))))) rows)
(defun EL:GenerationProblems (result / lines circuit issue index problems row missing)
  (setq index 0)
  (setq missing (EL:GenerationMissing result))
  (foreach row missing
    (setq lines (append lines (list (strcat (EL:Get 'name row) "：请填写或核对单个功率；"
      (itoa (length (EL:Get 'ids row))) " 个设备，回路 " (EL:DLAliasText (EL:Get 'circuits row)) "。")))))
  (foreach circuit (EL:Get 'circuits result)
    (setq index (1+ index) problems (EL:Unique (append (EL:Get 'issues circuit) (EL:Get 'power-issues circuit))))
    (foreach issue problems
      (if (not (member (EL:Get 'code issue) '(POWER_MISSING_OR_INVALID DEVICE_LIBRARY_UNKNOWN)))
        (setq lines (append lines (list (strcat "回路" (itoa index) "：" (EL:GenerationIssueText issue)))))))
    (if (and (not problems) (not (EL:Get 'power-complete circuit)))
      (setq lines (append lines (list (strcat "回路" (itoa index) "：连接或功率核对未完成，请查看全部回路。"))))))
  (foreach issue (EL:Get 'issues (EL:Get 'snapshot result))
    (setq lines (append lines (list (strcat "图面：" (EL:GenerationIssueText issue))))))
  (if (EL:Get 'box-total-overflow result) (setq lines (append lines '("整箱功率计算超出范围。"))))
  (if lines lines '("识别状态未完成，请重新统计并查看全部回路；详细状态已写入日志。")))
(defun EL:PanelGenerationBlocked (result / lines line message compact index missing)
  (setq lines (EL:GenerationProblems result) message "不能生成，原因如下：")
  (setq missing (EL:GenerationMissing result))
  (if missing (setq message (strcat "尚有 " (itoa (length missing)) " 种设备需要填写或核对单个功率。"
    "\n可用“查看/补填设备功率”定位并补填；以下其他问题仍需处理：")))
  (setq compact message index 0)
  (foreach line lines (setq message (strcat message "\n" line)))
  (foreach line lines
    (if (< index 10) (setq compact (strcat compact "\n" line))) (setq index (1+ index)))
  (if (> index 10) (setq compact (strcat compact "\n另有 " (itoa (- index 10)) " 项，完整详情已写入诊断日志。")))
  (EL:LogEvent "GENERATION_BLOCKED" (list (cons 'panel (EL:Get 'panel result))
    (cons 'reasons lines) (cons 'circuits (EL:Get 'circuits result))))
  (EL:PanelText "p_error" (car lines))
  (princ (strcat "\n" message))
  (alert (strcat compact (if missing "\n补齐设备库资料后返回本面板重新核对。" "")
    "\n可保存草稿；连接问题请用“查看全部回路”核对。")))

;; Date: 2026-10-15. ACI 1 draws only the step numbers, on the dialog background.
(defun EL:RedStepDraw (key index / w h scale ox oy run)
  (setq w (dimx_tile key) h (dimy_tile key)
    scale (max 1 (fix (min (/ (float w) 56.0) (/ (float h) 14.0))))
    ox 0 oy (fix (/ (- h (* 14 scale)) 2.0)))
  (start_image key)
  (fill_image 0 0 w h -15)
  (foreach run (EL:StepLabelRuns index)
    (fill_image (+ ox (* (car run) scale)) (+ oy (* (cadr run) scale))
      (* (caddr run) scale) scale 1))
  (end_image))
(defun EL:StepLabelsDraw (/ index)
  (setq index 1)
  (repeat 4 (EL:RedStepDraw (strcat "p_step" (itoa index)) index) (setq index (1+ index))))

