(defun EL:DeviceContourTolerance () 0.001)
(defun EL:TranslateCurves (curves offset)
  (mapcar '(lambda (curve) (cons (EL:V+ (car curve) offset) (cdr curve))) curves))
;; Date: 2026-10-13. Reuse definition primitives without sampling circles again.
(defun EL:SimilarityScale (matrix / x y sx sy)
  (setq x (list (nth 0 matrix) (nth 1 matrix) 0.0)
        y (list (nth 2 matrix) (nth 3 matrix) 0.0)
        sx (EL:Norm x) sy (EL:Norm y))
  (if (and (> sx 1.0e-12) (> sy 1.0e-12)
      (<= (abs (- sx sy)) (* 1.0e-10 (min sx sy)))
      (<= (abs (EL:Dot x y)) (* 1.0e-10 sx sy))) sx))
(defun EL:TransformCurve (curve matrix / scale vector start sign)
  (if (setq scale (EL:SimilarityScale matrix))
    (progn
      (setq start (nth 2 curve)
        vector (list (+ (* (nth 0 matrix) (cos start)) (* (nth 2 matrix) (sin start)))
          (+ (* (nth 1 matrix) (cos start)) (* (nth 3 matrix) (sin start))) 0.0)
        sign (if (< (- (* (nth 0 matrix) (nth 3 matrix)) (* (nth 1 matrix) (nth 2 matrix))) 0.0) -1.0 1.0))
