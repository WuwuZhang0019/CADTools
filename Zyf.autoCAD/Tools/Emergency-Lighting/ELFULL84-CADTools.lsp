  (EL:PerfSet "store-template-pool-count" 0)
  (EL:PerfSet "store-atom-pool-count" 0)
  (EL:PerfSet "store-body-token-count" 0) tokens)
(defun EL:StoreEncode (value / packed tokens valid bodycount)
