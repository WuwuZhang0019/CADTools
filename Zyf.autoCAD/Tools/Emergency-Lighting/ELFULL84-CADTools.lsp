;; Date: 2026-10-10. Analytic primitives: (center radius start signed-sweep hole).
(defun EL:CurvePoint (curve angle)
  (EL:V+ (car curve) (list (* (cadr curve) (cos angle)) (* (cadr curve) (sin angle)) 0.0)))
(defun EL:EllipseSegments (data err / center major minor normal radius start sweep points)
  ;; Date: 2026-10-20. DXF ellipse axes are in the definition's WCS.
  ;; Scale a unit-circle chord bound by the major radius; retain a real ellipse.
  (setq center (cdr (assoc 10 data)) major (cdr (assoc 11 data))
    normal (cond ((cdr (assoc 210 data))) (T '(0.0 0.0 1.0)))
    radius (EL:Norm major) start (cdr (assoc 41 data))
    sweep (- (cdr (assoc 42 data)) start))
  (if (and (> radius 1.0e-12) (> (cdr (assoc 40 data)) 0.0) (<= (cdr (assoc 40 data)) 1.0))
    (progn
      (if (<= sweep 0.0) (setq sweep (+ sweep (* 2.0 pi))))
      (setq minor (EL:V* (* (cdr (assoc 40 data)) (if (< (caddr normal) 0.0) -1.0 1.0))
        (list (- (cadr major)) (car major) 0.0))
        points (EL:ArcPoints '(0.0 0.0 0.0) 1.0 start sweep (/ err radius)))
      (EL:Segments (mapcar '(lambda (point) (EL:V+ center
        (EL:V+ (EL:V* (car point) major) (EL:V* (cadr point) minor)))) points)))))
(defun EL:CurveFull (curve) (>= (abs (nth 3 curve)) (- (* 2.0 pi) 1.0e-12)))
(defun EL:CurveAngleHas (curve point / angle delta)
  (setq angle (atan (- (cadr point) (cadr (car curve))) (- (car point) (caar curve)))
    delta (if (< (nth 3 curve) 0.0) (- (nth 2 curve) angle) (- angle (nth 2 curve)))
    delta (rem (+ (rem delta (* 2.0 pi)) (* 2.0 pi)) (* 2.0 pi)))
  (or (EL:CurveFull curve) (<= delta (+ (abs (nth 3 curve)) (/ (EL:GapEpsilon) (cadr curve))))
    (<= (- (* 2.0 pi) delta) (/ (EL:GapEpsilon) (cadr curve)))))
(defun EL:CurvePointHit (point curve tol)
  (and (<= (abs (- (caddr point) (caddr (car curve)))) (EL:GapEpsilon))
    (or (and (<= (abs (- (EL:Norm (EL:V- point (car curve))) (cadr curve))) tol)
          (EL:CurveAngleHas curve point))
      ;; An open arc has finite endpoints. A nearby angular neighbour is a hit
      ;; only when its Euclidean endpoint distance is within the same tolerance.
      (and (not (EL:CurveFull curve))
        (or (<= (EL:Norm (EL:V- point (EL:CurvePoint curve (nth 2 curve)))) tol)
          (<= (EL:Norm (EL:V- point (EL:CurvePoint curve (+ (nth 2 curve) (nth 3 curve))))) tol))))))
(defun EL:CurveSegmentHit (seg curve tol / a v center len unit along nearest dist delta hit value point)
  (setq a (car seg) v (EL:V- (cadr seg) a) center (car curve) len (EL:Norm v))
  (if (and (<= (abs (- (caddr a) (caddr center))) (EL:GapEpsilon))
           (<= (abs (- (caddr (cadr seg)) (caddr center))) (EL:GapEpsilon)))
    (if (<= len 1.0e-12) (EL:CurvePointHit a curve tol)
      (progn
        (setq unit (EL:V* (/ 1.0 len) v) along (EL:Dot (EL:V- center a) unit)
          nearest (EL:V+ a (EL:V* along unit)) dist (EL:Norm (EL:V- nearest center))
          hit (or (EL:CurvePointHit a curve tol) (EL:CurvePointHit (cadr seg) curve tol)
            (and (not (EL:CurveFull curve))
              (or (<= (EL:PointSegmentDistance (EL:CurvePoint curve (nth 2 curve)) a (cadr seg)) tol)
                (<= (EL:PointSegmentDistance (EL:CurvePoint curve (+ (nth 2 curve) (nth 3 curve))) a (cadr seg)) tol)))))
        (if (<= dist (+ (cadr curve) tol))
          (progn
            (setq delta (sqrt (max 0.0 (* (- (cadr curve) dist) (+ (cadr curve) dist)))))
            (foreach value (list (- along delta) (+ along delta))
              (if (and (>= value (- tol)) (<= value (+ len tol)))
                (progn (setq point (EL:V+ a (EL:V* (max 0.0 (min len value)) unit)))
                  (if (EL:CurvePointHit point curve tol) (setq hit T)))))))
        hit))))
(defun EL:CurvesTouch (a b / delta dist r s x height base normal point hit)
  (setq delta (EL:V- (car b) (car a)) dist (EL:Norm delta) r (cadr a) s (cadr b))
  (if (<= (abs (- (caddr (car a)) (caddr (car b)))) (EL:GapEpsilon))
    (cond
      ((and (<= dist (EL:GapEpsilon)) (<= (abs (- r s)) (EL:GapEpsilon)))
        (or (EL:CurveFull a) (EL:CurveFull b)
          (EL:CurveAngleHas a (EL:CurvePoint b (nth 2 b)))
          (EL:CurveAngleHas a (EL:CurvePoint b (+ (nth 2 b) (nth 3 b))))
          (EL:CurveAngleHas b (EL:CurvePoint a (nth 2 a)))))
      ((and (> dist 1.0e-12) (<= dist (+ r s (EL:GapEpsilon)))
            (>= dist (- (abs (- r s)) (EL:GapEpsilon))))
        (setq x (/ (+ (* (- r s) (+ r s)) (* dist dist)) (* 2.0 dist))
          height (sqrt (max 0.0 (* (- r x) (+ r x))))
          base (EL:V+ (car a) (EL:V* (/ x dist) delta))
          normal (list (/ (- (cadr delta)) dist) (/ (car delta) dist) 0.0))
        (foreach point (list (EL:V+ base (EL:V* height normal)) (EL:V- base (EL:V* height normal)))
          (if (and (EL:CurvePointHit point a (EL:GapEpsilon))
                   (EL:CurvePointHit point b (EL:GapEpsilon))) (setq hit T))) hit))))
(defun EL:CurvesTouchTolerance (a b tol / delta dist unit pa pb sa sb hit)
  ;; Date: 2026-10-14. Keep the original numerical-only primitive unchanged.
  ;; A finite-arc minimum occurs at an endpoint, an actual intersection, or
  ;; two radial points on the line of centres. No expanded circle/AABB is used.
  (if (<= (abs (- (caddr (car a)) (caddr (car b)))) (EL:GapEpsilon))
    (progn
      (setq hit (EL:CurvesTouch a b))
      (if (and (not hit) (> tol (EL:GapEpsilon)))
        (progn
          (foreach pa (list (EL:CurvePoint a (nth 2 a)) (EL:CurvePoint a (+ (nth 2 a) (nth 3 a))))
            (if (EL:CurvePointHit pa b tol) (setq hit T)))
          (foreach pb (list (EL:CurvePoint b (nth 2 b)) (EL:CurvePoint b (+ (nth 2 b) (nth 3 b))))
            (if (EL:CurvePointHit pb a tol) (setq hit T)))
          (setq delta (EL:V- (car b) (car a)) dist (EL:Norm delta))
          (if (> dist 1.0e-12)
            (progn
              (setq unit (EL:V* (/ 1.0 dist) delta))
              (foreach sa '(-1.0 1.0)
                (setq pa (EL:V+ (car a) (EL:V* (* sa (cadr a)) unit)))
                (foreach sb '(-1.0 1.0)
                  (setq pb (EL:V+ (car b) (EL:V* (* sb (cadr b)) unit)))
                  (if (and (EL:CurveAngleHas a pa) (EL:CurveAngleHas b pb)
                      (<= (EL:Norm (EL:V- pa pb)) tol)) (setq hit T))))))))
      hit)))
(defun EL:NativeCurve (data matrix / center x y sx sy start sweep sign)
  (setq center (cdr (assoc 10 data))
    x (EL:AffinePoint (EL:EntityOCSTrans (EL:V+ center '(1.0 0.0 0.0)) data nil "CURVE_FRAME" 'x) matrix)
    y (EL:AffinePoint (EL:EntityOCSTrans (EL:V+ center '(0.0 1.0 0.0)) data nil "CURVE_FRAME" 'y) matrix)
    center (EL:AffinePoint (EL:EntityOCSTrans center data nil "CURVE_FRAME" 'center) matrix)
    x (EL:V- x center) y (EL:V- y center) sx (EL:Norm x) sy (EL:Norm y))
  ;; Similarity only: nonuniform scale/shear uses the existing sampled fallback.
