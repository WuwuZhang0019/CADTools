(defun EL:PowerDialog (result cfg library / dialog status row id)
  (setq *EL:PowerResult* result *EL:CircuitIndex* 0 *EL:PowerEdits* nil *EL:PowerIndex* 0
        *EL:SaveLibrary* nil *EL:LibraryEdits* nil
        *EL:PowerCfg* cfg *EL:PowerLibrary* library dialog (load_dialog (strcat *EL:Root* "ui/power.dcl")) *EL:DialogID* dialog)
  (if (> dialog 0)
    (progn
      (setq status 2)
      (while (= status 2)
        (if (new_dialog "el_power" dialog)
          (progn
            (start_list "category") (foreach row '("请选择类别" "应急照明灯（默认5W）" "疏散标志（默认1W）" "安全出口（默认1W）" "其他（手填）") (add_list row)) (end_list)
            (EL:PowerUIRefresh)
            (EL:MonitorActionTile "rows" "(EL:PowerHighlight (atoi $value))")
            (EL:MonitorActionTile "circuit_rows" "(EL:PowerCircuitSelect $value)")
            (EL:MonitorActionTile "category" "(EL:PowerUICategory $value)")
            (EL:MonitorActionTile "save_row" "(if (EL:PowerUISave) (EL:PowerUIRefresh))")
            (EL:MonitorActionTile "locate" "(done_dialog 2)")
            (EL:MonitorActionTile "accept" "(setq *EL:SaveLibrary* (equal (get_tile \"save_library\") \"1\")) (done_dialog 1)")
            (EL:MonitorActionTile "cancel" "(done_dialog 0)")
            (setq status (start_dialog))
            (if (= status 2)
              (progn
                (EL:PowerHighlight *EL:PowerIndex*)
                (getstring "\n按 Enter 返回功率表: ") (EL:ClearPickHighlights))))
          (setq status 0)))
      (unload_dialog dialog) (setq *EL:DialogID* nil)
      (if (= status 1)
        (progn (setq *EL:LibraryEdits* *EL:PowerEdits*)
          (EL:Put 'powers (EL:MergePowers (EL:Get 'powers cfg) *EL:PowerEdits*) cfg))))
    (princ "\n无法打开 DCL 功率表。")))
