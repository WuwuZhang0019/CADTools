              " / 当前 " (vl-prin1-to-string (EL:Get 'role row)) " / 身份 " (EL:Hash (EL:Signature (EL:Get 'identity row)))))) (end_list)
            (start_list "role_choice") (foreach row '("待核对" "设备" "配电箱" "跨层引线" "忽略") (add_list row)) (end_list)
