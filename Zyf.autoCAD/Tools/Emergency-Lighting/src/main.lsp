(defun EL:UnknownRows (snapshot cfg / rows block wire row)
  (foreach block (EL:Get 'blocks snapshot)
    (if (and (not (equal (EL:Get 'id block) *EL:ReviewPanel*))
          (or *EL:ReviewAllRoles* (member (EL:Get 'role block) '(unknown ambiguous)))
          (vl-some '(lambda (w) (EL:PathBlockHit w block cfg)) (EL:Get 'wires snapshot)))
      (progn
        (setq row (EL:By 'identity (EL:Get 'identity block) rows))
        (if row (setq rows (subst (EL:Put 'ids (cons (EL:Get 'id block) (EL:Get 'ids row)) row) row rows))
          (setq rows (cons (list (cons 'identity (EL:Get 'identity block)) (cons 'role (EL:Get 'role block)) (cons 'name (EL:Get 'name block))
            (cons 'ids (list (EL:Get 'id block)))) rows))))))
  (reverse rows))
