        *EL:PowerCfg* nil *EL:PowerLibrary* nil *EL:PowerResult* nil *EL:CircuitIndex* nil))
(defun EL:PowerUIRefresh (/ view circuit row record label)
  (setq *EL:PowerResult* (EL:BoxStatistics *EL:PowerResult* *EL:PowerCfg* *EL:PowerLibrary* *EL:PowerEdits*)
        view *EL:PowerResult*)
  (if (> *EL:CircuitIndex* 0)
    (setq view (EL:Put 'circuits (list (nth (1- *EL:CircuitIndex*) (EL:Get 'circuits view))) view)))
  (setq *EL:PowerRows* (EL:PowerTableRows view) *EL:PowerIndex* 0)
  (start_list "circuit_rows")
  (add_list (strcat "全部回路 / 完整回路合计 " (itoa (EL:Get 'box-watts *EL:PowerResult*)) "W / "
    (if (EL:Get 'complete *EL:PowerResult*) "识别完整" "整箱未完成")))
  (foreach circuit (EL:Get 'circuits *EL:PowerResult*)
    (add_list (strcat (EL:Get 'id circuit) " / 出口 " (vl-prin1-to-string (EL:Get 'point (EL:Get 'seed circuit)))
      " / 设备 " (itoa (length (EL:Get 'devices circuit))) " / " (itoa (EL:Get 'watts circuit)) "W / "
      (if (EL:Get 'complete circuit) "完整" "未完成或冲突")
      (if (EL:Get 'over-limit circuit) " / 超过172W" "")
      (if (EL:Get 'power-values-complete circuit) "" " / 功率缺项"))))
  (end_list) (set_tile "circuit_rows" (itoa *EL:CircuitIndex*))
  (start_list "rows")
  (foreach row *EL:PowerRows*
    (setq record (EL:ResolvePower (EL:Get 'identity row) *EL:PowerEdits* (EL:Get 'powers *EL:PowerCfg*) *EL:PowerLibrary*))
    (add_list (strcat (EL:Get 'name row) " / 身份 " (EL:Hash (EL:Signature (EL:Get 'identity row)))
      " / 数量 " (itoa (EL:Get 'count row)) " / " (vl-prin1-to-string (EL:Get 'circuits row))
      " / " (if (EL:PowerValid record)
        (strcat (itoa (EL:Get 'watts record)) "W / 小计 " (rtos (* 1.0 (EL:Get 'count row) (EL:Get 'watts record)) 2 0) "W") "功率待填"))))
  (end_list) (set_tile "rows" "0")
  (if *EL:PowerRows* (EL:PowerUISelect 0)))
