    (new_dialog name dialog)))
;; Date: 2026-10-16. Keep all recognized circuits and explain the fixed eight-row limit.
(defun EL:PanelCircuitLimitText (result / count)
  (setq count (length (EL:Get 'circuits result)))
  (if (> count 8)
    (strcat "已识别 " (itoa count) " 条实际回路；当前系统图最多容纳 8 条。"
      "\n面板仅显示前 8 条，全部回路数据已保留，不会截断。"
      "\n请拆分配电箱或重新选择回路后再生成。")))
(defun EL:PanelGenerateBody (/ limit)
  (EL:LogEvent "PANEL_ACTION" 'generate)
  (if (setq limit (EL:PanelCircuitLimitText *EL:PanelDraft*))
    (EL:PanelError limit)
    (if (EL:DLPanelSubmissionReady)
      (cond
        ((not (EL:Get 'circuits *EL:PanelDraft*)) (EL:PanelError "请至少保留一条实际出线。"))
        ((not (EL:CircuitNumbersReady *EL:PanelDraft*))
          (EL:PanelError (EL:NumberProblemText *EL:PanelDraft*)))
        ((not (EL:Get 'can-generate *EL:PanelDraft*)) (EL:PanelGenerationBlocked *EL:PanelDraft*))
        ((not (EL:SelectionsReady *EL:PanelDraft* *EL:PanelCapacity*))
          (EL:PanelError "请先选择箱体容量。"))
        (*EL:PanelTemplateReady* (setq *EL:PanelAction* 'generate) (EL:PanelClose 2))
        (T (setq *EL:PanelAction* 'generate) (EL:PanelClose 4)))
      (alert (if *EL:DLError*
        (strcat *EL:DLError* "\n请在设备库中检查并恢复；当前面板输入保留，恢复后可再次生成。")
        "设备库默认值已刷新，请核对当前功率和地面属性后再次生成。")))))
(defun EL:PanelGenerate (/ outcome)
  ;; Date: 2026-10-10. Keep callback failures visible while preserving the draft.
  ;; Date: 2026-10-16. Report excess circuits before editor validation can hide the limit.
  (if (or (EL:PanelCircuitLimitText *EL:PanelDraft*) (EL:PanelLibraryFlush))
    (setq outcome (vl-catch-all-apply 'EL:PanelGenerateBody nil)))
  (if (vl-catch-all-error-p outcome)
    (progn
      (setq *EL:PanelAction* nil)
      (EL:LogEvent "PANEL_GENERATE_ERROR" (vl-catch-all-error-message outcome))
      (EL:PanelText "p_error" (strcat "生成未开始：" (vl-catch-all-error-message outcome)))
      (alert (strcat "生成未开始：" (vl-catch-all-error-message outcome) "\n当前设置已保留，请查看诊断日志。")))))
(defun EL:PanelFill (/ cs i c key ids circuit total)
  (setq cs (EL:Get 'circuits *EL:PanelDraft*) i 0)
  (repeat 8
    (setq c (nth i cs) key (itoa i))
    (set_tile (strcat "p_row" key)
      ;; Date: 2026-10-10. Display output numbering and watts only.
      (if c (strcat (EL:CircuitNumberText c (1+ i))
        (if (and (assoc 'number-status c) (not (equal (EL:Get 'number-status c) 'ready))) " [待核对]" "")
        " | " (itoa (EL:Get 'watts c)) "W")
        (if (< i (EL:FixedOutputCount (length cs)))
          (strcat "预留" (itoa (1+ (- i (length cs))))) "")))
    (setq i (1+ i)))
  (foreach circuit cs (setq ids (append ids (EL:Get 'devices circuit))))
  ;; Date: 2026-10-16. Show deduplicated power below the rows; keep counts in the command line.
  (setq total (EL:PanelKnownTotal))
  (set_tile "p_power_total" total)
  (princ (strcat "\n已识别设备 " (itoa (length (EL:Unique ids)))
    " 个；待核对设备 " (itoa (length (EL:Get 'library-pending *EL:PanelDraft*))) " 种。"))
  (EL:PanelText "p_error" (cond
    ((not (EL:CircuitNumbersReady *EL:PanelDraft*)) (EL:NumberProblemText *EL:PanelDraft*))
    ((EL:Get 'load-error (EL:Get 'device-library *EL:PanelDraft*)) "设备库无法读取，请修复库文件后重新统计；本图和库原文件保留。")
    ((EL:Get 'library-pending *EL:PanelDraft*) (strcat "尚有 " (itoa (length (EL:Get 'library-pending *EL:PanelDraft*)))
      (if *EL:PanelLibraryExpanded* " 种设备待核对；请在右侧设备库补齐资料。"
        " 种设备待核对；请展开设备库补齐资料。")))
    ((not ids) "未识别到连接设备，请检查导线连接或设备图块。")
    ((and (not (assoc 'block-ground *EL:PanelDraft*)) (vl-some '(lambda (c) (EL:Get 'is-ground c)) cs))
      "沿用旧回路地面设置；修改图块地面勾选后按图块统一重算。")
    (T "")))
  (princ (strcat "\n" total "；实际回路 " (itoa (length cs)) "；输出 " (itoa (EL:FixedOutputCount (length cs)))
    "；已完整核对回路 " (itoa (EL:Get 'box-watts *EL:PanelDraft*)) " W"))
  (set_tile "p_capacity" (cond ((equal *EL:PanelCapacity* 'cap600) "p_600")
    ((equal *EL:PanelCapacity* 'cap1000) "p_1000") (T "p_300")))
  (princ (strcat "\n" (if *EL:PanelTemplateReady* "模板已验证，生成时自动切换状态。"
    "模板未设置或已变化：点击生成时设置；不影响当前统计。")))
  (setq i 0)
  (foreach c cs
    (if (> (strlen (EL:CircuitNumberText c (1+ i))) 24)
      (princ (strcat "\n回路完整编号：" (EL:CircuitNumberText c (1+ i)))))
    (setq i (1+ i))))
(defun EL:PanelKnownTotal (/ ids circuit rows row total missing kinds overflow watts)
  (foreach circuit (EL:Get 'circuits *EL:PanelDraft*)
    (setq ids (append ids (EL:Get 'devices circuit))))
  (setq ids (EL:Unique ids) total 0 missing 0 kinds 0)
  (setq rows (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids))
    (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))) *EL:PanelPowers*))
  (foreach row rows
    (setq watts (EL:Get 'watts row))
    (if (numberp watts)
      (if (> watts (/ (- 2147483647 total) (EL:Get 'count row))) (setq overflow T)
        (setq total (+ total (* watts (EL:Get 'count row)))))
      (setq missing (+ missing (EL:Get 'count row)) kinds (1+ kinds))))
  (strcat (if (and (= missing 0) (EL:Get 'complete *EL:PanelDraft*)) "总功率：" "已知总功率：")
    (if overflow "超出整数范围" (strcat (itoa total) " W"))
    (if (> missing 0) (strcat "；尚有 " (itoa kinds) " 种 / " (itoa missing) " 个设备未填功率") "")
    (if (EL:Get 'complete *EL:PanelDraft*) "" "；连接仍待核对")))
(defun EL:PanelCapacity (value)
  (setq *EL:PanelCapacity* (cond ((equal value "p_600") 'cap600) ((equal value "p_1000") 'cap1000) (T 'cap300))
    *EL:PanelDraft* (EL:Put 'capacity-source 'manual *EL:PanelDraft*))
  (EL:PanelFill))
(defun EL:PanelAccept ()
  (EL:LogEvent "PANEL_ACTION" 'save)
  (if (and (EL:PanelLibraryFlush) (EL:DLPanelSaveReady))
    (if (EL:Get 'circuits *EL:PanelDraft*) (progn (setq *EL:PanelAction* 'save) (EL:PanelClose 1))
      (EL:PanelError "请至少保留一条实际出线。"))))
;; Date: 2026-10-16. Leave power uncounted until picking, without capacity helper rows.
(defun EL:PanelHomeFill (/ i key)
  (set_tile "p_number" "配电箱编号：请先拾取配电箱")
  (setq i 0)
  (repeat 8 (set_tile (strcat "p_row" (itoa i)) "") (setq i (1+ i)))
  (set_tile "p_power_total" "总功率：未统计")
  (EL:PanelText "p_error" "")
  (set_tile "p_capacity" "p_300")
  (foreach key '("p_trunk" "p_capacity" "f_preview" "p_generate") (mode_tile key 1)))
(defun EL:PanelLibraryReconcile (/ snapshot resolved)
  (setq snapshot (EL:Get 'snapshot *EL:DLUIState*))
  (if snapshot
    (progn
      (if (and *EL:DLSessionSnapshot*
          (equal (EL:Get 'root *EL:DLSessionSnapshot*) (EL:Get 'root snapshot))
          (equal (EL:Get 'raw *EL:DLSessionSnapshot*) (EL:Get 'raw snapshot))
          (equal (EL:Get 'catalog *EL:DLSessionSnapshot*) (EL:Get 'catalog snapshot)))
        (setq resolved nil)
        (setq resolved T))
      (setq *EL:PanelLibrarySnapshot* snapshot *EL:DLSessionSnapshot* snapshot)
      (if (and resolved *EL:PanelDraft*)
        (progn
          (setq resolved (EL:DLPrepare *EL:PanelDraft* *EL:PanelPowers* snapshot nil)
            *EL:PanelDraft* (EL:Get 'result resolved) *EL:PanelPowers* (EL:Get 'powers resolved)
            *EL:PanelDraft* (EL:PanelCompute *EL:PanelDraft* *EL:PanelPowers* *EL:PanelConfig*))
          T)))))
(defun EL:PanelLibraryStatus (deleted)
  (EL:DLUISafe (if deleted 'EL:DLUIPanelDelete 'EL:DLUIPanelRestore))
  (if (EL:PanelLibraryReconcile) (EL:PanelFill)))
(defun EL:DLUIPanelDelete () (EL:DLUIChangeStatus T))
(defun EL:DLUIPanelRestore () (EL:DLUIChangeStatus nil))
(defun EL:PanelLibraryExternal (status / entry result checkpoint path)
  (cond
    ((= status 15) (EL:DLLibraryTransferUI nil))
    ((= status 14)
      (setq *EL:DLUIDirectories* (EL:Put (EL:Get 'root (EL:Get 'snapshot *EL:DLUIState*))
        *EL:DLUIState* *EL:DLUIDirectories*))
      (setq path (getfiled "选择设备库的 catalog.eld" (strcat (EL:DLRoot) "catalog.eld") "eld" 0))
      (if path (EL:DLUISwitchRoot path)))
    ((= status 16) (EL:DLLibraryTransferUI T))
    ((= status 13)
      (setq checkpoint *EL:PerfPending* result (vl-catch-all-apply 'EL:DLPickDevices nil))
      (if (vl-catch-all-error-p result) (EL:PerfUnwind checkpoint))
      (if (and (not (vl-catch-all-error-p result)) result)
        (progn
          (setq *EL:DLUIPickQueue* result *EL:DLUIPickSaved* 0
            *EL:DLUIPickReused* 0 *EL:DLUIPickFailed* 0)
          (if (equal (EL:DLUIPickNext) 'suspended) (setq status 12)))
        (setq *EL:DLUINotice* "本次未拾取设备；现有资料和输入保留。"))))
  (if (= status 12) 12 (progn (EL:PanelLibraryReconcile) 3)))
;; Date: 2026-10-15. Open the bundled drawing without changing the current DWG.
(defun EL:PanelOpenBlockLibrary (/ path folder present outcome)
  (setq path (EL:SystemBlockLibraryPath))
  (if (and path (setq folder (vl-filename-directory path)) (vl-file-directory-p folder))
    (progn
      (setq present (findfile path)
        outcome (vl-catch-all-apply 'startapp
          (list "explorer.exe" (strcat (if present "/select,\"" "\"")
            (vl-string-translate "/" "\\" (if present path folder)) "\""))))
      (cond
        ((or (not outcome) (vl-catch-all-error-p outcome))
          "无法打开图块文件夹，请手动查看 templates/系统图块库.dwg。")
        (present "已打开系统图块库所在文件夹。")
        (T "已打开图块文件夹；尚缺系统图块库.dwg。")))
    "图块文件夹不存在，请重新解压完整交付包。"))
;; Date: 2026-10-16. Open only this export's successful result, keeping failure details intact.
(defun EL:PanelDiagnosticExportOpen (/ notice path opened)
  (setq *EL:DiagnosticExportPath* nil *EL:DiagnosticExportMessage* nil
    *EL:DiagnosticError* nil *EL:DiagnosticExportSucceeded* nil)
  (setq notice (EL:PanelDiagnosticExport) path *EL:DiagnosticExportPath*)
  (princ (strcat "\n" notice))
  (if path (princ (strcat "\n诊断资料路径：" path)))
  (if (and path *EL:DiagnosticExportSucceeded*)
    (progn
      (setq opened (EL:DiagnosticOpenFolder path))
      (princ (strcat "\n" opened))
      (if (not (equal opened "已打开诊断文件所在位置。"))
        (alert (strcat notice "\n" opened "\n诊断资料路径：" path))))
    (alert notice)))
(defun EL:PanelDialog (result cfg powers capacity / dialog status captured limit-notice limit-shown
    *EL:PanelAction* *EL:PanelDraft* *EL:PanelPowers* *EL:PanelCapacity* *EL:PanelConfig*
    *EL:PanelTemplateReady* *EL:PanelLibrarySnapshot* *EL:PanelDialogPosition* *EL:PanelPreviewPalette*
    home)
  (setq home (not result)
    *EL:PanelDraft* (if result (EL:PanelCompute (EL:SelectFixedExits result nil) powers cfg))
    *EL:PanelPowers* powers *EL:PanelCapacity* (EL:CapacityDefault capacity)
    *EL:PanelPreviewPalette* (EL:PreviewPalette *EL:PanelDraft*)
    *EL:PanelConfig* cfg
    *EL:PanelTemplateReady* (if result (EL:TemplateReady (EL:Get 'template cfg) cfg))
    *EL:PanelLibrarySnapshot* (cond (home (EL:DLSnapshot))
      (*EL:DLSessionSnapshot*) (T (EL:DLSnapshot)))
    dialog (load_dialog (strcat *EL:Root* "ui/power.dcl")) *EL:DialogID* dialog status 3)
  (setq *EL:DLUIHost* 'panel)
  (if (and result (not (EL:Get 'capacity-source *EL:PanelDraft*)))
    (setq *EL:PanelDraft* (EL:Put 'capacity-source 'default *EL:PanelDraft*)))
  (if (and result (assoc 'block-ground *EL:PanelDraft*)) (EL:PanelBlockGroundApply))
  (while (and (> dialog 0) (= status 3))
    (if (EL:PanelNewDialog dialog)
      (progn
        (if home (EL:PanelHomeFill)
          (progn
            (EL:LogCall "PANEL_FILL" (list (cons 'panel (EL:Get 'panel result))
              (cons 'circuits (length (EL:Get 'circuits *EL:PanelDraft*)))) 'EL:PanelFill nil)
            (set_tile "p_number" (strcat "配电箱编号：" (EL:PanelNumber *EL:PanelDraft*)))))
        (EL:TrunkButtonDraw)
        (EL:StepLabelsDraw)
        (EL:PanelCircuitColorsDraw *EL:PanelPreviewPalette*)
        (set_tile "p_library_toggle" (if *EL:PanelLibraryExpanded* "收起设备库 <<" "展开设备库 >>"))
        (if *EL:PanelLibraryExpanded* (EL:DLUIPanelBegin *EL:PanelLibrarySnapshot*))
        (EL:MonitorActionTile "p_pick" "(EL:PanelLeave 9)")
        (EL:MonitorActionTile "p_trunk" "(EL:PanelLeave 10)")
        (EL:MonitorActionTile "f_preview" "(EL:PanelLeave 5)")
        (EL:MonitorActionTile "p_library_toggle" "(EL:PanelLibraryToggle)")
        (EL:MonitorActionTile "p_capacity" "(EL:PanelCapacity $value)")
        (EL:MonitorActionTile "p_generate" "(EL:PanelGenerate)")
        (EL:MonitorActionTile "p_diagnostic" "(EL:PanelLeave 17)")
        (if *EL:PanelLibraryExpanded*
          (EL:MonitorActionTile "p_block_library_open" "(EL:PanelLeave 19)"))
        (EL:MonitorActionTile "cancel" "(EL:PanelExit)")
        (if (and (not limit-shown) (setq limit-notice (EL:PanelCircuitLimitText *EL:PanelDraft*)))
          (progn
            (setq limit-shown T)
            (EL:LogEvent "PANEL_CIRCUIT_LIMIT" (list (cons 'actual (length (EL:Get 'circuits *EL:PanelDraft*))) '(maximum . 8)))
            (EL:PanelError limit-notice)))
        (setq *EL:PanelAction* nil status (EL:PerfInput 'start_dialog nil))
        (EL:LogEvent "PANEL_DIALOG_RETURN" (list (cons 'status status) (cons 'action *EL:PanelAction*)))
        (if (= status 21) (setq status 3))
        (if (= status 4)
          (progn
            (princ "\n正在检查系统图块；缺少定义时从随包图块库自动导入。")
            (setq captured (vl-catch-all-apply 'EL:CaptureFixedTemplate (list *EL:PanelConfig*)))
            (EL:ClearPickHighlights)
            (if (and (not (vl-catch-all-error-p captured)) captured)
              (setq *EL:PanelConfig* (EL:Put 'template captured *EL:PanelConfig*)
                *EL:PanelTemplateReady* T status 2)
              (progn (princ "\n模板设置未完成，返回统计面板；当前功率和选择已保留。")
                (setq status 3)))))
        (if (= status 5)
          (progn (EL:AllCircuitColorPreview *EL:PanelDraft*) (setq status 3)))
        (if (= status 17)
          (progn (EL:PanelDiagnosticExportOpen) (setq status 3)))
        (if (= status 19)
          (setq *EL:DLUINotice* (EL:PanelOpenBlockLibrary) status 3))
        (if (= status 20)
          (setq *EL:DLUINotice* (EL:DLOpenCatalog) status 3))
        (if (member status '(13 14 15 16))
          (setq status (EL:PanelLibraryExternal status))))
      (setq status 0)))
  (if (> dialog 0) (unload_dialog dialog))
  (setq *EL:DialogID* nil)
  (cond
    ((= status 12)
      (list (cons 'library-suspended (list (cons 'result *EL:PanelDraft*)
        (cons 'powers *EL:PanelPowers*) (cons 'config *EL:PanelConfig*)
        (cons 'capacity *EL:PanelCapacity*) (cons 'home home)))))
    ((member status '(9 10))
      (if (not home)
        (progn
          (EL:RememberStartPanel (EL:Get 'panel *EL:PanelDraft*) (EL:PanelNumber *EL:PanelDraft*))
          (setq *EL:StartPickResume* (list (cons 'result *EL:PanelDraft*)
            (cons 'powers *EL:PanelPowers*) (cons 'config *EL:PanelConfig*)
            (cons 'capacity *EL:PanelCapacity*)))))
      (list (cons 'pick-panel (if (= status 10) 'trunk T))))
    ((member status '(1 2))
      (list (cons 'result *EL:PanelDraft*) (cons 'powers *EL:PanelPowers*)
        (cons 'config *EL:PanelConfig*) (cons 'capacity *EL:PanelCapacity*)
        (cons 'generate (or (equal *EL:PanelAction* 'generate) (= status 2)))))))

