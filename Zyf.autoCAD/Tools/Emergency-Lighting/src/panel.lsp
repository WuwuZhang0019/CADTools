;; Date: 2026-10-16. Compact panel feedback; print overflow without splitting GB2312 pairs.
(defun EL:PanelText (key value / lines line units char cost index limit legacy step width)
  (setq width (if (member key '("dl_asset" "dl_status")) 34 44))
  (setq line "" units 0 index 1 limit (cond ((equal key "p_total") 4) ((equal key "dl_status") 3) (T 2)))
  (setq legacy (= (strlen "中") 2))
  (while (<= index (strlen value))
    (setq char (substr value index 1) cost (if (> (ascii char) 127) 2 1))
    (setq step (if (and legacy (= cost 2)) 2 1)
      char (substr value index step))
    (if (> (+ units cost) width)
      (setq lines (append lines (list line)) line "" units 0))
    (setq line (strcat line char) units (+ units cost) index (+ index step)))
  (setq lines (append lines (list line)) index 0)
  ;; Date: 2026-10-16. The footer is removed; keep details in the command line.
  (if (equal key "p_error")
    (if (/= value "") (princ (strcat "\n" value)))
    (progn
      (repeat limit
        (set_tile (if (= index 0) key (strcat key (itoa index))) (cond ((nth index lines)) (T "")))
        (setq index (1+ index)))
      (if (> (length lines) limit) (princ (strcat "\n" value))))))
;; Date: 2026-10-16. Action failures stay visible without a persistent footer.
(defun EL:PanelError (message)
  (EL:PanelText "p_error" message)
  (alert message))
(defun EL:ThumbRestore (/ item checked pending)
  (foreach item *EL:ThumbHidden*
    ;; Date: 2026-10-12. A rejected hide on a locked layer needs no write to restore.
    (if (not (equal (vl-catch-all-apply 'vla-get-Visible (list (car item))) (cadr item)))
      (progn
        (setq checked (vl-catch-all-apply 'vla-put-Visible (list (car item) (cadr item))))
        (if (or (vl-catch-all-error-p checked)
                (not (equal (vl-catch-all-apply 'vla-get-Visible (list (car item))) (cadr item))))
          (setq pending (cons item pending))))))
  (setq *EL:ThumbHidden* pending)
  (not pending))
(defun c:ELTHUMBRESET ()
  (princ (if (EL:ThumbRestore) "\n图例预览可见性已恢复。" "\n仍有对象未恢复，请检查锁层后重试。"))
  (vl-catch-all-apply 'vla-Regen (list (vla-get-ActiveDocument (vlax-get-acad-object)) 1)) (princ))
(defun EL:ThumbCleanup (/ path job)
  (EL:ThumbRestore)
  (foreach path *EL:ThumbSlides* (vl-catch-all-apply 'vl-file-delete (list path)))
  (foreach job *EL:ThumbJobs* (EL:DLCaptureCleanup job))
  (setq *EL:ThumbSlides* nil *EL:ThumbCache* nil *EL:ThumbSources* nil *EL:ThumbJobs* nil *EL:ThumbPending* nil))
(defun EL:ThumbDraw (key geometry / w h screen scale sw sh checked shown)
  (setq w (dimx_tile key) h (dimy_tile key))
  (start_image key) (fill_image 0 0 w h -15)
  (if (and geometry (findfile (car geometry)) (setq screen (cadr geometry))
      (numberp (car screen)) (> (car screen) 0) (numberp (cadr screen)) (> (cadr screen) 0))
    (progn
      (fill_image 0 0 w h -2)
      (setq scale (min (/ (float w) (car screen)) (/ (float h) (cadr screen)))
        sw (max 1 (fix (* scale (car screen)))) sh (max 1 (fix (* scale (cadr screen)))))
      (setq checked (vl-catch-all-apply 'slide_image
        (list (fix (/ (- w sw) 2)) (fix (/ (- h sh) 2)) sw sh (car geometry)))
        shown (and (not (vl-catch-all-error-p checked)) checked))
      (if (not shown) (progn (fill_image 0 0 w h -15)
        (EL:LogEvent "DEVICE_LEGEND_DRAW_FAILED" (list (cons 'tile key) (cons 'path (car geometry))
          (cons 'message (if (vl-catch-all-error-p checked) (vl-catch-all-error-message checked) "slide_image returned nil"))))))))
  (end_image) shown)
(defun EL:FixedSourceSignature (snapshot)
  (list 'EL_FIXED_SOURCE_V1 (EL:StableSnapshot snapshot)))
(defun EL:CircuitSnapshot (snapshot panel / blocks b)
  (foreach b (EL:Get 'blocks snapshot)
    (setq blocks (cons (EL:Put 'identity (EL:FixedBlockIdentity (EL:Get 'name b))
      (EL:Put 'role (EL:FixedBlockRole b panel nil) b)) blocks)))
  (EL:Put 'signature (EL:LogCall "SNAPSHOT_SIGNATURE" nil 'EL:FixedSourceSignature (list snapshot)) (EL:Put 'blocks (reverse blocks) snapshot)))
(defun EL:SplitNetwork (network cfg / snapshot panel edges seeds wire block i circuits result circuit
    *EL:DeviceContactCache* *EL:DeviceTemplateCache* *EL:DeviceTemplateEnabled*)
  ;; Date: 2026-10-15. Reuse definitions only for this call's identical
  ;; network, DWG owner and epoch. Keep original instance/pose creation order
  ;; and arithmetic; standalone splits still start with fresh caches.
  (if (and *EL:RecognitionPass* *EL:RecognitionContacts*
      (eq network (car *EL:RecognitionContacts*))
      (equal (namedobjdict) (cadr *EL:RecognitionContacts*))
      (equal *EL:FreshEpoch* (caddr *EL:RecognitionContacts*)))
    (setq *EL:DeviceTemplateCache* (nth 3 *EL:RecognitionContacts*)))
  (setq snapshot (EL:CircuitSnapshot (EL:Get 'snapshot network) (EL:Get 'panel network))
        panel (EL:Get 'panel network) block (EL:By 'id panel (EL:Get 'blocks snapshot)) i 0)
  (foreach wire (vl-sort (EL:Get 'wires snapshot) '(lambda (a b) (< (EL:Get 'id a) (EL:Get 'id b))))
    (if (cond ((EL:Get 'circuit-starts snapshot) (EL:By 'wire (EL:Get 'id wire) (EL:Get 'circuit-starts snapshot)))
        ((EL:Get 'trunk-segments snapshot) (member (EL:Get 'id wire) (EL:Get 'trunk-roots snapshot)))
        (T (EL:PathBlockHit wire block cfg)))
      (progn (setq i (1+ i))
        (setq seeds (cons (list (cons 'id (strcat "R" (itoa i))) (cons 'wire (EL:Get 'id wire))
          (cons 'key (list (EL:Get 'id wire) 'outlet))) seeds)))))
  (setq edges (vl-remove-if '(lambda (e) (member panel e)) (EL:Get 'edges network)))
  (setq *EL:DeviceTemplateEnabled* T)
  (foreach wire (reverse seeds)
    (setq circuit (EL:PerfCall "CIRCUIT_TRACE" 'EL:TraceCircuit
      (list wire snapshot edges (EL:Get 'gap-issues network))))
    (setq circuit (EL:Put 'number-scope (EL:PerfCall "CIRCUIT_NUMBER_SCOPE" 'EL:ExitNumberScope
      (list wire network cfg)) circuit) circuits (cons circuit circuits)))
  (foreach wire (reverse circuits)
    (EL:LogEvent "CIRCUIT_TRACE_RESULT" (list (cons 'id (EL:Get 'id wire))
      (cons 'wires (EL:Get 'wires wire)) (cons 'devices (EL:Get 'devices wire))
      (cons 'complete (EL:Get 'complete wire)) (cons 'issues (EL:Get 'issues wire)))))
  (list (cons 'panel panel) (cons 'drawing (EL:Get 'drawing snapshot)) (cons 'snapshot snapshot)
    (cons 'rules (EL:RecognitionRules cfg)) (cons 'circuits (reverse circuits))
    (cons 'complete (and circuits (not (EL:Get 'issues snapshot))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits))) (cons 'engine 'fixed)))
(defun EL:NamePowerRecords (result powers / records b w entry)
  (foreach b (EL:Get 'blocks (EL:Get 'snapshot result))
    (setq w (EL:Get (strcase (EL:Get 'name b)) powers))
    (if (numberp w)
      (setq records (cons (list (cons 'identity (EL:Get 'identity b)) '(category . other)
        (cons 'display (if (and (assoc 'device-library result) (setq entry (EL:Get 'entry (EL:DLReference (EL:Get 'name b) result))))
          (EL:Get 'display entry) (EL:Get 'name b))) (cons 'watts w) '(zero-confirmed . T)) records)))) records)
;; Date: 2026-10-13. Ownership is checked before removing non-load objects.
(defun EL:FixedOwnership (circuits snapshot / out circuit other id block shared issues)
  (foreach circuit circuits
    (setq shared nil issues (vl-remove-if '(lambda (i) (equal (EL:Get 'code i) 'CIRCUIT_OWNERSHIP_CONFLICT)) (EL:Get 'issues circuit)))
    (foreach id (EL:Get 'objects circuit)
      (setq block (EL:By 'id id (EL:Get 'blocks snapshot)))
      (if (or (member id (EL:Get 'wires circuit)) (equal (EL:Get 'role block) 'junction))
        (foreach other circuits
          (if (and (not (equal (EL:Get 'id circuit) (EL:Get 'id other))) (member id (EL:Get 'objects other)))
            (setq shared (cons id shared))))))
    (if shared (setq issues (cons (EL:Issue 'CIRCUIT_OWNERSHIP_CONFLICT (EL:Get 'id circuit) (EL:Unique shared)) issues)))
    (setq out (cons (EL:Put 'complete (not issues) (EL:Put 'issues issues circuit)) out))) (reverse out))
(defun EL:SelectFixedExits (result excluded / circuits keys)
  (setq keys (mapcar '(lambda (c) (EL:Get 'key (EL:Get 'seed c))) (EL:Get 'circuits result))
    circuits (vl-remove-if '(lambda (c) (member (EL:Get 'key (EL:Get 'seed c)) excluded)) (EL:Get 'circuits result))
    circuits (EL:FixedOwnership circuits (EL:Get 'snapshot result)))
  (EL:Put 'candidate-keys keys (EL:Put 'excluded-seeds excluded (EL:Put 'circuits circuits
    (EL:Put 'complete (and circuits (not (EL:Get 'issues (EL:Get 'snapshot result)))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits)) result)))))
;; Date: 2026-10-16. Keep red, green and magenta families out of circuit previews.
(defun EL:CircuitColor (index)
  (nth (fix (rem index 24)) '(4 2 5 30 190 140 40 180 150 160 31 41 51 131 141 151 161 171 181 191 32 42 52 132)))
;; Date: 2026-10-11. Resolve source ByLayer/true colors before choosing preview colors.
(defun EL:ACIColorRGB (index / hue sector fraction high low middle value)
  (cond ((<= index 9) (nth index '((255 255 255) (255 0 0) (255 255 0) (0 255 0)
      (0 255 255) (0 0 255) (255 0 255) (255 255 255) (128 128 128) (192 192 192))))
    ((>= index 250) (setq value (nth (- index 250) '(51 80 105 130 190 255))) (list value value value))
    (T
      (setq hue (fix (/ (- index 10) 10)) sector (fix (/ hue 4)) fraction (/ (rem hue 4) 4.0)
        high (nth (fix (/ (rem (- index 10) 10) 2)) '(255 204 153 127 76))
        low (if (= (rem index 2) 1) (fix (/ high 2.0)) 0)
        middle (fix (+ low (* (- high low) (if (= (rem sector 2) 0) fraction (- 1.0 fraction))))))
      (nth sector (list (list high middle low) (list middle high low) (list low high middle)
        (list low middle high) (list middle low high) (list high low middle))))))
(defun EL:PreviewEntityRGB (id / entity data color rgb)
  (if (and (setq entity (handent id)) (setq data (entget entity)))
    (progn
      (setq color (cond ((cdr (assoc 62 data))) (T 256)))
      (if (and (not (assoc 420 data)) (= color 256))
        (setq data (tblsearch "LAYER" (cdr (assoc 8 data)))))
      (if (setq rgb (cdr (assoc 420 data)))
        (list (logand 255 (fix (/ rgb 65536))) (logand 255 (fix (/ rgb 256))) (logand 255 rgb))
        (EL:ACIColorRGB (abs (cond ((cdr (assoc 62 data))) (T 7))))))))
(defun EL:PreviewPalette (result / ids wire circuit id colors rgb choices palette used candidate index)
  (foreach wire (EL:Get 'wires (EL:Get 'snapshot result))
    (setq ids (cons (cond ((EL:Get 'source-wire wire)) ((EL:Get 'id wire))) ids)))
  (if (not ids)
    (foreach circuit (EL:Get 'circuits result) (setq ids (append ids (EL:Get 'wires circuit)))))
  (foreach id (EL:Unique ids)
    (if (setq rgb (EL:PreviewEntityRGB id)) (setq colors (cons rgb colors))))
  (setq index 0)
  (repeat 24 (setq choices (append choices (list (EL:CircuitColor index))) index (1+ index)))
  ;; Only orange/yellow (30-59) and cyan/blue/violet (130-199), including shades.
  (setq candidate 30)
  (repeat 30 (setq choices (append choices (list candidate)) candidate (1+ candidate)))
  (setq candidate 130)
  (repeat 70 (setq choices (append choices (list candidate)) candidate (1+ candidate)))
  (foreach candidate choices
    (setq rgb (EL:ACIColorRGB candidate))
    (if (and (not (member rgb used))
        (not (vl-some '(lambda (source) (< (EL:Dot (EL:V- rgb source) (EL:V- rgb source)) 10000.0)) colors)))
      (setq palette (append palette (list candidate)) used (cons rgb used))))
  palette)
;; Date: 2026-10-16. The panel and drawing preview consume the same ordered palette.
(defun EL:PanelCircuitColorsDraw (palette / index key color width height)
  (setq index 0)
  (repeat 8
    (setq key (strcat "p_color" (itoa index)) color (nth index palette)
      width (dimx_tile key) height (dimy_tile key))
    (start_image key)
    (fill_image 0 0 width height 8)
    (fill_image 1 1 (max 1 (- width 2)) (max 1 (- height 2)) (if color color -15))
    (end_image)
    (setq index (1+ index))))
(defun EL:ColorPreviewCleanup (/ item checked pending)
  (foreach item *EL:ColorPreviewCopies*
    (setq checked (vl-catch-all-apply 'vla-Delete (list item)))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewCopies* pending pending nil)
  (foreach item *EL:ColorPreviewSources*
    (setq checked (vl-catch-all-apply 'vla-put-Visible (list (car item) (cadr item))))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewSources* pending)
  (redraw)
  (not (or *EL:ColorPreviewCopies* *EL:ColorPreviewSources*)))
(defun EL:ColorPreviewShape (object color depth / children child)
  (EL:Require (< depth 32) "设备嵌套过深，已停止着色预览。")
  (vla-put-Layer object "0")
  (vla-put-Visible object :vlax-true)
  (if (equal (vla-get-ObjectName object) "AcDbBlockReference")
    (progn
      (setq children (vlax-safearray->list (vlax-variant-value (vla-Explode object))))
      ;; Register every child before touching any of them, including on failure.
      (setq *EL:ColorPreviewCopies* (append children *EL:ColorPreviewCopies*))
      (EL:Require children "设备图块无法展开显示，已停止着色预览。")
      (foreach child children (EL:ColorPreviewShape child color (1+ depth)))
      (vla-Delete object)
      (setq *EL:ColorPreviewCopies* (vl-remove object *EL:ColorPreviewCopies*)))
    (vla-put-Color object color)))
(defun EL:ColorPreviewEntity (id color / entity object copy)
  (EL:Require (setq entity (handent id)) "回路对象已删除，请重新统计。")
  (setq object (vlax-ename->vla-object entity) copy (vla-Copy object))
  (setq *EL:ColorPreviewCopies* (cons copy *EL:ColorPreviewCopies*))
  (EL:ColorPreviewShape copy color 0)
  (setq *EL:ColorPreviewSources* (cons (list object (vla-get-Visible object)) *EL:ColorPreviewSources*))
  (vla-put-Visible object :vlax-false))
;; Date: 2026-10-10. Preview only the logical piece of a crossing source wire.
(defun EL:ColorPreviewWire (wire color / object space segment copy)
  (EL:Require (handent (EL:Get 'source-wire wire)) "集中出线源导线已删除，请重新统计。")
  (setq object (vlax-ename->vla-object (handent (EL:Get 'source-wire wire)))
    space (vla-get-ModelSpace (vla-get-ActiveDocument (vlax-get-acad-object))))
  (if (not (assoc object *EL:ColorPreviewSources*))
    (progn
      (setq *EL:ColorPreviewSources* (cons (list object (vla-get-Visible object)) *EL:ColorPreviewSources*))
      (vla-put-Visible object :vlax-false)))
  (foreach segment (EL:Get 'segments wire)
    (setq copy (vla-AddLine space (vlax-3d-point (car segment)) (vlax-3d-point (cadr segment)))
      *EL:ColorPreviewCopies* (cons copy *EL:ColorPreviewCopies*))
    (EL:ColorPreviewShape copy color 0)))
(defun EL:AllCircuitColorWait (result / circuit index ids id seen snapshot wire block bounds lo hi palette color)
  (EL:Require (EL:ColorPreviewCleanup) "上次预览尚未清理完成，请运行 ELCOLORRESET。")
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  ;; Shared objects have no unambiguous circuit color: reject before any writes.
  (EL:Require (<= (length (EL:Get 'circuits result)) 24) "当前分色支持最多 24 条回路。")
  (setq palette (cond (*EL:PanelPreviewPalette*) (T (EL:PreviewPalette result))))
  (EL:Require (>= (length palette) (length (EL:Get 'circuits result)))
    "原导线颜色过多，无法分配清晰的回路预览颜色。")
  (foreach circuit (EL:Get 'circuits result)
    (setq ids (EL:Unique (append (EL:Get 'wires circuit) (EL:Get 'devices circuit))))
    (foreach id ids
      (EL:Require (not (member id seen)) "发现多回路共用对象，请先核对连接。")
      (setq seen (cons id seen))))
  (setq snapshot (EL:Get 'snapshot result))
  (foreach id seen
    (setq wire (EL:By 'id id (EL:Get 'wires snapshot)) block (EL:By 'id id (EL:Get 'blocks snapshot))
      bounds (if wire (EL:SegmentBounds (EL:Get 'segments wire)) (EL:Get 'bounds block)))
    (if bounds (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
      hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))))
  (if lo (EL:SimpleZoom lo hi))
  (setq index 0)
  (foreach circuit (EL:Get 'circuits result)
    (setq color (nth index palette))
    (foreach id (EL:Unique (append (EL:Get 'wires circuit) (EL:Get 'devices circuit)))
      (setq wire (EL:By 'id id (EL:Get 'wires snapshot)))
      (if (EL:Get 'source-wire wire) (EL:ColorPreviewWire wire color)
        (EL:ColorPreviewEntity id color)))
    (princ (strcat "\nZE" (itoa (1+ index)) "：预览颜色 " (itoa color)))
    (setq index (1+ index)))
  (redraw)
  (EL:PerfInput 'getstring (list "\n已识别路径已改为区别于原导线的颜色；保留原色的部分未纳入回路。按 Enter 或 Esc 返回：")))
(defun EL:AllCircuitColorPreview (result / checked document clean ended checkpoint)
  ;; One undo group prevents stepping through a half-restored preview.
  (setq document (vla-get-ActiveDocument (vlax-get-acad-object)))
  (vla-StartUndoMark document)
  (setq checkpoint *EL:PerfPending* checked (vl-catch-all-apply 'EL:AllCircuitColorWait (list result)))
  (EL:PerfUnwind checkpoint)
  (setq clean (EL:ColorPreviewCleanup)
    ended (vl-catch-all-apply 'vla-EndUndoMark (list document)))
  (if (not clean)
    (EL:Require nil "预览清理未完成，请运行 ELCOLORRESET 重试，清理前不要保存图纸。"))
  (if (vl-catch-all-error-p ended) (EL:Require nil "预览撤销组未能结束，请检查 CAD 命令状态。"))
  (if (vl-catch-all-error-p checked)
    (princ (strcat "\n已结束回路分色预览：" (vl-catch-all-error-message checked)))))
(defun c:ELCOLORRESET ()
  (princ (if (EL:ColorPreviewCleanup) "\n回路分色预览已清理。" "\n仍有对象未能恢复，请检查图层锁定状态后重试。")) (princ))
(defun EL:PanelCompute (result powers cfg / prepared *EL:StatisticsScopeEnabled*)
  (setq *EL:StatisticsScopeEnabled* T)
  (if (assoc 'device-library result)
    (progn
      (if (not (EL:DLRefsCover result))
        (progn (if (not *EL:DLSessionSnapshot*) (setq *EL:DLSessionSnapshot* (EL:DLSnapshot)))
          (setq prepared (EL:DLPrepare result powers *EL:DLSessionSnapshot* nil) result (EL:Get 'result prepared) powers (EL:Get 'powers prepared))))
      (setq powers (EL:DLEffectivePowers result powers) result (EL:Put 'effective-powers powers result))))
  (setq result (EL:BoxStatistics result (EL:Put 'powers (EL:NamePowerRecords result powers) cfg) nil nil))
  (if (assoc 'device-library result) (setq result (EL:DLEvaluate result powers)))
  (EL:Put 'can-generate (and (EL:Get 'can-generate result) (EL:CircuitNumbersReady result)) result))
(defun EL:MatchCircuits (circuits saved prefix / out old c key seen next removed added)
  (setq next 1)
  (foreach old saved (if (numberp (EL:Get 'output-order old)) (setq next (max next (1+ (EL:Get 'output-order old))))))
  (foreach c circuits
    (setq key (EL:Get 'key (EL:Get 'seed c)) old (EL:By 'seed-key key saved))
    (if (or (not key) (member key seen)) (setq key nil))
    (if key
      (progn
        (setq seen (cons key seen))
        (if (not old)
          (progn
            (while (EL:By 'circuit-uid (strcat prefix "/" (EL:Signature key) "/" (itoa next)) saved) (setq next (1+ next)))
            (setq old (list (cons 'circuit-uid (strcat prefix "/" (EL:Signature key) "/" (itoa next)))
              (cons 'output-order next) '(is-ground) '(ground-source . default))
              next (1+ next) added T)))
        (foreach key '(circuit-uid output-order is-ground ground-source ground-rule ground-evidence)
          (setq c (EL:Put key (EL:Get key old) c)))
        (setq c (EL:Put 'seed-key (EL:Get 'key (EL:Get 'seed c)) c) out (cons c out)))
      (setq out (cons (EL:Put 'identity-error T c) out))))
  (setq removed (vl-remove-if '(lambda (r) (member (EL:Get 'seed-key r) seen)) saved))
  (list (cons 'circuits (vl-sort out '(lambda (a b) (< (cond ((EL:Get 'output-order a)) (T 0))
    (cond ((EL:Get 'output-order b)) (T 0)))))) (cons 'removed removed) (cons 'added added)
    (cons 'ambiguous (or removed (vl-some '(lambda (c) (EL:Get 'identity-error c)) out)))))
(defun EL:GroundSuggestion (circuit names version blocks / hits id b)
  ;; No configured names => no inference. Explicit manual yes AND no win.
  (if (equal (EL:Get 'ground-source circuit) 'manual) circuit
    (progn
      (if (and names (EL:Get 'complete circuit))
        (foreach id (EL:Get 'devices circuit)
          (setq b (EL:By 'id id blocks))
          (if (member (EL:Get 'name b) names) (setq hits (cons id hits)))))
      (EL:Put 'is-ground (if hits T nil) (EL:Put 'ground-source (if names 'auto-rule 'default)
        (EL:Put 'ground-rule version (EL:Put 'ground-evidence hits circuit)))))))
;; Date: 2026-10-14. Restore old per-block ground choices without rescanning.
(defun EL:PanelBlockGroundApply (/ cs c id block hits settings)
  (if (not (assoc 'device-library *EL:PanelDraft*))
    (progn
      (setq settings (EL:Get 'block-ground *EL:PanelDraft*))
      (foreach c (EL:Get 'circuits *EL:PanelDraft*)
        (setq hits nil)
        (foreach id (EL:Get 'devices c)
          (setq block (EL:By 'id id (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))))
          (if (EL:Get (strcase (EL:Get 'name block)) settings) (setq hits (cons id hits))))
        (setq cs (cons (EL:Put 'ground-evidence hits (EL:Put 'ground-rule 'block-table
          (EL:Put 'ground-source 'manual (EL:Put 'is-ground (if hits T nil) c)))) cs)))
      (setq *EL:PanelDraft* (EL:Put 'circuits (reverse cs) *EL:PanelDraft*)))))
(defun EL:CapacityDefault (capacity)
  ;; Date: 2026-10-09. Use 0.3kW immediately; retain a valid saved choice.
  (if (member capacity '(cap300 cap600 cap1000)) capacity 'cap300))
(defun EL:SelectionsReady (result capacity)
  ;; Date: 2026-10-11. Ground values need no separate confirmation state.
  (if (member capacity '(cap300 cap600 cap1000)) T nil))
;; Date: 2026-10-16. Reopen two shared layouts without reading hidden editor tiles.
(defun EL:PanelClose (status)
  (setq *EL:PanelDialogPosition* (done_dialog status)))
(defun EL:PanelLibraryFlush ()
  (or (not *EL:PanelLibraryExpanded*) (not *EL:PanelLibrarySnapshot*) (EL:DLUIFlush)))
(defun EL:PanelLeave (status)
  (if (EL:PanelLibraryFlush) (EL:PanelClose status)))
;; Date: 2026-10-16. Always close on Esc/X; keep even invalid editor input in session drafts.
(defun EL:PanelExit ()
  (if (and *EL:PanelLibraryExpanded* *EL:PanelLibrarySnapshot*)
    (progn
      (setq *EL:DLUIState* (EL:Put 'query (get_tile "dl_query")
        (EL:Put 'deleted (equal (get_tile "dl_deleted") "1") *EL:DLUIState*)))
      (EL:DLUISafe 'EL:DLUIStore)
      ;; Keep the saved snapshot current without recomputing a panel that is closing.
      (setq *EL:DLSessionSnapshot* (EL:Get 'snapshot *EL:DLUIState*))))
  (EL:PanelClose 0))
(defun EL:PanelLibraryToggle ()
  (if (EL:PanelLibraryFlush)
    (progn
      (if (and *EL:PanelLibraryExpanded* *EL:PanelLibrarySnapshot*)
        (progn
          (setq *EL:DLUIState* (EL:Put 'query (get_tile "dl_query")
            (EL:Put 'deleted (equal (get_tile "dl_deleted") "1") *EL:DLUIState*)))
          (EL:PanelLibraryReconcile)))
      (setq *EL:PanelLibraryExpanded* (not *EL:PanelLibraryExpanded*))
      (EL:PanelClose 21))))
